      "end": 135.96,
      "text": "Я отдам свой"
    },
    {
      "time": 135.96,
      "end": 136.82,
      "text": "свой к народу,"
    },
    {
      "time": 137.26,
      "end": 138.04,
      "text": "весь горю мне,"
    },
    {
      "time": 138.16,
      "end": 138.9,
      "text": "дайте воду"
    },
    {
      "time": 138.9,
      "end": 140.56,
      "text": "Мастодонт своей породы,"
    },
    {
      "time": 140.66,
      "end": 141.42,
      "text": "за мной едут"
    },
    {
