      "end": 105.01,
      "text": "скажешь, что атеист"
    },
    {
      "time": 105.01,
      "end": 105.97,
      "text": "Я хочу тебя"
    },
    {
      "time": 105.97,
      "end": 106.95,
      "text": "спасти, но я"
    },
    {
      "time": 106.95,
      "end": 108.23,
      "text": "не вижу света"
    },
    {
      "time": 108.23,
      "end": 109.23,
      "text": "Я хочу понять,"
    },
    {
      "time": 109.41,
      "end": 110.87,
      "text": "куда летят эти"
    },
    {
      "time": 110.87,
      "end": 111.43,
      "text": "кометы"
    },
    {
      "time": 111.43,
      "end": 112.55,
      "text": "Я сказал, слишком"
    },
    {
      "time": 112.55,
      "end": 114.35,
      "text": "много уже нету"
    },
    {
      "time": 114.35,
      "end": 114.63,
      "text": "ленты"
    },
    {
      "time": 114.63,
      "end": 115.43,
      "text": "Да, я знаю,"
    },
    {
      "time": 115.49,
      "end": 116.33,
      "text": "ты так любишь,"
    },
    {
      "time": 116.39,
      "end": 117.97,
      "text": "а, мои комплименты"
    },
    {
      "time": 117.97,
      "end": 119.09,
      "text": "Возьму тебя за"
    },
    {
      "time": 119.09,
      "end": 120.65,
      "text": "руку, теплеет мое"
    },
    {
      "time": 120.65,
      "end": 121.17,
      "text": "сердце"
    },
    {
      "time": 121.17,
      "end": 123.13,
      "text": "Синоптики, скажите, куда"
    },
    {
      "time": 123.13,
      "end": 124.35,
      "text": "подует ветер"
    },
    {
      "time": 124.35,
      "end": 125.47,
      "text": "Лишь бы этот"
    },
    {
      "time": 125.47,
      "end": 126.19,
      "text": "день был с"
    },
    {
      "time": 126.19,
      "end": 127.51,
      "text": "тобою бесконечным"
    },
    {
      "time": 127.51,
      "end": 128.59,
      "text": "Точно знаю, будут"
    },
    {
      "time": 128.59,
      "end": 130.77,
      "text": "времена Авроры Крейсер"
    },
    {
      "time": 130.77,
      "end": 132.35,
      "text": "Иногда мне кажется,"
    },
    {
      "time": 132.37,
      "end": 133.43,
      "text": "один на белом"
    },
    {
      "time": 133.43,
      "end": 133.87,
      "text": "свете"
    },
    {
      "time": 133.87,
      "end": 135.01,
      "text": "Забыл, что значит"
    },
    {
      "time": 135.01,
      "end": 137.17,
      "text": "социум, остался незамечен"
    },
    {
      "time": 137.17,
      "end": 138.09,
      "text": "одиночеством"
    },
    {
      "time": 138.09,
      "end": 138.89,
      "text": "И друг, я"
    },
    {
      "time": 138.89,
      "end": 139.81,
      "text": "так рад нашей"
    },
    {
      "time": 139.81,
      "end": 140.37,
      "text": "встрече"
    },
    {
      "time": 140.37,
      "end": 141.75,
      "text": "Все проходят через"
    },
    {
      "time": 141.75,
      "end": 143.49,
      "text": "это, ноги калечат"
    },
    {
      "time": 143.49,
      "end": 145.33,
      "text": "Забирайся выше, ты"
    },
    {
      "time": 145.33,
      "end": 146.71,
      "text": "увидишь дальше больше"
    },
    {
      "time": 146.71,
      "end": 148.51,
      "text": "Посмотри назад, да,"
    },
    {
      "time": 148.61,
      "end": 149.07,
      "text": "ты был в"
    },
    {
      "time": 149.07,
      "end": 149.93,
      "text": "этом болоте"
    },
    {
      "time": 149.93,
      "end": 151.33,
      "text": "Но одна нога"
    },
    {
      "time": 151.33,
      "end": 152.25,
      "text": "уже на суше,"
    },
    {
      "time": 152.39,
      "end": 153.05,
      "text": "ты на взлете"
    },
    {
      "time": 153.05,
      "end": 154.67,
      "text": "Опасно так снаружи,"
    },
    {
      "time": 154.71,
      "end": 156.33,
      "text": "двигай на автопилоте"
    },
    {
      "time": 156.33,
      "end": 157.73,
      "text": "Я не замечал"
    },
    {
      "time": 157.73,
      "end": 158.85,
      "text": "тебя раньше в"
    },
    {
      "time": 158.85,
      "end": 159.53,
      "text": "этом клубе"
    },
    {
      "time": 159.53,
      "end": 161.19,
      "text": "Ты такая пиздатая,"
    },
    {
      "time": 161.43,
      "end": 162.31,
      "text": "моя губа не"
    },
    {
      "time": 162.31,
      "end": 162.71,
      "text": "дура"
    },
    {
      "time": 162.71,
      "end": 163.91,
      "text": "Все люди на"
    },
    {
      "time": 163.91,
      "end": 165.93,
      "text": "фоне тебя, карикатура"
    },
    {
      "time": 165.93,
      "end": 167.53,
      "text": "Ты подходишь ближе,"
    },
    {
      "time": 167.65,
      "end": 169.15,
      "text": "у меня температура"
    },
    {
      "time": 169.15,
      "end": 170.69,
      "text": "Таешь на губах,"
    },
    {
      "time": 170.81,
      "end": 172.29,
      "text": "будто сахарная вата"
    },
    {
      "time": 172.29,
      "end": 173.83,
      "text": "Вижу по глазам,"
    },
    {
      "time": 173.87,
      "end": 175.51,
      "text": "хочешь быстрого развата"
    },
    {
      "time": 175.51,
      "end": 177.07,
      "text": "После первой ночи"
    },
    {
      "time": 177.07,
      "end": 178.23,
      "text": "будешь очень сильно"
    },
    {
      "time": 178.23,
      "end": 178.75,
      "text": "плакать"
    },
    {
      "time": 178.75,
      "end": 180.47,
      "text": "Малить небеса, дабы"
    },
    {
      "time": 180.47,
      "end": 181.91,
      "text": "вернуть время обратно"
    },
    {
      "time": 181.91,
      "end": 183.37,
      "text": "Я запутался в"
    },
    {
      "time": 183.37,
      "end": 184.69,
      "text": "сетях твоих волшебных"
    },
    {
      "time": 184.69,
      "end": 184.99,
      "text": "знаю"
    },
    {
      "time": 184.99,
      "end": 186.61,
      "text": "Почему не вылезаю,"
    },
    {
      "time": 186.77,
      "end": 186.93,
      "text": "бля"
    },
    {
      "time": 186.93,
      "end": 188.33,
      "text": "Там ловлю кайф,"
    },
    {
      "time": 188.43,
      "end": 189.49,
      "text": "будто иностранец"
    },
    {
      "time": 189.49,
      "end": 190.43,
      "text": "По Москве большой"
    },
    {
      "time": 190.43,
      "end": 191.11,
      "text": "гуляю"
    },
    {
      "time": 191.11,
      "end": 192.27,
      "text": "Это моя жизнь"
    },
    {
      "time": 192.27,
      "end": 193.29,
      "text": "трачет на тебя"
    },
    {
      "time": 194.79,
      "end": 196.27,
      "text": "Было бы больно,"
    },
    {
      "time": 196.31,
      "end": 196.77,
      "text": "акула"
    },
    {
      "time": 196.77,
      "end": 198.75,
      "text": "Будет довольна, хуесосы"
    },
    {
      "time": 198.75,
      "end": 199.43,
      "text": "стали в ряд"
    },
    {
      "time": 199.43,
      "end": 200.77,
      "text": "Я даю команду"
    },
    {
      "time": 200.77,
      "end": 202.49,
      "text": "больно, рассчитайтесь, пидоры"
    },
    {
      "time": 202.49,
      "end": 204.03,
      "text": "Все мы подневольные"
    },
    {
      "time": 204.03,
      "end": 205.93,
      "text": "меня заставили читать"
    },
    {
      "time": 205.93,
      "end": 207.33,
      "text": "Я, что Марченко"
    },
    {
      "time": 207.33,
      "end": 208.97,
      "text": "пеедрила под пивом"
    },
    {
      "time": 208.97,
      "end": 210.05,
      "text": "Глушим сативу с"
    },
    {
      "time": 210.05,
      "end": 211.03,
      "text": "конин и сани"
    },
    {
      "time": 211.03,
      "end": 212.73,
      "text": "но недовольным в"
    },
    {
      "time": 212.73,
      "end": 213.95,
      "text": "рот уколы в"
    },
    {
      "time": 213.95,
      "end": 215.91,
      "text": "админке если заебало"
    },
    {
      "time": 215.91,
      "end": 217.83,
      "text": "просто наберу маринки"
    },
    {
      "time": 217.83,
      "end": 220.09,
      "text": "я просто наберу"
    },
    {
      "time": 220.09,
      "end": 221.13,
      "text": "маринке я"
    },
    {
      "time": 221.13,
      "end": 221.83,
      "text": "беру любой текст"
    },
    {
      "time": 221.83,
      "end": 222.57,
      "text": "с полки кладу"
    },
    {
      "time": 222.57,
      "end": 223.31,
      "text": "на любой минус"
    },
    {
      "time": 223.31,
      "end": 224.03,
      "text": "и готовы ничего"
    },
    {
      "time": 224.03,
      "end": 225.07,
      "text": "сложного это всего"
    },
    {
      "time": 225.07,
      "end": 225.63,
      "text": "лишь рэп"
    },
    {
      "time": 225.63,
      "end": 226.59,
      "text": "ехал на самокате"
    },
    {
      "time": 226.59,
      "end": 227.99,
      "text": "раздавал ништяки бомжам"
    },
    {
      "time": 227.99,
      "end": 229.11,
      "text": "неплохой месяц был"
    },
    {
      "time": 229.11,
      "end": 230.11,
      "text": "моя надеюсь апрель"
    },
    {
      "time": 230.11,
      "end": 230.57,
      "text": "не хуже"
    },
    {
      "time": 230.57,
      "end": 231.69,
      "text": "а хули халвинг"
    },
    {
      "time": 231.69,
      "end": 232.79,
      "text": "такая лайф не"
    },
    {
      "time": 232.79,
      "end": 234.15,
      "text": "чавкая лучше похлюпать"
    },
    {
      "time": 234.15,
      "end": 235.19,
      "text": "пизду и надея"
    },
    {
      "time": 235.19,
      "end": 236.23,
      "text": "очки когда она"
    },
    {
      "time": 236.23,
      "end": 236.71,
      "text": "смотрела"
    },
    {
      "time": 236.71,
      "end": 237.67,
      "text": "на мою котлету"
    },
    {
      "time": 237.67,
      "end": 239.51,
      "text": "расширялись зрачки пацаны"
    },
    {
      "time": 239.51,
      "end": 240.79,
      "text": "пелесок деды выпил"
    },
    {
      "time": 240.79,
      "end": 242.25,
      "text": "мочи говорит разъёб"
    },
    {
      "time": 242.25,
      "end": 243.11,
      "text": "по привычке все"
    },
    {
      "time": 243.11,
      "end": 244.83,
      "text": "поддержали особенно максим"
    },
    {
      "time": 244.83,
      "end": 246.01,
      "text": "самый тихий парень"
    },
    {
      "time": 246.01,
      "end": 247.09,
      "text": "никогда не моротил"
    },
    {
      "time": 247.09,
      "end": 248.31,
      "text": "но оказался крысы"
    },
    {
      "time": 248.31,
      "end": 248.89,
      "text": "он был"
    },
    {
      "time": 248.89,
      "end": 250.35,
      "text": "пассив сверху крысиный"
    },
    {
      "time": 250.35,
      "end": 252.19,
      "text": "король составлял основной"
    },
    {
      "time": 252.19,
      "end": 253.55,
      "text": "массив такое бывает"
    },
    {
      "time": 253.55,
      "end": 254.73,
      "text": "такая лазь это"
    },
    {
      "time": 254.73,
      "end": 255.71,
      "text": "было его стиль"
    },
    {
      "time": 255.71,
      "end": 256.87,
      "text": "он сосёт назло"
    },
    {
      "time": 256.87,
      "end": 257.83,
      "text": "мне через силы"
    },
    {
      "time": 257.83,
      "end": 258.71,
      "text": "его тошнут но"
    },
    {
      "time": 258.71,
      "end": 259.69,
      "text": "тот дело принципа"
    },
    {
      "time": 259.69,
      "end": 261.03,
      "text": "зима захалила максима"
    },
    {
      "time": 261.03,
      "end": 261.65,
      "text": "Ведь этот суровый"
    },
    {
      "time": 261.65,
      "end": 262.63,
      "text": "парень из Новосиба"
    },
    {
      "time": 262.63,
      "end": 263.45,
      "text": "может сыграть на"
    },
    {
      "time": 263.45,
      "end": 263.95,
      "text": "морозе."
    },
    {
      "time": 264.03,
      "end": 265.21,
      "text": "Вот это красиво."
    },
    {
      "time": 265.41,
      "end": 266.33,
      "text": "Пацаны все на"
    },
    {
      "time": 266.33,
