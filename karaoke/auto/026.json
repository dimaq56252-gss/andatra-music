      "text": "-я -я -я"
    },
    {
      "time": 12.97,
      "end": 17.77,
      "text": "-я, Мексика, эй!"
    },
    {
      "time": 20.75,
      "end": 22.23,
      "text": "Серенда, Фернда, Руссия,"
    },
    {
      "time": 22.35,
      "end": 22.93,
      "text": "мы поем по"
    },
    {
      "time": 22.93,
      "end": 24.25,
      "text": "-мексиканские мотивы,"
    },
    {
      "time": 24.33,
      "end": 25.47,
      "text": "Загадку не разгадает"
    },
    {
      "time": 25.47,
      "end": 26.69,
      "text": "даже частный детектив,"
    },
    {
      "time": 26.83,
      "end": 27.87,
      "text": "не забуду никогда"
    },
    {
      "time": 27.87,
      "end": 28.49,
      "text": "фавелы."
    },
    {
      "time": 28.59,
      "end": 29.53,
      "text": "Массивый рэпчик в"
    },
    {
      "time": 29.53,
      "end": 30.25,
      "text": "душу от души,"
    },
    {
      "time": 30.41,
      "end": 31.29,
      "text": "это наша пассивка,"
    },
    {
      "time": 31.33,
      "end": 32.33,
      "text": "слушай наши треки,"
    },
    {
      "time": 32.47,
      "end": 33.45,
      "text": "получишь ачивку."
    },
    {
      "time": 33.45,
      "end": 34.91,
      "text": "Я поднимаю эту"
    },
    {
      "time": 34.91,
      "end": 35.69,
      "text": "выпивку за всю"
    },
    {
      "time": 35.69,
      "end": 36.21,
      "text": "братву"
    },
    {
      "time": 36.21,
      "end": 37.87,
      "text": "Майпадцы в адеквате,"
    },
    {
      "time": 38.11,
      "end": 38.67,
      "text": "твои ку -ку"
    },
    {
      "time": 38.67,
      "end": 39.61,
      "text": "Я на чеку,"
    },
    {
      "time": 39.67,
      "end": 40.43,
      "text": "мне рябчик не"
    },
    {
      "time": 40.43,
      "end": 41.27,
      "text": "бьет по кошельку"
    },
    {
      "time": 41.27,
      "end": 42.71,
      "text": "Ебал твою кошелку,"
    },
    {
      "time": 42.95,
      "end": 44.09,
      "text": "небритая мошонка"
    },
    {
      "time": 44.09,
      "end": 45.77,
      "text": "Подъехала машинка, МС"
    },
    {
      "time": 45.77,
      "end": 46.61,
      "text": "-такси -оцинка"
    },
    {
      "time": 46.61,
      "end": 48.21,
      "text": "Тюряжечку -посылку на"
    },
    {
      "time": 48.21,
      "end": 49.23,
      "text": "голову -косынку"
    },
    {
      "time": 49.23,
      "end": 49.99,
      "text": "Го со мной,"
    },
    {
      "time": 50.17,
      "end": 51.45,
      "text": "сынка, мы почитаем"
    },
    {
      "time": 51.45,
      "end": 51.87,
      "text": "рябчик"
    },
    {
      "time": 51.87,
      "end": 53.35,
      "text": "На холодку запечен"
    },
    {
      "time": 53.35,
      "end": 54.25,
      "text": "перчиком с битом"
    },
    {
      "time": 54.25,
      "end": 55.63,
      "text": "Какая гена, соблюдая"
    },
    {
      "time": 55.63,
      "end": 56.57,
      "text": "мертву, наблюдай"
    },
    {
      "time": 56.57,
      "end": 57.57,
      "text": "За клютой, все"
    },
    {
      "time": 57.57,
      "end": 58.33,
      "text": "не бессмертны"
    },
    {
      "time": 58.33,
      "end": 59.65,
      "text": "Все реандатры купляют"
    },
    {
      "time": 59.65,
      "end": 60.43,
      "text": "и хуярят, будто"
    },
    {
      "time": 60.43,
      "end": 60.93,
      "text": "пистолет"
    },
    {
      "time": 60.93,
      "end": 62.41,
      "text": "Макаров, модных репионов"
    },
    {
      "time": 62.41,
      "end": 63.19,
      "text": "поставим раком"
    },
    {
      "time": 63.19,
      "end": 64.83,
      "text": "Моя забота, экология,"
    },
    {
      "time": 64.99,
      "end": 65.93,
      "text": "твоя работа, быть"
    },
    {
      "time": 65.93,
      "end": 66.99,
      "text": "уродом, это, сука,"
    },
    {
      "time": 67.05,
      "end": 67.55,
      "text": "щаблона"
    },
    {
      "time": 67.55,
      "end": 68.55,
      "text": "Рошу паны, как"
    },
    {
      "time": 68.55,
      "end": 69.23,
      "text": "угодно вам"
    },
    {
      "time": 69.23,
      "end": 71.33,
      "text": "Все пидоры ебаные,"
    },
    {
      "time": 71.49,
      "end": 72.19,
      "text": "кроме нас и"
    },
    {
      "time": 72.19,
      "end": 72.57,
      "text": "гнойного"
    },
    {
      "time": 72.57,
      "end": 73.43,
      "text": "Так, так, так,"
    },
    {
      "time": 73.57,
      "end": 75.01,
      "text": "вот, аккуратность такта"
    },
    {
      "time": 75.01,
      "end": 76.19,
      "text": "Я касаюсь этого"
    },
    {
      "time": 76.19,
      "end": 77.05,
      "text": "бита, как будто"
    },
    {
      "time": 77.05,
      "end": 77.51,
      "text": "вата"
    },
    {
      "time": 77.51,
      "end": 79.19,
      "text": "База, маза, ты"
    },
    {
      "time": 79.19,
      "end": 80.15,
      "text": "все алмазы"
    },
    {
      "time": 80.15,
      "end": 80.95,
      "text": "Мой братан до"
    },
    {
      "time": 80.95,
      "end": 81.75,
      "text": "гоба, за него"
    },
    {
      "time": 81.75,
      "end": 82.79,
      "text": "я разным глазом"
    },
    {
      "time": 82.79,
      "end": 84.07,
      "text": "Что ты, браза,"
    },
    {
      "time": 84.15,
      "end": 84.89,
      "text": "убитый, но не"
    },
    {
      "time": 84.89,
      "end": 85.37,
      "text": "мясо"
    },
    {
      "time": 85.37,
      "end": 86.45,
      "text": "Жаль все сессоны,"
    },
    {
      "time": 86.59,
      "end": 87.13,
      "text": "я кручу и"
    },
    {
      "time": 87.13,
      "end": 87.97,
      "text": "без табаска"
    },
    {
      "time": 87.97,
      "end": 88.83,
      "text": "Жестко и без"
    },
    {
      "time": 88.83,
      "end": 90.07,
      "text": "маски, хочется без"
    },
    {
      "time": 90.07,
      "end": 90.55,
      "text": "ласки"
    },
    {
      "time": 90.55,
      "end": 91.77,
      "text": "Проходите, топите, пока"
    },
    {
      "time": 91.77,
      "end": 92.73,
      "text": "меня не прижмут"
    },
    {
      "time": 92.73,
      "end": 93.03,
      "text": "в вас"
    },
    {
      "time": 93.03,
      "end": 94.45,
      "text": "Ты что, ганста?"
    },
    {
      "time": 94.57,
      "end": 95.75,
      "text": "Вижу, ты опасный"
    },
    {
      "time": 95.75,
      "end": 96.85,
      "text": "Парни с калошами"
    },
    {
      "time": 96.85,
      "end": 98.33,
      "text": "вас попросят извиняться"
    },
    {
      "time": 98.33,
