    {
      "time": 1.2,
      "end": 2.38,
      "text": "Я -я -я,"
    },
    {
      "time": 2.58,
      "end": 5.14,
      "text": "Андатра, Алмазик здесь,"
    },
    {
      "time": 6.68,
      "end": 10.2,
      "text": "Андрюх Виллис, я"
    },
    {
      "time": 10.2,
