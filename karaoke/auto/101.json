      "text": "этот четкий бит"
    },
    {
      "time": 46.94,
      "end": 48.08,
      "text": "Мы живем во"
    },
    {
      "time": 48.08,
      "end": 49.54,
      "text": "фристайле, погода нам"
    },
    {
      "time": 49.54,
      "end": 50.12,
      "text": "говорит"
    },
    {
      "time": 50.12,
      "end": 51.84,
      "text": "Сделай круче, бро,"
    },
    {
      "time": 52.04,
      "end": 53.44,
      "text": "просто качни толпу"
    },
    {
      "time": 53.44,
      "end": 54.62,
      "text": "С нас ответка"
