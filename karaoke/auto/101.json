      "end": 25.44,
      "text": "пока я на"
    },
    {
      "time": 25.44,
      "end": 25.66,
      "text": "воле."
    },
    {
      "time": 25.74,
      "end": 26.48,
      "text": "Качу на приоре,"
    },
    {
      "time": 26.56,
      "end": 27.34,
