    {
      "time": 1.9,
      "end": 5.14,
      "text": "Нет, нет."
    },
    {
      "time": 34.78,
      "end": 35.98,
      "text": "Я взял тебя"
    },
    {
      "time": 35.98,
      "end": 37.26,
      "text": "за волосы, ты"
    },
    {
      "time": 37.26,
      "end": 38.62,
      "text": "как шалава пон"
    },
    {
      "time": 38.62,
      "end": 41.16,
      "text": "Андатра разъебет, мыцель"
    },
    {
      "time": 41.16,
      "end": 42.24,
      "text": "как шапито"
    },
    {
      "time": 42.24,
      "end": 44.16,
      "text": "Тебя ебал шматков,"
    },
    {
      "time": 44.42,
      "end": 46.1,
      "text": "я замутил шматок"
    },
    {
      "time": 46.1,
      "end": 47.86,
      "text": "Иди сюда, браток,"
    },
    {
      "time": 48.16,
      "end": 48.64,
      "text": "я блять в"
    },
    {
      "time": 48.64,
      "end": 49.72,
      "text": "такое говно"
    },
    {
      "time": 49.72,
      "end": 51.78,
      "text": "Давайте не попадаться"
    },
    {
      "time": 51.78,
      "end": 52.38,
      "text": "больше"
    },
    {
      "time": 52.38,
      "end": 53.76,
      "text": "Забрал легко с"
    },
    {
      "time": 53.76,
      "end": 54.72,
      "text": "руки, как Гитлер"
    },
    {
      "time": 54.72,
      "end": 55.34,
      "text": "в Польшу"
    },
    {
      "time": 55.34,
      "end": 57.14,
      "text": "Я хочу угорать,"
    },
    {
      "time": 57.7,
      "end": 58.5,
      "text": "а ты хочешь"
    },
    {
      "time": 58.5,
      "end": 59.08,
      "text": "Порше"
    },
    {
      "time": 59.08,
      "end": 60.58,
      "text": "Я Билли Миллиган,"
    },
    {
      "time": 60.72,
      "end": 62.1,
      "text": "а ты Билли"
    },
    {
      "time": 62.1,
      "end": 62.82,
      "text": "Терша"
    },
    {
      "time": 62.82,
      "end": 64.04,
      "text": "Я по накурке"
    },
    {
      "time": 64.04,
      "end": 65.38,
      "text": "играю с гранатой,"
    },
    {
      "time": 65.5,
      "end": 66.38,
      "text": "как Пригожин"
    },
    {
      "time": 66.38,
      "end": 68.24,
      "text": "Ты курица ебаная,"
    },
    {
      "time": 68.42,
      "end": 70.2,
      "text": "люблю куриную кожу"
    },
    {
      "time": 70.2,
      "end": 71.94,
      "text": "Браточек написал вид,"
    },
    {
      "time": 72.42,
      "end": 73.76,
      "text": "воровать не гоже"
    },
    {
      "time": 73.76,
      "end": 75.62,
      "text": "Тебя ебали лёжа"
    },
    {
      "time": 75.62,
      "end": 77.2,
      "text": "за пару грошей"
    },
    {
      "time": 77.2,
      "end": 79.42,
      "text": "Если маленький хуй"
    },
    {
      "time": 79.42,
      "end": 81.22,
      "text": "отсосёт Ерушин"
    },
    {
      "time": 81.22,
      "end": 82.5,
      "text": "По цепи, как"
    },
    {
      "time": 82.5,
      "end": 84.34,
      "text": "мусора, по району"
    },
    {
      "time": 84.34,
      "end": 84.88,
      "text": "кружат"
    },
    {
      "time": 84.88,
      "end": 86.66,
      "text": "Я люблю Россию,"
    },
    {
      "time": 87.1,
      "end": 88.64,
      "text": "как Дмитрий Дюжев"
    },
    {
      "time": 88.64,
      "end": 90.24,
      "text": "Алло, сука, сейчас"
    },
    {
      "time": 90.24,
      "end": 90.8,
      "text": "занят"
    },
    {
      "time": 90.8,
      "end": 92.58,
      "text": "Давай потом побазаем"
    },
    {
      "time": 92.58,
      "end": 93.98,
      "text": "Делаю в карманы"
    },
    {
      "time": 93.98,
      "end": 94.52,
      "text": "налик"
    },
    {
      "time": 94.52,
      "end": 95.46,
      "text": "Я кручусь, как"
    },
    {
      "time": 95.46,
      "end": 96.36,
      "text": "будто валик"
    },
    {
      "time": 96.36,
      "end": 96.94,
      "text": "Мне с тобой"
    },
    {
      "time": 96.94,
      "end": 97.94,
      "text": "так холодно"
    },
    {
      "time": 97.94,
      "end": 98.98,
      "text": "Айс на шее"
    },
    {
      "time": 98.98,
      "end": 100.0,
      "text": "замерзает"
    },
    {
      "time": 100.0,
      "end": 100.64,
      "text": "Я в дерьме"
    },
    {
      "time": 100.64,
      "end": 101.82,
      "text": "сейчас утопаю"
    },
    {
      "time": 101.82,
      "end": 103.68,
      "text": "Беру новый, поджигаю"
    },
    {
      "time": 103.68,
      "end": 104.6,
      "text": "Выбо мне не"
    },
    {
      "time": 104.6,
      "end": 105.38,
      "text": "гасим"
    },
    {
      "time": 105.38,
      "end": 106.68,
      "text": "Я машинно брил"
    },
    {
      "time": 106.68,
      "end": 107.28,
      "text": "бензин"
    },
    {
      "time": 107.28,
      "end": 109.08,
      "text": "Трэп -министр Аладдин"
    },
    {
      "time": 109.08,
      "end": 110.38,
      "text": "Я лечу средь"
    },
    {
      "time": 110.38,
      "end": 111.44,
      "text": "этих псин"
    },
    {
      "time": 111.44,
      "end": 113.34,
      "text": "Мне не нужно"
    },
    {
      "time": 113.34,
      "end": 114.6,
      "text": "доставать ксиву"
    },
    {
      "time": 114.6,
      "end": 116.46,
      "text": "Чтобы показалось"
    },
    {
      "time": 116.46,
      "end": 118.2,
      "text": "Жизнь покрасивей"
    },
    {
      "time": 118.2,
      "end": 120.0,
      "text": "Ты ебаный пидор,"
    },
    {
      "time": 120.12,
      "end": 121.76,
      "text": "тут анда трарили"
    },
    {
      "time": 121.76,
      "end": 123.42,
      "text": "Никого нам сделал"
    },
    {
      "time": 123.42,
      "end": 125.12,
      "text": "бит, М4, лес"
    },
    {
      "time": 125.12,
      "end": 125.62,
      "text": "4"
    },
    {
      "time": 125.62,
      "end": 127.16,
      "text": "А, я крот,"
    },
    {
      "time": 127.28,
      "end": 128.6,
      "text": "везде ход, опять"
    },
    {
      "time": 128.6,
      "end": 129.4,
      "text": "не на ход"
    },
    {
      "time": 129.4,
      "end": 130.9,
      "text": "Ёбаный, блять, дот,"
    },
    {
      "time": 131.02,
      "end": 131.84,
      "text": "что же делать?"
    },
    {
      "time": 132.06,
      "end": 133.24,
      "text": "Мфу, как компот,"
    },
    {
      "time": 133.46,
      "end": 134.28,
      "text": "блинкий мёд"
    },
    {
      "time": 134.28,
      "end": 135.44,
      "text": "Я как будто"
    },
    {
      "time": 135.44,
      "end": 136.82,
      "text": "пулемёт, а в"
    },
    {
      "time": 136.82,
