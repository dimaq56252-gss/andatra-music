    },
    {
      "time": 331.6,
      "end": 332.84,
      "text": "не успеваю"
    },
    {
      "time": 332.84,
      "end": 334.9,
      "text": "Просто себя закаляю"
    },
    {
      "time": 334.9,
      "end": 337.02,
      "text": "Чуток себя разгоняю"
    },
    {
      "time": 337.02,
      "end": 338.4,
      "text": "Совсем не бледно"
    },
    {
      "time": 338.4,
      "end": 339.08,
      "text": "читаю"
    },
    {
      "time": 339.08,
      "end": 340.02,
      "text": "Но жить так"
    },
    {
      "time": 340.02,
      "end": 341.24,
      "text": "надо, как хочешь"
    },
    {
      "time": 341.24,
      "end": 342.38,
      "text": "Не важно днем"
