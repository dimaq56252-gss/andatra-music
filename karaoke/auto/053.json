  "cues": [
    {
      "time": 6.22,
      "end": 7.44,
      "text": "Мы в депрессиве"
    },
    {
      "time": 7.44,
      "end": 8.62,
      "text": "живем, и мы"
    },
    {
      "time": 8.62,
      "end": 9.24,
      "text": "с этим не"
    },
    {
      "time": 9.24,
      "end": 10.42,
      "text": "сдохнем, пока жив"
    },
    {
      "time": 10.42,
      "end": 11.68,
      "text": "наш район, мы"
    },
    {
      "time": 11.68,
      "end": 12.84,
      "text": "никак не заглохнем,"
    },
    {
      "time": 12.94,
      "end": 14.3,
      "text": "наши таланты просты"
    },
    {
      "time": 14.3,
      "end": 15.4,
      "text": "и наши мысли"
    },
    {
      "time": 15.4,
      "end": 16.86,
      "text": "чисты, и залезть"
    },
    {
      "time": 16.86,
      "end": 17.18,
      "text": "к нам в"
    },
    {
      "time": 17.18,
      "end": 18.26,
      "text": "башку, увы, не"
    },
    {
      "time": 18.26,
      "end": 19.44,
      "text": "сможете вы, но"
    },
    {
      "time": 19.44,
      "end": 20.86,
      "text": "сейчас почти поменялось,"
    },
    {
      "time": 20.98,
      "end": 21.64,
      "text": "мы мыслим чуть"
    },
    {
      "time": 21.64,
      "end": 23.28,
      "text": "анонимно, талантами не"
    },
    {
      "time": 23.28,
      "end": 25.02,
      "text": "обменялись, но погибаем"
    },
    {
      "time": 25.02,
      "end": 26.04,
      "text": "взаимно, ведь мы"
    },
    {
      "time": 26.04,
      "end": 27.14,
      "text": "все рабы лампы,"
    },
    {
      "time": 27.34,
      "end": 28.72,
      "text": "тут окровенный посыл,"
    },
    {
      "time": 28.9,
      "end": 30.48,
      "text": "возможно будете лаять,"
    },
    {
      "time": 30.68,
      "end": 31.56,
      "text": "как на улице"
    },
    {
      "time": 31.56,
      "end": 32.58,
      "text": "ксы, как в"
    },
    {
      "time": 32.58,
      "end": 34.1,
      "text": "дешевом театре, вы"
    },
    {
      "time": 34.1,
      "end": 35.24,
      "text": "плохие актеры,"
    },
    {
      "time": 35.24,
      "end": 36.26,
      "text": "Про вас дешевый"
    },
    {
      "time": 36.26,
      "end": 37.46,
      "text": "видос в ютубе"
    },
    {
      "time": 37.46,
      "end": 38.38,
      "text": "выпустят скоро"
    },
    {
      "time": 38.38,
      "end": 39.28,
      "text": "Но на херню"
    },
    {
      "time": 39.28,
      "end": 40.3,
      "text": "не найдитесь и"
    },
    {
      "time": 40.3,
      "end": 40.84,
      "text": "вы нас не"
    },
    {
      "time": 40.84,
      "end": 41.6,
      "text": "ублажайте"
    },
    {
      "time": 41.6,
      "end": 43.08,
      "text": "Вы ленивые псы,"
    },
    {
      "time": 43.32,
      "end": 44.84,
      "text": "законы не нарушайте"
    },
    {
      "time": 44.84,
      "end": 46.04,
      "text": "Как собаки не"
    },
    {
      "time": 46.04,
      "end": 47.08,
      "text": "лайте, вы на"
    },
    {
      "time": 47.08,
      "end": 48.02,
      "text": "нашу культуру"
    },
    {
      "time": 48.02,
      "end": 48.96,
      "text": "Всегда вы были"
    },
    {
      "time": 48.96,
      "end": 50.04,
      "text": "планктоном, а мы"
    },
    {
      "time": 50.04,
      "end": 51.22,
      "text": "по жизни акулы"
    },
    {
      "time": 56.89,
      "end": 59.11,
      "text": "Давай покажи как"
    },
    {
      "time": 59.11,
      "end": 60.33,
      "text": "надо наваливать"
    },
    {
      "time": 60.33,
      "end": 61.69,
      "text": "Мы просто так"
    },
    {
      "time": 61.69,
      "end": 62.67,
      "text": "несем хуйню в"
    },
    {
      "time": 62.67,
      "end": 63.03,
      "text": "онлайн"
    },
    {
      "time": 63.03,
      "end": 65.17,
      "text": "Иногда попадаем в"
    },
    {
      "time": 65.17,
      "end": 65.49,
      "text": "тебя"
    },
    {
      "time": 65.49,
      "end": 66.89,
      "text": "Включил ландатор, свой"
    },
    {
      "time": 66.89,
      "end": 68.57,
      "text": "рассудок нахуй потерял"
    },
    {
      "time": 68.57,
      "end": 69.85,
      "text": "Мы пишем треки"
    },
    {
      "time": 69.85,
      "end": 71.15,
      "text": "в тайне, секретный"
    },
    {
      "time": 71.15,
      "end": 71.83,
      "text": "материал"
    },
    {
      "time": 71.83,
      "end": 73.29,
      "text": "Этот рингтон зайдет"
    },
    {
      "time": 73.29,
      "end": 74.33,
      "text": "батькам и вашим"
    },
    {
      "time": 74.33,
      "end": 75.01,
      "text": "матерям"
    },
    {
      "time": 75.01,
      "end": 76.77,
      "text": "На твоих поминках"
    },
    {
      "time": 76.77,
      "end": 78.99,
      "text": "была вкусная кутия"
    },
    {
      "time": 78.99,
      "end": 81.05,
      "text": "Очень холодно на"
    },
    {
      "time": 81.05,
      "end": 82.91,
      "text": "студии, Якутия"
    },
    {
      "time": 82.91,
      "end": 84.23,
      "text": "Наши тексты, наши"
    },
    {
      "time": 84.23,
      "end": 85.57,
      "text": "панчи, это орудия"
    },
    {
      "time": 86.09,
      "end": 87.51,
      "text": "Мой близкий инфо"
    },
    {
      "time": 87.51,
      "end": 88.73,
      "text": "-цыган, это орутюнян"
    },
    {
      "time": 89.39,
      "end": 90.27,
      "text": "Мы вас ебнем"
    },
    {
      "time": 90.27,
      "end": 91.51,
      "text": "просто так, без"
    },
    {
      "time": 91.51,
      "end": 92.49,
      "text": "правосудия"
    },
    {
      "time": 92.49,
      "end": 94.07,
      "text": "Паботки весной нужна"
    },
    {
      "time": 94.07,
      "end": 95.69,
      "text": "поглубже, посудина"
    },
    {
      "time": 95.69,
      "end": 97.51,
      "text": "Разгибали рэп Коломня"
    },
    {
      "time": 97.51,
      "end": 98.89,
      "text": "По сути, да,"
    },
    {
      "time": 99.17,
      "end": 100.27,
      "text": "Миша зачитал тут"
    },
    {
      "time": 100.27,
      "end": 100.77,
      "text": "первый"
    },
    {
      "time": 100.77,
      "end": 102.09,
      "text": "Прелюдия"
    },
    {
      "time": 102.09,
      "end": 103.25,
      "text": "Не можем жить"
    },
    {
      "time": 103.25,
      "end": 104.35,
      "text": "без пармухи, без"
    },
    {
      "time": 104.35,
