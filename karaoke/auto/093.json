    },
    {
      "time": 66.5,
      "end": 67.84,
      "text": "Кому -то накуриться,"
    },
    {
      "time": 68.04,
      "end": 69.18,
      "text": "кому въебать стакан"
    },
    {
      "time": 69.18,
      "end": 70.22,
      "text": "Кому -то Лада,"
    },
    {
      "time": 70.36,
      "end": 71.24,
