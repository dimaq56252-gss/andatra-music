    },
    {
      "time": 191.73,
      "end": 193.05,
      "text": "хочу сделать лучше,"
    },
    {
      "time": 193.65,
      "end": 194.67,
      "text": "я не знаю,"
    },
    {
      "time": 195.07,
      "end": 196.45,
      "text": "как бы надо"
    },
    {
      "time": 196.45,
      "end": 198.43,
      "text": "мной сгущаются тучи,"
    },
    {
      "time": 198.67,
      "end": 200.07,
      "text": "мы их ловим,"
    },
    {
      "time": 200.37,
      "end": 201.83,
      "text": "мы просто, я"
    },
    {
      "time": 201.83,
      "end": 202.45,
      "text": "не знаю,"
    },
    {
      "time": 207.21,
      "end": 208.59,
      "text": "Но я не"
    },
    {
      "time": 208.59,
      "end": 209.81,
      "text": "знаю, какую -то"
