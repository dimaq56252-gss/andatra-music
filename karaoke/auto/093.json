    {
      "time": 263.29,
      "end": 264.03,
      "text": "гружище"
    },
    {
      "time": 265.86,
      "end": 268.06,
      "text": "Взлетаю, как самолет"
    },
    {
      "time": 268.06,
      "end": 269.5,
      "text": "Высоко и правдиво"
    },
    {
      "time": 269.5,
      "end": 270.74,
      "text": "Будет четкий полет"
    },
    {
      "time": 270.74,
      "end": 271.72,
      "text": "Свет читаю, не"
