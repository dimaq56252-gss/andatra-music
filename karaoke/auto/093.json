    {
      "time": 134.15,
      "end": 134.61,
      "text": "галкин"
    },
    {
      "time": 134.61,
      "end": 135.15,
      "text": "Я читал в"
    },
    {
      "time": 135.15,
      "end": 136.21,
      "text": "дырявой майке, зачем"
    },
    {
      "time": 136.21,
      "end": 137.23,
      "text": "ставишь пути палки"
    },
    {
      "time": 137.23,
      "end": 137.97,
      "text": "В твоей группе"
    },
    {
      "time": 137.97,
      "end": 138.83,
      "text": "они лалки, я"
    },
    {
      "time": 138.83,
      "end": 139.81,
      "text": "как не лиги"
    },
    {
      "time": 139.81,
      "end": 140.87,
      "text": "Гэтс, бибей"
    },
    {
      "time": 140.87,
      "end": 145.43,
