    },
    {
      "time": 184.17,
      "end": 185.37,
      "text": "покуда нам говорит"
    },
    {
      "time": 185.37,
      "end": 187.71,
      "text": "чуток, чувак, ты"
    },
    {
      "time": 187.71,
      "end": 188.51,
      "text": "не поедешь в"
    },
    {
      "time": 188.51,
      "end": 190.27,
      "text": "Мадрид, я хочу"
    },
    {
      "time": 190.27,
      "end": 191.73,
