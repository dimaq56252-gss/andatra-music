    {
      "time": 271.72,
      "end": 272.08,
      "text": "криво"
    },
    {
      "time": 272.08,
      "end": 272.96,
      "text": "Мне жизнь уроки"
    },
    {
      "time": 272.96,
      "end": 273.3,
      "text": "дает"
    },
    {
      "time": 273.3,
      "end": 274.7,
      "text": "Надеюсь, не подведет"
    },
    {
      "time": 274.7,
      "end": 275.54,
      "text": "К успеху пусть"
    },
    {
      "time": 275.54,
      "end": 276.2,
      "text": "приведет"
    },
    {
      "time": 276.2,
      "end": 277.1,
      "text": "Подвиг по саму"
    },
    {
      "time": 277.1,
      "end": 277.76,
