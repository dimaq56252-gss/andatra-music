    },
    {
      "time": 277.76,
      "end": 281.0,
      "text": "Я через стрельник"
    },
    {
      "time": 281.0,
      "end": 281.58,
      "text": "звездам"
    },
    {
      "time": 281.58,
      "end": 282.84,
      "text": "Упуть афире опознан"
    },
    {
      "time": 282.84,
      "end": 283.32,
      "text": "В башке не"
    },
    {
      "time": 283.32,
      "end": 284.14,
      "text": "только лишь воздух"
    },
    {
      "time": 284.14,
      "end": 285.02,
      "text": "Я уважаю свой"
    },
    {
      "time": 285.02,
      "end": 285.44,
      "text": "космос"
    },
    {
      "time": 285.44,
      "end": 286.84,
      "text": "Пока сердце качает"
    },
    {
      "time": 286.84,
      "end": 287.68,
      "text": "Кровь по венам"
    },
    {
      "time": 287.68,
      "end": 288.16,
      "text": "мою"
    },
    {
      "time": 288.16,
      "end": 288.94,
      "text": "Я топлю, мне"
    },
    {
      "time": 288.94,
      "end": 289.52,
      "text": "покайфу"
    },
