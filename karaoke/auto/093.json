    },
    {
      "time": 119.65,
      "end": 121.05,
      "text": "Лучше мэрабл, чем"
    },
    {
      "time": 121.05,
      "end": 121.73,
      "text": "хуйню, как вы"
    },
    {
      "time": 121.73,
      "end": 122.39,
      "text": "для нести"
    },
    {
      "time": 122.39,
      "end": 123.55,
      "text": "Пошли нахуй эти"
    },
    {
