      "end": 111.67,
      "text": "типы, хотелось мести"
    },
    {
      "time": 111.67,
      "end": 112.91,
      "text": "Только уровень этих"
    },
    {
      "time": 112.91,
      "end": 113.69,
      "text": "броков во дворе"
