    },
    {
      "time": 255.93,
      "end": 257.23,
      "text": "Братик будет сильно,"
    },
    {
      "time": 257.47,
      "end": 258.61,
      "text": "как осенью бетрища"
    },
    {
      "time": 258.61,
      "end": 259.63,
      "text": "Я выкатил свой"
