      "end": 124.65,
      "text": "опы и пачка"
    },
    {
      "time": 124.65,
      "end": 125.05,
      "text": "бести"
    },
    {
      "time": 125.05,
      "end": 126.39,
      "text": "Буду твоим артиком,"
    },
    {
      "time": 126.47,
      "end": 127.05,
      "text": "ты будешь в"
    },
    {
      "time": 127.05,
      "end": 127.69,
      "text": "моей асти"
    },
    {
      "time": 127.69,
      "end": 128.45,
      "text": "У всей этой"
    },
    {
      "time": 128.45,
      "end": 129.87,
      "text": "шайки, жесть воняет"
    },
    {
      "time": 129.87,
      "end": 130.37,
      "text": "в пасти"
    },
    {
      "time": 130.37,
      "end": 131.17,
      "text": "Секрет по ху,"
    },
    {
      "time": 131.31,
      "end": 132.25,
      "text": "билосталки, я как"
    },
    {
      "time": 132.25,
      "end": 132.73,
      "text": "Макалей"
    },
    {
      "time": 132.73,
      "end": 133.55,
      "text": "Блян, Калкинс, двоих"
