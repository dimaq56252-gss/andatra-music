    {
      "time": 113.69,
      "end": 114.39,
      "text": "стекнести"
    },
    {
      "time": 114.39,
      "end": 115.75,
      "text": "Хотелось бы взнести,"
    },
    {
      "time": 115.83,
      "end": 116.63,
      "text": "прямо со всей"
    },
    {
      "time": 116.63,
      "end": 117.03,
      "text": "чести"
    },
    {
      "time": 117.03,
      "end": 117.91,
      "text": "С халыча биг"
    },
    {
      "time": 117.91,
      "end": 119.23,
      "text": "тесте, запить зелёным"
    },
    {
      "time": 119.23,
      "end": 119.65,
