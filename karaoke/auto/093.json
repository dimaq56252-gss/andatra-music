    },
    {
      "time": 71.24,
      "end": 71.82,
      "text": "Тигуан"
    },
    {
      "time": 71.82,
      "end": 73.22,
      "text": "Кому любимый сын,"
    },
    {
      "time": 73.36,
      "end": 74.62,
      "text": "кому -то наркоман"
    },
    {
      "time": 74.62,
      "end": 75.44,
      "text": "Ты был майор,"
    },
    {
      "time": 75.58,
      "end": 76.56,
      "text": "тебя понизили, ты"
    },
    {
      "time": 76.56,
      "end": 77.14,
