      "time": 244.43,
      "end": 245.35,
      "text": "поможет сыщик"
    },
    {
      "time": 245.35,
      "end": 246.67,
      "text": "Мы делаем аныгром,"
    },
    {
      "time": 246.79,
      "end": 247.97,
      "text": "мы делаем грязища"
    },
    {
      "time": 247.97,
      "end": 249.49,
      "text": "Братик хочет накуриться,"
    },
    {
      "time": 249.53,
      "end": 250.57,
      "text": "я хочу пенища"
    },
    {
      "time": 250.57,
      "end": 251.89,
      "text": "Я предоставил тебе"
    },
    {
      "time": 251.89,
      "end": 253.29,
      "text": "для размышления пища"
    },
    {
      "time": 253.29,
      "end": 254.61,
      "text": "Послушал френды тага,"
    },
    {
      "time": 254.75,
      "end": 255.93,
