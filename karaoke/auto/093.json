    {
      "time": 218.43,
      "end": 219.23,
      "text": "зачитал."
    },
    {
      "time": 221.09,
      "end": 222.23,
      "text": "Я Саня Пыща,"
    },
    {
      "time": 222.27,
      "end": 223.23,
      "text": "знаешь, мой райончик"
    },
    {
      "time": 223.23,
      "end": 224.41,
      "text": "городища, со мной"
    },
    {
      "time": 224.41,
      "end": 225.49,
      "text": "моя мадам, с"
    },
    {
      "time": 225.49,
      "end": 226.65,
      "text": "тобой твоя блядища,"
    },
    {
      "time": 226.75,
      "end": 227.75,
      "text": "ты проебал свои"
    },
    {
      "time": 227.75,
      "end": 228.75,
      "text": "яйца и нихуя"
    },
    {
      "time": 228.75,
      "end": 229.57,
      "text": "не ищешь, я"
    },
    {
      "time": 229.57,
      "end": 230.61,
      "text": "пробиваю в ебло,"
    },
    {
      "time": 230.83,
      "end": 231.65,
      "text": "ты пробиваешь в"
