    },
    {
      "time": 211.21,
      "end": 214.53,
      "text": "надо пятку, короче,"
    },
    {
      "time": 214.99,
      "end": 217.59,
      "text": "тут попиток застелил"
    },
    {
      "time": 217.59,
      "end": 218.43,
      "text": "немного и я"
