    },
    {
      "time": 145.43,
      "end": 146.77,
      "text": "Будь нормальный тикток"
    },
    {
      "time": 146.77,
      "end": 148.93,
      "text": "Мы делаем просто"
    },
    {
      "time": 148.93,
      "end": 149.63,
      "text": "релток"
    },
    {
      "time": 149.98,
      "end": 152.02,
      "text": "Никто из нас"
    },
    {
      "time": 152.02,
      "end": 153.1,
      "text": "Это сделать не"
    },
    {
      "time": 153.1,
      "end": 153.48,
      "text": "смог"
    },
    {
      "time": 153.48,
      "end": 156.12,
      "text": "Я такой просто"
    },
    {
      "time": 156.12,
      "end": 157.3,
      "text": "Поджигаю"
    },
    {
      "time": 157.3,
      "end": 158.84,
      "text": "Эту тему разжигаю"
    },
    {
      "time": 158.84,
      "end": 159.66,
      "text": "Эту тему я"
    },
    {
      "time": 159.66,
      "end": 160.32,
      "text": "не знаю"
    },
    {
      "time": 160.32,
      "end": 162.22,
      "text": "Как хожу в"
    },
    {
      "time": 162.22,
      "end": 162.86,
      "text": "трамвай"
    },
    {
      "time": 162.86,
      "end": 165.58,
      "text": "Это просто вечность"
    },
    {
      "time": 165.58,
      "end": 167.76,
      "text": "Это такая тема"
    },
    {
      "time": 167.76,
      "end": 169.64,
      "text": "Нам летит безумлично"
    },
    {
      "time": 169.64,
      "end": 172.13,
      "text": "По кайфу летим"
    },
    {
      "time": 172.13,
      "end": 173.73,
      "text": "По кайфу читаем"
    },
    {
      "time": 173.73,
      "end": 176.55,
      "text": "и мы разгоняем,"
    },
    {
      "time": 176.67,
      "end": 179.09,
      "text": "мы плачутом фристайли,"
    },
    {
      "time": 179.21,
      "end": 180.51,
      "text": "это наш просто"
    },
    {
      "time": 180.51,
      "end": 182.99,
