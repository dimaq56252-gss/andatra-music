    },
    {
      "time": 79.86,
      "end": 81.24,
      "text": "Нас любит Лукашенко,"
    },
    {
      "time": 81.42,
      "end": 82.52,
      "text": "мы любим картофан"
    },
    {
      "time": 82.52,
      "end": 83.88,
      "text": "Мой братьевка Саня"
    },
    {
      "time": 83.88,
      "end": 85.24,
      "text": "Пыщев, он лудоман"
    },
    {
      "time": 85.24,
      "end": 86.56,
      "text": "Твой любимый рэпер"
    },
    {
      "time": 86.56,
      "end": 87.9,
      "text": "ветер, мы ураган"
    },
    {
      "time": 87.9,
      "end": 89.26,
      "text": "Твоя пизда старушка,"
    },
    {
      "time": 89.26,
      "end": 90.48,
      "text": "как курага"
    },
    {
      "time": 90.48,
      "end": 92.04,
      "text": "Я такой аморальный,"
    },
    {
      "time": 92.16,
      "end": 93.08,
      "text": "похуже кулака"
    },
    {
      "time": 93.08,
      "end": 94.68,
      "text": "Ты включил пидораса,"
    },
    {
      "time": 94.78,
      "end": 95.9,
      "text": "я включил дурака"
    },
    {
      "time": 95.9,
      "end": 99.91,
      "text": "Не хватает поманки,"
    },
    {
      "time": 100.01,
      "end": 100.75,
      "text": "по биту скажу"
    },
    {
      "time": 100.75,
      "end": 101.25,
      "text": "как санки"
    },
    {
      "time": 101.25,
      "end": 102.01,
      "text": "В этих джунглях"
    },
    {
      "time": 102.01,
      "end": 102.91,
      "text": "буду манки, твои"
    },
    {
      "time": 102.91,
      "end": 103.57,
      "text": "псы всего лишь"
    },
    {
      "time": 103.57,
      "end": 103.91,
      "text": "майки"
    },
    {
      "time": 103.91,
      "end": 104.93,
      "text": "На смене кручу"
