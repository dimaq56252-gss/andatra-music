    },
    {
      "time": 17.93,
      "end": 19.67,
      "text": "Нам нечистокроны своих"
    },
    {
      "time": 19.67,
      "end": 20.93,
      "text": "не арендован"
    },
    {
      "time": 20.93,
      "end": 22.33,
      "text": "Сколько возле дома"
    },
    {
      "time": 22.33,
      "end": 24.01,
      "text": "будет брабус припакован"
    },
    {
