  "cues": [
    {
      "time": 12.24,
      "end": 14.1,
      "text": "Миксуем старые пластинки"
    },
    {
      "time": 14.1,
      "end": 15.22,
      "text": "Ты был мусорской"
    },
    {
      "time": 15.22,
      "end": 15.8,
      "text": "подстилкой"
    },
    {
      "time": 15.8,
      "end": 16.88,
      "text": "Андатор всегда на"
    },
    {
      "time": 16.88,
      "end": 17.28,
      "text": "стиле"
    },
    {
      "time": 17.28,
      "end": 18.14,
      "text": "Ты мой фрак"
    },
    {
      "time": 18.14,
      "end": 18.76,
      "text": "подстилил"
    },
    {
      "time": 18.76,
      "end": 20.06,
      "text": "Габан нехило так"
    },
    {
      "time": 20.06,
      "end": 20.58,
      "text": "поднял"
    },
    {
      "time": 20.58,
      "end": 21.84,
      "text": "Рублей на стиме"
    },
    {
      "time": 21.84,
      "end": 22.82,
      "text": "Ты помнишь, как"
    },
    {
      "time": 22.82,
      "end": 23.82,
      "text": "джигант пизды дал"
    },
    {
      "time": 23.82,
      "end": 24.98,
      "text": "Грыми руки Стиву"
    },
    {
      "time": 24.98,
      "end": 26.18,
      "text": "Со мной Мишаня"
    },
    {
      "time": 26.18,
      "end": 26.8,
      "text": "Алмае"
    },
    {
      "time": 26.8,
      "end": 28.14,
      "text": "И акула Дима"
    },
    {
      "time": 28.14,
      "end": 29.36,
      "text": "С тобой подсосы"
    },
    {
      "time": 29.36,
      "end": 30.08,
      "text": "пидорасы"
    },
    {
      "time": 30.08,
      "end": 31.24,
      "text": "И одни бледины"
    },
    {
      "time": 31.24,
      "end": 32.52,
      "text": "Говно невкусное"
    },
    {
      "time": 32.52,
      "end": 33.6,
      "text": "Миллионы мух не"
    },
    {
      "time": 33.6,
      "end": 34.34,
      "text": "убедили"
    },
    {
      "time": 34.34,
      "end": 35.36,
      "text": "Братан, мы так"
    },
    {
      "time": 35.36,
      "end": 36.14,
      "text": "же в Коломне"
    },
    {
      "time": 36.14,
      "end": 37.64,
      "text": "Топчем свои ботинки"
    },
    {
      "time": 37.64,
      "end": 39.1,
      "text": "Испанский рэп напишем"
    },
    {
      "time": 39.1,
      "end": 40.66,
      "text": "Рубинкам и латинкам"
    },
    {
      "time": 40.66,
      "end": 42.26,
      "text": "Иди отсюда нахуй"
    },
    {
      "time": 42.26,
      "end": 43.82,
      "text": "Ты пидарас противный"
    },
    {
      "time": 43.82,
      "end": 44.74,
      "text": "Ты знаешь, что"
    },
    {
      "time": 44.74,
      "end": 45.48,
      "text": "у джебуда"
    },
    {
      "time": 45.48,
      "end": 46.52,
      "text": "Больше нам не"
    },
    {
      "time": 46.52,
      "end": 47.08,
      "text": "противник"
    },
    {
      "time": 47.08,
      "end": 48.04,
      "text": "Прошло то время,"
    },
    {
      "time": 48.06,
      "end": 49.6,
      "text": "когда музыканты были"
    },
    {
      "time": 49.6,
      "end": 50.32,
      "text": "бременские"
    },
    {
      "time": 50.32,
      "end": 51.08,
      "text": "Браток, ты не"
    },
    {
      "time": 51.08,
      "end": 51.72,
      "text": "проживешь"
    },
    {
      "time": 51.72,
      "end": 53.44,
      "text": "На зарплату ленинскую"
    },
    {
      "time": 53.44,
      "end": 54.62,
      "text": "Где пизды мешок"
    },
    {
      "time": 54.62,
      "end": 54.98,
      "text": "муки"
    },
    {
      "time": 54.98,
      "end": 56.4,
      "text": "И лишь трудельвенский"
    },
    {
      "time": 56.4,
      "end": 57.94,
      "text": "На трусмете сварим"
    },
    {
      "time": 57.94,
      "end": 58.4,
      "text": "пиво"
    },
    {
      "time": 58.4,
      "end": 59.52,
      "text": "Губ жатецкий"
    },
    {
      "time": 59.52,
      "end": 60.6,
      "text": "Со мной мешание,"
    },
    {
      "time": 60.6,
      "end": 61.14,
      "text": "а уже с"
    },
    {
      "time": 61.14,
      "end": 61.46,
      "text": "куфе"
    },
    {
      "time": 61.46,
      "end": 62.62,
      "text": "Это не жванецкий"
    },
    {
      "time": 62.62,
      "end": 64.08,
      "text": "Придет однажды день"
    },
    {
      "time": 64.08,
      "end": 65.36,
      "text": "И всем настанет"
    },
    {
      "time": 65.36,
      "end": 65.82,
      "text": "пиздец"
    },
    {
      "time": 65.82,
      "end": 66.88,
      "text": "Ты все играешь"
    },
    {
      "time": 66.88,
      "end": 67.28,
      "text": "в доту"
    },
    {
      "time": 67.28,
      "end": 68.16,
      "text": "У тебя в"
    },
    {
      "time": 68.16,
      "end": 68.9,
      "text": "жопе детство"
    },
    {
      "time": 68.9,
      "end": 70.02,
      "text": "Ты как Баста"
    },
    {
      "time": 70.02,
      "end": 70.98,
      "text": "Крю, у тебя"
    },
    {
      "time": 70.98,
      "end": 72.0,
      "text": "прокисло тесто"
    },
    {
      "time": 72.0,
      "end": 73.18,
      "text": "Ты знаешь наших"
    },
    {
      "time": 73.18,
      "end": 74.36,
      "text": "братьев, ты знаешь"
    },
    {
      "time": 74.36,
      "end": 75.12,
      "text": "наше место"
    },
    {
      "time": 75.12,
      "end": 76.22,
      "text": "Мы будто дети"
    },
    {
      "time": 76.22,
      "end": 77.8,
      "text": "плотника, несём свой"
    },
    {
      "time": 77.8,
      "end": 78.32,
      "text": "крест"
    },
    {
      "time": 78.32,
      "end": 79.52,
      "text": "Тебя ебал твой"
    },
    {
      "time": 79.52,
      "end": 80.9,
      "text": "батя, это был"
    },
    {
      "time": 80.9,
      "end": 81.44,
      "text": "инцест"
    },
    {
      "time": 81.44,
      "end": 82.46,
      "text": "Я раньше рэп"
    },
    {
      "time": 82.46,
      "end": 83.4,
      "text": "не делал, я"
    },
    {
      "time": 83.4,
      "end": 84.78,
      "text": "раньше был инвестором"
    },
    {
      "time": 84.78,
      "end": 85.62,
      "text": "Ты помнишь, как"
    },
    {
      "time": 85.62,
      "end": 86.44,
      "text": "мы угнали с"
    },
    {
      "time": 86.44,
      "end": 87.76,
      "text": "тобой Ладу Весту?"
    },
    {
      "time": 87.88,
      "end": 88.48,
      "text": "Ты чё -то"
    },
    {
      "time": 88.48,
      "end": 89.84,
      "text": "там пизднишь, давай"
    },
    {
      "time": 89.84,
      "end": 90.86,
      "text": "заткнись Эрнеста"
    },
    {
      "time": 90.86,
      "end": 91.9,
      "text": "Я лягу прямо"
    },
    {
      "time": 91.9,
      "end": 92.96,
      "text": "на кухне, давай"
    },
    {
      "time": 92.96,
      "end": 93.96,
      "text": "раздвиг мне кресла"
    },
    {
      "time": 93.96,
      "end": 96.5,
      "text": "Либераки съебались, закончились"
    },
    {
      "time": 96.5,
      "end": 97.14,
      "text": "протесты"
    },
    {
      "time": 97.14,
      "end": 97.82,
      "text": "Нас ждут с"
    },
    {
      "time": 97.82,
      "end": 98.84,
      "text": "концертом в челике,"
    },
    {
      "time": 98.88,
      "end": 100.22,
      "text": "в городе невест"
    },
    {
      "time": 100.22,
      "end": 101.16,
      "text": "Ты хочешь в"
    },
    {
      "time": 101.16,
      "end": 102.46,
      "text": "путь сандатры, браток,"
    },
    {
      "time": 102.48,
      "end": 103.38,
      "text": "неинтересно"
    },
    {
      "time": 103.38,
      "end": 104.5,
      "text": "Я слушал ваши"
    },
    {
      "time": 104.5,
      "end": 106.1,
      "text": "песни, это просто"
    },
    {
      "time": 106.1,
      "end": 106.56,
      "text": "беспонд"
    },
    {
      "time": 106.56,
      "end": 107.96,
      "text": "Несу свою хуйню,"
    },
    {
      "time": 108.44,
      "end": 109.58,
      "text": "меня попутал бес"
    },
    {
      "time": 109.58,
      "end": 110.74,
      "text": "Рожден как будто"
    },
    {
      "time": 110.74,
      "end": 112.38,
      "text": "вчера, но имею"
    },
    {
      "time": 112.38,
      "end": 112.7,
      "text": "вес"
    },
    {
      "time": 112.7,
      "end": 114.06,
      "text": "Тут много полких"
    },
    {
      "time": 114.06,
      "end": 115.7,
      "text": "слов и незаконченных"
    },
    {
      "time": 115.7,
      "end": 116.22,
      "text": "текстов"
    },
    {
      "time": 116.22,
      "end": 117.14,
      "text": "О них узнает"
    },
    {
