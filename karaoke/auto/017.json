      "time": 126.34,
      "end": 128.02,
      "text": "В полусонном состоянии"
    },
    {
      "time": 128.02,
      "end": 128.9,
      "text": "Ватнул кол, как"
    },
    {
      "time": 128.9,
      "end": 129.7,
      "text": "на татаме"
    },
    {
      "time": 129.7,
      "end": 130.62,
      "text": "Кручу стик и"
    },
    {
      "time": 130.62,
      "end": 131.4,
      "text": "за ригами"
    },
    {
      "time": 131.4,
      "end": 132.34,
      "text": "Очень злой, я"
    },
    {
      "time": 132.34,
      "end": 133.16,
      "text": "болен маме"
    },
    {
      "time": 133.16,
      "end": 134.68,
      "text": "Лали плачет на"
    },
    {
      "time": 134.68,
      "end": 135.24,
      "text": "диване"
    },
    {
      "time": 135.24,
      "end": 136.2,
      "text": "Что алмаз не"
    },
    {
      "time": 136.2,
      "end": 137.0,
      "text": "в ее спальне"
    },
    {
      "time": 137.0,
      "end": 137.88,
      "text": "Хочет банк и"
    },
    {
      "time": 137.88,
      "end": 138.7,
      "text": "быть как Харли"
    },
    {
      "time": 138.7,
      "end": 139.98,
      "text": "Мой ластайл Хали"
    },
    {
      "time": 139.98,
      "end": 140.4,
      "text": "Гали"
    },
    {
      "time": 143.45,
      "end": 145.15,
      "text": "Есть движение, есть"
    },
    {
      "time": 145.15,
      "end": 145.59,
      "text": "темы"
    },
    {
      "time": 145.59,
      "end": 146.43,
      "text": "Есть команда"
    },
    {
      "time": 146.43,
      "end": 147.61,
      "text": "Не спать, я"
    },
    {
      "time": 147.61,
      "end": 148.95,
      "text": "не могу больше"
    },
    {
      "time": 148.95,
      "end": 150.63,
      "text": "ничего вам рассказать"
    },
    {
      "time": 150.63,
      "end": 152.21,
      "text": "Стой, снова вхожу"
    },
    {
      "time": 152.21,
      "end": 153.47,
      "text": "туда, где тишина"
    },
    {
      "time": 153.47,
      "end": 156.35,
      "text": "Снова выбираю лабиринт"
    },
    {
      "time": 156.35,
      "end": 157.03,
      "text": "без сна"
    },
    {
      "time": 157.03,
      "end": 158.85,
      "text": "Слезы на глазах,"
    },
    {
      "time": 158.95,
      "end": 160.39,
      "text": "капли теплого дождя"
    },
    {
      "time": 160.39,
      "end": 163.29,
      "text": "Температурой отличается осень"
    },
    {
      "time": 163.29,
      "end": 163.87,
      "text": "и весна"
    },
    {
      "time": 163.87,
      "end": 166.61,
      "text": "Неспроста замерзшие пальцы"
    },
    {
      "time": 166.61,
      "end": 168.39,
      "text": "Это показатель фальши"
    },
    {
      "time": 168.39,
      "end": 171.09,
      "text": "Обивает желание двигаться"
    },
    {
      "time": 171.09,
      "end": 171.63,
      "text": "дальше"
    },
    {
      "time": 171.63,
      "end": 173.69,
      "text": "Надо рассмотреть, золото"
    },
    {
      "time": 173.69,
      "end": 175.05,
      "text": "ты или медь"
    },
    {
      "time": 175.05,
      "end": 176.03,
      "text": "Ведь от пробы"
    },
    {
      "time": 176.03,
      "end": 177.35,
      "text": "идет прибыль, хватит"
    },
    {
      "time": 177.35,
      "end": 178.51,
      "text": "об этом петь"
    },
    {
      "time": 178.51,
      "end": 179.87,
      "text": "Ведь смысл текста"
    },
    {
      "time": 179.87,
      "end": 181.01,
      "text": "про то, как"
    },
    {
      "time": 181.01,
      "end": 181.75,
      "text": "согреть"
    },
    {
      "time": 181.75,
      "end": 183.07,
      "text": "А ты пытаешься"
    },
    {
      "time": 183.07,
      "end": 184.11,
      "text": "в пустую вновь"
    },
    {
      "time": 184.11,
      "end": 185.19,
      "text": "и вновь сгореть"
    },
    {
      "time": 185.39,
      "end": 198.896327,
      "text": "♪ Компромат"
    }
  ],
