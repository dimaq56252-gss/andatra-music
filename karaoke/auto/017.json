      "text": "ты будем бить"
    },
    {
      "time": 95.28,
      "end": 96.64,
      "text": "Сучий только, блядь,"
    },
    {
      "time": 96.64,
      "end": 97.54,
      "text": "умеет в своих"
    },
    {
      "time": 97.54,
      "end": 98.74,
      "text": "треках воду лить"
    },
    {
      "time": 98.74,
      "end": 100.0,
      "text": "Зачем скалишь мне"
    },
    {
      "time": 100.0,
      "end": 101.22,
      "text": "ебало? Я курю,"
    },
    {
      "time": 101.34,
      "end": 102.26,
      "text": "мне всегда мало"
    },
    {
      "time": 102.26,
      "end": 104.9,
