      "text": "Дмитрию богатого"
    },
    {
      "time": 13.54,
      "end": 15.18,
      "text": "Ограбили ломбард"
    },
    {
      "time": 15.18,
      "end": 16.18,
      "text": "У нас на"
    },
    {
      "time": 16.18,
      "end": 17.28,
      "text": "мэра компромат"
    },
    {
      "time": 17.28,
      "end": 18.24,
      "text": "Ты пидор, хочешь"
    },
    {
      "time": 18.24,
      "end": 18.98,
      "text": "парамсить"
    },
    {
      "time": 18.98,
      "end": 19.96,
      "text": "Ты для андатер"
    },
    {
      "time": 19.96,
      "end": 20.66,
      "text": "маловат"
    },
    {
      "time": 20.66,
      "end": 22.12,
      "text": "Мой район сила"
    },
    {
      "time": 22.12,
      "end": 23.78,
      "text": "Сила как Ахмат"
    },
    {
      "time": 23.78,
      "end": 24.86,
      "text": "Во мне сейчас"
    },
    {
      "time": 24.86,
      "end": 25.64,
      "text": "две плюхи"
    },
    {
      "time": 25.64,
      "end": 26.96,
      "text": "Ни копейки с"
    },
    {
      "time": 26.96,
      "end": 27.28,
      "text": "рэпа"
    },
    {
      "time": 27.28,
      "end": 28.5,
      "text": "Мы тебе не"
    },
    {
      "time": 28.5,
      "end": 29.02,
      "text": "шлюхи"
    },
    {
      "time": 29.02,
      "end": 31.16,
      "text": "Подъехал мусорской УАЗик"
    },
    {
      "time": 31.16,
      "end": 32.46,
      "text": "Пацан не шухер,"
    },
    {
      "time": 32.58,
      "end": 34.16,
      "text": "бандитская ежетуха"
    },
    {
      "time": 34.16,
      "end": 35.64,
      "text": "Мой братик приболел"
    },
    {
      "time": 35.64,
      "end": 36.82,
      "text": "немного, у него"
    },
    {
      "time": 36.82,
      "end": 37.6,
      "text": "желтуха"
    },
    {
      "time": 37.6,
      "end": 38.82,
      "text": "В рот ебалки"
    },
    {
      "time": 38.82,
      "end": 40.74,
      "text": "Зару, его музло"
    },
    {
      "time": 40.74,
      "end": 41.4,
      "text": "протухло"
    },
    {
      "time": 41.4,
      "end": 42.22,
      "text": "Там, где волки"
    },
    {
      "time": 42.22,
      "end": 43.94,
      "text": "срать боятся, проживают"
    },
    {
      "time": 43.94,
      "end": 44.96,
      "text": "мои пацаки"
    },
    {
      "time": 44.96,
      "end": 46.8,
      "text": "Зашел фавелу, нужна"
    },
    {
      "time": 46.8,
      "end": 47.9,
      "text": "эвакуация"
    },
    {
      "time": 47.9,
      "end": 50.0,
      "text": "Вы ежемесячные, мы"
    },
    {
      "time": 50.0,
      "end": 51.36,
      "text": "ежа обуляция"
    },
    {
      "time": 51.36,
      "end": 52.5,
      "text": "Рэпа нет в"
    },
    {
      "time": 52.5,
      "end": 53.66,
      "text": "России, как у"
    },
    {
      "time": 53.66,
      "end": 54.82,
      "text": "цыган нации"
    },
    {
      "time": 54.82,
      "end": 56.04,
      "text": "Ты сосал за"
    },
    {
      "time": 56.04,
      "end": 56.98,
      "text": "два рубля, теперь"
    },
    {
      "time": 56.98,
      "end": 58.54,
      "text": "за рубль инфляция"
    },
    {
      "time": 58.54,
      "end": 59.98,
      "text": "Хильки говорю пока,"
    },
    {
      "time": 60.22,
      "end": 61.16,
      "text": "он говорит на"
    },
    {
      "time": 61.16,
      "end": 61.76,
      "text": "рациях"
    },
    {
      "time": 61.76,
      "end": 63.32,
      "text": "Рэп читаю годик,"
    },
    {
      "time": 63.4,
      "end": 64.32,
      "text": "но дал уже"
    },
    {
      "time": 64.32,
      "end": 64.74,
      "text": "просраться"
    },
    {
      "time": 65.06,
      "end": 67.54,
      "text": "Рэпер обалбиск, сделал"
    },
    {
      "time": 67.54,
      "end": 69.04,
      "text": "на меня реакцию"
    },
    {
      "time": 69.04,
      "end": 70.58,
      "text": "Мы варим пиво,"
    },
    {
      "time": 70.72,
      "end": 72.5,
      "text": "как пивоваров на"
    },
    {
      "time": 72.5,
      "end": 72.92,
      "text": "редакции"
    },
    {
      "time": 73.58,
      "end": 75.04,
      "text": "Андапер за тебя"
    },
    {
      "time": 75.04,
      "end": 76.54,
      "text": "в любой ситуации"
    },
    {
      "time": 77.1,
      "end": 78.1,
      "text": "Ты едешь на"
    },
    {
      "time": 78.1,
      "end": 79.36,
      "text": "Галутвина, я до"
    },
    {
      "time": 79.36,
      "end": 80.58,
      "text": "колонны станции"
    },
    {
      "time": 80.58,
      "end": 82.24,
      "text": "Френдли тага ебут"
    },
    {
      "time": 82.24,
      "end": 84.34,
      "text": "онлайн без регистрации"
    },
    {
      "time": 84.34,
      "end": 85.4,
      "text": "Бой!"
    },
    {
      "time": 85.54,
      "end": 86.86,
      "text": "Рэпер, блядь, читает"
    },
    {
      "time": 86.86,
      "end": 87.64,
      "text": "про это, говоришь,"
    },
    {
      "time": 87.66,
      "end": 88.42,
      "text": "что он трущит"
    },
    {
      "time": 88.42,
      "end": 89.9,
      "text": "Ты ебаный стища,"
    },
    {
      "time": 90.0,
      "end": 90.66,
      "text": "знаешь то, что"
    },
    {
      "time": 90.66,
      "end": 91.92,
      "text": "ты говно прилип"
    },
    {
      "time": 91.92,
      "end": 93.48,
      "text": "Мягкий пиздобол, таких"
    },
    {
      "time": 93.48,
      "end": 94.4,
      "text": "на блоке, как"
    },
    {
      "time": 94.4,
