    },
    {
      "time": 59.68,
      "end": 60.24,
      "text": "Но и чуть"
    },
    {
      "time": 60.24,
      "end": 61.8,
      "text": "больше решений, я"
    },
    {
      "time": 61.8,
      "end": 63.12,
      "text": "хочу продолжений"
    },
    {
      "time": 63.12,
      "end": 64.18,
      "text": "Я не теряюсь"
    },
    {
      "time": 64.18,
      "end": 65.44,
      "text": "в сомнениях, просто"
    },
    {
      "time": 65.44,
      "end": 66.08,
      "text": "не заметил"
    },
    {
      "time": 66.08,
      "end": 67.76,
      "text": "Вокруг меня лишь"
    },
    {
      "time": 67.76,
      "end": 69.2,
      "text": "цепи, мир вокруг"
    },
    {
      "time": 69.2,
      "end": 70.14,
      "text": "просто пепел"
    },
    {
      "time": 70.14,
      "end": 70.98,
      "text": "Я не иду"
    },
    {
      "time": 70.98,
      "end": 72.16,
      "text": "за толпой, мне"
    },
    {
      "time": 72.16,
      "end": 73.08,
      "text": "это неинтересно"
    },
    {
      "time": 73.6,
      "end": 74.26,
      "text": "В мой умут"
    },
    {
      "time": 74.26,
      "end": 75.22,
      "text": "я с головой,"
    },
    {
      "time": 75.32,
      "end": 76.04,
      "text": "и мне по"
    },
    {
      "time": 76.04,
      "end": 77.14,
      "text": "кайфу честно"
    },
    {
      "time": 77.14,
      "end": 78.76,
      "text": "Вокруг опять негатив,"
    },
    {
      "time": 79.2,
      "end": 79.68,
      "text": "но во мне"
    },
    {
      "time": 79.68,
      "end": 80.5,
      "text": "полно сил"
    },
    {
      "time": 80.5,
      "end": 81.52,
      "text": "Ведь это мой"
    },
    {
      "time": 81.52,
      "end": 83.06,
      "text": "мотив, его я"
    },
    {
      "time": 83.06,
      "end": 84.72,
      "text": "застелил, его я"
    },
    {
      "time": 84.72,
      "end": 85.28,
      "text": "не купил"
    },
    {
      "time": 85.76,
      "end": 87.08,
      "text": "Я это делаю"
    },
    {
      "time": 87.08,
      "end": 88.5,
      "text": "сам, всегда лечу"
    },
    {
      "time": 88.5,
      "end": 89.4,
      "text": "в своем мире"
    },
    {
      "time": 89.4,
      "end": 91.1,
      "text": "к разным палеосам"
    },
    {
      "time": 91.1,
      "end": 92.86,
      "text": "Выбрались на природу,"
    },
    {
      "time": 93.02,
      "end": 93.8,
      "text": "тут звери и"
    },
    {
      "time": 93.8,
      "end": 94.46,
      "text": "собаки"
    },
    {
      "time": 94.46,
      "end": 96.4,
      "text": "Непонятной породы"
    },
    {
      "time": 96.4,
      "end": 98.08,
      "text": "Грибы собрали, спрятали"
    },
    {
      "time": 98.08,
      "end": 99.02,
      "text": "под бороду"
    },
    {
      "time": 99.02,
      "end": 100.12,
      "text": "На даче очень"
    },
    {
      "time": 100.12,
      "end": 101.44,
      "text": "хорошо, но мы"
    },
    {
      "time": 101.44,
      "end": 102.28,
      "text": "любим город"
    },
    {
      "time": 102.28,
      "end": 103.62,
      "text": "Тут все продукты"
    },
    {
      "time": 103.62,
      "end": 104.54,
      "text": "в магазе, не"
    },
    {
      "time": 104.54,
      "end": 105.68,
      "text": "нужен огород"
    },
    {
      "time": 105.68,
      "end": 107.36,
      "text": "Альбом заценит мой"
    },
    {
      "time": 107.36,
      "end": 109.18,
      "text": "кореш, Коля Огород"
    },
    {
      "time": 109.18,
      "end": 110.6,
      "text": "На даче очень"
    },
    {
      "time": 110.6,
      "end": 112.7,
      "text": "пиздато, чище кислород"
    },
    {
      "time": 112.7,
      "end": 114.78,
      "text": "Нас затянула музыка,"
    },
    {
      "time": 114.86,
      "end": 116.04,
      "text": "как будто вода"
    },
    {
      "time": 116.04,
      "end": 116.34,
      "text": "в ворот"
