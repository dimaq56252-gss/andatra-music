  "cues": [
    {
      "time": 13.27,
      "end": 14.43,
      "text": "Мы залетели к"
    },
    {
      "time": 14.43,
      "end": 15.29,
      "text": "Мишане на дачу"
    },
    {
      "time": 15.29,
      "end": 16.29,
      "text": "Я ощущаю себя"
    },
    {
      "time": 16.29,
      "end": 16.93,
      "text": "как копатыш"
    },
    {
      "time": 16.93,
      "end": 18.05,
      "text": "Своя пизда встает"
    },
    {
      "time": 18.05,
      "end": 18.67,
      "text": "на карачке"
    },
    {
      "time": 18.67,
      "end": 19.65,
      "text": "Ты хуета, а"
    },
    {
      "time": 19.65,
      "end": 20.41,
      "text": "я трех вначале"
    },
    {
      "time": 20.41,
      "end": 21.17,
      "text": "Мы не служили,"
    },
    {
      "time": 21.23,
      "end": 22.07,
      "text": "но жестко качаем"
    },
    {
      "time": 22.07,
      "end": 23.05,
      "text": "Я Леонардо из"
    },
    {
      "time": 23.05,
      "end": 23.81,
      "text": "фильма «Начало»"
    },
    {
      "time": 23.81,
      "end": 24.95,
      "text": "Мои ребята стоят"
    },
    {
      "time": 24.95,
      "end": 25.45,
      "text": "у перчала"
    },
    {
      "time": 25.45,
      "end": 26.33,
      "text": "Я как апостол,"
    },
    {
      "time": 26.41,
      "end": 26.81,
      "text": "а ты как"
    },
    {
      "time": 26.81,
      "end": 27.27,
      "text": "опёздал"
    },
    {
      "time": 27.27,
      "end": 28.01,
      "text": "Да мы женаты,"
    },
    {
      "time": 28.09,
      "end": 28.61,
      "text": "но ходим по"
    },
    {
      "time": 28.61,
      "end": 28.95,
      "text": "пёсам"
    },
    {
      "time": 28.95,
      "end": 29.63,
      "text": "Я качу стиль,"
    },
    {
      "time": 29.83,
      "end": 30.67,
      "text": "ты хочешь балбоса"
    },
    {
      "time": 30.67,
      "end": 31.47,
      "text": "Напал на облака,"
    },
    {
      "time": 31.63,
      "end": 32.33,
      "text": "пламой боролся"
    },
    {
      "time": 32.33,
      "end": 33.51,
      "text": "Если умерешь, принесут"
    },
    {
      "time": 33.51,
      "end": 34.01,
      "text": "тебе розы"
    },
    {
      "time": 34.01,
      "end": 34.87,
      "text": "Если ты Рэйчел,"
    },
    {
      "time": 34.95,
      "end": 35.75,
      "text": "тогда буду розом"
    },
    {
      "time": 35.75,
      "end": 36.89,
      "text": "Тебя называют друзья"
    },
    {
      "time": 36.89,
      "end": 37.53,
      "text": "хуесосом"
    },
    {
      "time": 37.53,
      "end": 38.33,
      "text": "Помню как Баста"
    },
    {
      "time": 38.33,
      "end": 39.23,
      "text": "читал про насосы"
    },
    {
      "time": 39.23,
      "end": 40.01,
      "text": "Мы крутим ропасти,"
    },
    {
      "time": 40.15,
      "end": 40.99,
      "text": "ты крутишь колеса"
    },
    {
      "time": 40.99,
      "end": 41.75,
      "text": "Ты проебал две"
    },
    {
      "time": 41.75,
      "end": 42.71,
      "text": "копейки в наперске"
    },
    {
      "time": 42.71,
      "end": 43.63,
      "text": "Пахнешь говном, я"
    },
    {
      "time": 43.63,
      "end": 44.39,
      "text": "пахну кокосом"
    },
    {
      "time": 44.39,
      "end": 45.11,
      "text": "В моем бибикю,"
    },
    {
      "time": 45.25,
      "end": 46.09,
      "text": "есть два негритоса"
    },
    {
      "time": 46.09,
      "end": 46.99,
      "text": "Ебальник свой видела,"
    },
    {
      "time": 46.99,
      "end": 47.83,
      "text": "че за запросы"
    },
    {
      "time": 47.83,
      "end": 48.63,
      "text": "Пустили по кругу,"
    },
    {
      "time": 48.71,
      "end": 49.47,
      "text": "въебали по носу"
    },
    {
      "time": 49.47,
      "end": 50.09,
      "text": "Ты пьяный тогда,"
    },
    {
      "time": 50.19,
      "end": 50.85,
      "text": "с тебя двойной"
    },
    {
      "time": 50.85,
      "end": 51.07,
      "text": "спрос"
    },
    {
      "time": 51.07,
      "end": 52.47,
      "text": "Порвали пизду, порвали"
    },
    {
      "time": 52.47,
      "end": 52.81,
      "text": "и трес"
    },
    {
      "time": 52.81,
      "end": 53.89,
      "text": "Качаем толпу, как"
    },
    {
      "time": 53.89,
      "end": 54.55,
      "text": "бинзонасос"
    },
    {
      "time": 54.55,
      "end": 55.13,
      "text": "Ты едешь на"
    },
    {
      "time": 55.13,
      "end": 56.47,
      "text": "тачке, мусоровоз, тут"
    },
    {
      "time": 56.47,
      "end": 57.49,
      "text": "дачный участок, а"
    },
    {
      "time": 57.49,
      "end": 57.95,
      "text": "не колхоз"
    },
    {
      "time": 57.95,
      "end": 58.59,
      "text": "Ты едешь на"
    },
    {
      "time": 58.59,
      "end": 59.89,
      "text": "тачке, мусоровоз, тут"
    },
    {
      "time": 59.89,
      "end": 60.91,
      "text": "дачный участок, а"
    },
    {
      "time": 60.91,
      "end": 61.43,
      "text": "не колхоз"
    },
    {
      "time": 61.43,
      "end": 62.75,
      "text": "Видел Макара, он"
    },
    {
      "time": 62.75,
      "end": 63.65,
      "text": "на Белике Горе"
    },
    {
      "time": 63.65,
      "end": 64.23,
      "text": "закладом"
    },
    {
      "time": 64.23,
      "end": 65.35,
      "text": "Но мне, пожалуйста,"
    },
    {
      "time": 65.57,
      "end": 66.31,
      "text": "доставку на дом"
    },
    {
      "time": 67.03,
      "end": 67.99,
      "text": "Доставку на дом"
    },
    {
      "time": 69.21,
      "end": 70.59,
      "text": "Заебался целый день,"
    },
    {
      "time": 70.71,
      "end": 71.51,
      "text": "не курил на"
    },
    {
      "time": 71.51,
      "end": 72.09,
      "text": "студии"
    },
    {
      "time": 72.09,
      "end": 73.23,
      "text": "Жду, пока все"
    },
    {
      "time": 73.23,
      "end": 74.27,
      "text": "начитаются"
    },
    {
      "time": 74.27,
      "end": 75.49,
      "text": "Да, бле, вот"
    },
    {
      "time": 75.49,
      "end": 76.55,
      "text": "и Келе молчит,"
    },
    {
      "time": 76.61,
      "end": 77.57,
      "text": "но обещался"
    },
    {
      "time": 77.57,
      "end": 79.05,
      "text": "Все будет ровно,"
    },
    {
      "time": 79.31,
      "end": 80.25,
      "text": "один кусок на"
    },
    {
      "time": 80.25,
      "end": 80.65,
      "text": "всех"
    },
    {
      "time": 80.65,
      "end": 82.49,
      "text": "Нам будет годно"
    },
    {
      "time": 82.49,
      "end": 83.95,
      "text": "Кто такой? Я"
    },
    {
      "time": 83.95,
      "end": 85.59,
      "text": "хочу еще, даже"
    },
    {
      "time": 85.59,
      "end": 87.59,
      "text": "будет еще, дорогой"
    },
    {
      "time": 87.59,
      "end": 88.09,
      "text": "дерьмо"
    },
    {
      "time": 88.09,
      "end": 89.63,
      "text": "Кто ты такой,"
    },
    {
      "time": 89.91,
      "end": 91.33,
      "text": "парень? Меня совсем"
    },
    {
      "time": 91.33,
      "end": 92.37,
      "text": "не парит, просто"
    },
    {
      "time": 92.37,
      "end": 93.79,
      "text": "нужен новый налик"
    },
    {
      "time": 93.79,
      "end": 94.97,
      "text": "Мы забрали новый"
    },
    {
      "time": 94.97,
      "end": 96.67,
      "text": "налик, твоя сука"
    },
    {
      "time": 96.67,
      "end": 97.13,
      "text": "с нами"
    },
    {
      "time": 97.13,
      "end": 98.35,
      "text": "Мне две суки"
    },
    {
      "time": 98.35,
      "end": 99.67,
      "text": "с нами, четыре"
    },
    {
      "time": 99.67,
      "end": 100.55,
      "text": "суки с нами,"
    },
    {
      "time": 101.11,
      "end": 102.01,
      "text": "пять сучек с"
    },
    {
      "time": 102.01,
      "end": 102.31,
      "text": "нами"
    },
    {
      "time": 102.31,
      "end": 104.17,
      "text": "Устроил сучкам прайзик,"
    },
    {
      "time": 104.37,
      "end": 105.87,
      "text": "кончаю им шампанским,"
    },
    {
      "time": 106.07,
      "end": 106.85,
      "text": "вот он весь"
    },
    {
      "time": 106.85,
      "end": 107.51,
      "text": "мой стайл"
    },
    {
      "time": 107.51,
      "end": 109.25,
      "text": "Девочка, я хаслю,"
    },
    {
      "time": 109.59,
      "end": 110.89,
      "text": "акула в океане"
    },
    {
      "time": 110.89,
      "end": 112.73,
      "text": "Сука, нужен налик,"
    },
    {
      "time": 113.13,
      "end": 114.37,
      "text": "супер быстрый налик,"
    },
    {
      "time": 114.41,
      "end": 116.23,
      "text": "забираем быстрый налик"
    },
    {
      "time": 116.23,
      "end": 118.29,
      "text": "Нахуй конкурентов, мы"
    },
    {
      "time": 118.29,
      "end": 119.59,
      "text": "делаем здесь деньги"
    },
    {
      "time": 119.59,
      "end": 121.31,
      "text": "Нахуй все проценты,"
    },
    {
      "time": 121.63,
      "end": 123.01,
      "text": "кредиты и ипотеки"
    },
    {
      "time": 123.01,
      "end": 124.59,
      "text": "Просто делай дело,"
    },
    {
      "time": 125.01,
      "end": 126.47,
      "text": "просто живи делом"
    },
    {
      "time": 126.47,
      "end": 128.05,
      "text": "Просто качай, суку,"
    },
    {
      "time": 128.43,
      "end": 129.37,
      "text": "я не банчу"
    },
    {
      "time": 129.37,
      "end": 129.99,
      "text": "мефом"
    },
    {
      "time": 144.8,
      "end": 146.42,
      "text": "приезжайте суки дали"
    },
    {
      "time": 146.42,
      "end": 148.42,
      "text": "немножко дайте мне"
    },
    {
      "time": 148.42,
      "end": 151.52,
      "text": "да ну нахуй"
    },
    {
