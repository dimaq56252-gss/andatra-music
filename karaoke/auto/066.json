      "end": 81.01,
      "text": "ко мне летит"
    },
    {
      "time": 81.01,
      "end": 81.69,
      "text": "тут числов"
    },
    {
      "time": 81.69,
      "end": 83.01,
      "text": "Позвать хотели к"
