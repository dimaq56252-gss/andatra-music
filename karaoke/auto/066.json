    {
      "time": 14.23,
      "end": 16.07,
      "text": "Погода просто бомбит"
    },
    {
      "time": 16.07,
      "end": 17.23,
      "text": "и пусть сентябрь"
    },
    {
      "time": 17.23,
      "end": 17.81,
      "text": "горит"
    },
    {
      "time": 17.81,
      "end": 19.57,
      "text": "И, наверное, немного"
    },
    {
      "time": 19.57,
      "end": 20.59,
      "text": "нам о любви"
    },
    {
      "time": 20.59,
      "end": 21.25,
      "text": "говорит"
    },
    {
      "time": 21.25,
      "end": 22.05,
      "text": "Ну а мы"
    },
    {
      "time": 22.05,
      "end": 23.33,
      "text": "чувствуем вайп и"
    },
    {
      "time": 23.33,
      "end": 24.91,
      "text": "просто чувствуем ритм"
    },
    {
      "time": 24.91,
      "end": 26.45,
      "text": "Просто качаем под"
    },
    {
      "time": 26.45,
      "end": 27.63,
      "text": "бит, пока никто"
    },
    {
      "time": 27.63,
      "end": 28.43,
      "text": "не убит"
    },
    {
      "time": 28.43,
      "end": 29.59,
      "text": "С ума сошел"
    },
    {
      "time": 29.59,
      "end": 30.21,
      "text": "у нас мир,"
    },
    {
      "time": 30.49,
      "end": 31.21,
      "text": "не важно, кто"
    },
    {
      "time": 31.21,
      "end": 31.97,
      "text": "тут камир"
    },
    {
      "time": 31.97,
      "end": 33.89,
      "text": "Все шизанутся, готовы"
    },
    {
      "time": 33.89,
      "end": 35.47,
      "text": "такой сегодня эфир"
    },
    {
      "time": 35.47,
      "end": 36.79,
      "text": "А я обычный"
    },
    {
      "time": 36.79,
      "end": 38.39,
      "text": "пацан, просто стою"
    },
    {
      "time": 38.39,
      "end": 39.05,
      "text": "и курю"
    },
    {
      "time": 39.05,
      "end": 40.93,
      "text": "И банальные вещи"
    },
    {
      "time": 40.93,
      "end": 42.53,
      "text": "вам сейчас говорю"
    },
    {
      "time": 42.53,
      "end": 43.67,
      "text": "В топе другие"
    },
    {
      "time": 43.67,
      "end": 44.99,
      "text": "миры, а я"
    },
    {
      "time": 44.99,
      "end": 46.05,
      "text": "тащусь от игры"
    },
    {
      "time": 46.05,
      "end": 48.05,
      "text": "Немного перевел тему,"
    },
    {
      "time": 48.17,
      "end": 49.23,
      "text": "и я почистнее"
    },
    {
      "time": 49.23,
      "end": 49.57,
      "text": "игры"
    },
    {
      "time": 49.57,
      "end": 51.69,
      "text": "Разгоны или идиллия,"
    },
    {
      "time": 51.79,
      "end": 53.43,
      "text": "коварство или бессилие"
    },
    {
      "time": 53.43,
      "end": 54.61,
      "text": "Короче, мысли в"
    },
    {
      "time": 54.61,
      "end": 56.05,
      "text": "башке чуток меня"
    },
    {
      "time": 56.05,
      "end": 56.91,
      "text": "подписили"
    },
    {
      "time": 56.91,
      "end": 58.07,
      "text": "Настолько тут все"
    },
    {
      "time": 58.07,
      "end": 59.33,
      "text": "печально или в"
    },
    {
      "time": 59.33,
      "end": 60.51,
      "text": "душе накопилось"
    },
    {
      "time": 60.51,
      "end": 61.63,
      "text": "Оно все жестко"
    },
    {
      "time": 61.63,
      "end": 63.13,
      "text": "кошмарит, лучше вообще"
    },
    {
      "time": 63.13,
      "end": 63.99,
      "text": "ей не снилось"
    },
    {
      "time": 63.99,
      "end": 65.77,
      "text": "Когда стараемся быть"
    },
    {
      "time": 65.77,
      "end": 67.53,
      "text": "поумнее жизы"
    },
    {
      "time": 67.53,
      "end": 69.31,
      "text": "Она сделает так,"
    },
    {
      "time": 69.49,
      "end": 70.49,
      "text": "что будет хуже"
    },
    {
      "time": 70.49,
      "end": 71.05,
      "text": "в разы"
    },
    {
      "time": 71.05,
      "end": 72.25,
      "text": "Меня все это"
    },
    {
      "time": 72.25,
      "end": 73.57,
      "text": "взрывает, и я"
    },
    {
      "time": 73.57,
      "end": 74.77,
      "text": "пытаюсь поспать"
    },
    {
      "time": 74.77,
      "end": 76.05,
      "text": "Но мой внутренний"
    },
    {
      "time": 76.05,
      "end": 77.63,
      "text": "голос говорит не"
    },
    {
      "time": 77.63,
      "end": 78.21,
      "text": "мешать"
    },
    {
      "time": 78.21,
      "end": 79.89,
      "text": "Из параллельных миров"
