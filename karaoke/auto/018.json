    },
    {
      "time": 31.82,
      "end": 33.02,
      "text": "хапаю на утро"
    },
    {
      "time": 33.02,
      "end": 34.68,
      "text": "Тебя ебали вчера,"
    },
    {
      "time": 34.94,
      "end": 36.28,
      "text": "это Камасутра"
    },
    {
      "time": 36.28,
      "end": 38.14,
      "text": "Пытался рассмотреть мое"
    },
    {
      "time": 38.14,
      "end": 39.62,
      "text": "нутро, это трудно"
    },
    {
      "time": 42.59,
      "end": 44.55,
      "text": "С нами застелить,"
    },
    {
      "time": 44.73,
      "end": 46.27,
      "text": "очень трудно, братчик"
    },
    {
      "time": 46.27,
      "end": 47.37,
      "text": "В Коловне есть"
    },
    {
      "time": 47.37,
      "end": 49.03,
      "text": "быдло, я записался"
    },
    {
      "time": 49.03,
      "end": 49.69,
      "text": "тут с двумя"
    },
    {
      "time": 49.69,
      "end": 50.31,
      "text": "бандатами"
    },
    {
      "time": 50.31,
      "end": 51.37,
      "text": "И девчата, и"
    },
    {
      "time": 51.37,
      "end": 53.15,
      "text": "ребята, залетаем на"
    },
    {
      "time": 53.15,
      "end": 53.49,
      "text": "зарю"
    },
    {
      "time": 53.49,
      "end": 55.21,
      "text": "Я пиздец пустой,"
    },
    {
      "time": 55.49,
      "end": 56.59,
      "text": "тебя браток не"
    },
    {
      "time": 56.59,
      "end": 57.15,
      "text": "накурил"
    },
    {
      "time": 57.15,
      "end": 58.31,
      "text": "Мы с девчатами"
    },
    {
      "time": 58.31,
      "end": 59.39,
      "text": "шампусик взяли"
    },
    {
      "time": 59.39,
      "end": 60.45,
      "text": "Ты для меня"
    },
    {
      "time": 60.45,
      "end": 61.73,
      "text": "малышка, ты для"
    },
    {
      "time": 61.73,
      "end": 62.85,
      "text": "меня как зяблик"
    },
    {
      "time": 62.85,
      "end": 65.75,
      "text": "Нихуёво отнесаем, обменялись"
    },
    {
      "time": 65.75,
      "end": 66.43,
      "text": "адресами"
    },
    {
      "time": 66.43,
      "end": 68.37,
      "text": "Рассказали анекдотов, и"
    },
    {
      "time": 68.37,
      "end": 69.35,
      "text": "чё как, сами"
    },
    {
      "time": 69.35,
      "end": 70.81,
      "text": "На диете, на"
    },
    {
      "time": 70.81,
      "end": 72.73,
      "text": "салатах, как инстасанка"
    },
    {
      "time": 72.73,
      "end": 73.75,
      "text": "В Москву на"
    },
    {
      "time": 73.75,
      "end": 74.79,
      "text": "элке от Галки"
    },
    {
      "time": 74.79,
      "end": 76.21,
      "text": "Детка, ты одна"
    },
    {
      "time": 76.21,
      "end": 77.95,
      "text": "дома, как Макалей"
    },
    {
      "time": 77.95,
      "end": 78.59,
      "text": "Калкин"
    },
    {
      "time": 78.59,
      "end": 80.55,
      "text": "Мы любим женщин"
    },
    {
      "time": 80.55,
      "end": 81.53,
      "text": "с деньгами, как"
    },
    {
      "time": 81.53,
      "end": 82.77,
      "text": "имнагент Галкин"
    },
    {
      "time": 82.77,
      "end": 83.85,
      "text": "Я не видел"
    },
    {
      "time": 83.85,
      "end": 85.53,
      "text": "никогда птенцов у"
    },
    {
      "time": 85.53,
      "end": 85.93,
      "text": "Галки"
    },
    {
      "time": 85.93,
      "end": 87.35,
      "text": "Я хуярил на"
    },
    {
      "time": 87.35,
      "end": 88.89,
      "text": "заводе, кручу тут"
    },
    {
      "time": 88.89,
      "end": 89.35,
      "text": "гайки"
    },
    {
      "time": 89.35,
      "end": 90.93,
      "text": "У буржуя стейк,"
    },
    {
      "time": 91.29,
      "end": 92.39,
      "text": "а работягам сух"
    },
    {
      "time": 92.39,
      "end": 92.77,
      "text": "пахи"
    },
    {
      "time": 92.77,
      "end": 94.37,
      "text": "Кремлевский рубль бережет,"
    },
    {
      "time": 94.53,
      "end": 95.45,
      "text": "звукар мне голос"
    },
    {
      "time": 95.45,
      "end": 96.73,
      "text": "Пережал, а Саня"
    },
    {
      "time": 96.73,
      "end": 97.93,
      "text": "колос, бережа бы"
    },
    {
      "time": 97.93,
      "end": 98.75,
      "text": "у тебя нет"
    },
    {
      "time": 98.75,
      "end": 99.21,
      "text": "шеи"
    },
    {
      "time": 99.21,
      "end": 100.43,
      "text": "У меня нет"
    },
    {
      "time": 100.43,
      "end": 101.85,
      "text": "жабы, хуярю рэп"
    },
    {
      "time": 101.85,
      "end": 102.47,
      "text": "свой дальше"
    },
    {
      "time": 102.47,
      "end": 103.73,
      "text": "Мне хуйни, вам"
    },
    {
      "time": 103.73,
      "end": 104.93,
      "text": "не жалко, учелке"
    },
    {
      "time": 104.93,
      "end": 105.87,
      "text": "в попе жалко"
    },
    {
      "time": 105.87,
      "end": 108.52,
      "text": "Е -е -е"
    },
    {
      "time": 108.52,
      "end": 109.58,
      "text": "-е -е"
    },
    {
      "time": 111.92,
      "end": 113.1,
      "text": "Потратил все ж"
    },
    {
      "time": 113.1,
      "end": 114.46,
      "text": "на трапе, уложил"
    },
    {
      "time": 114.46,
      "end": 115.34,
      "text": "ее в лопатки"
    },
    {
      "time": 115.34,
      "end": 115.9,
      "text": "Да у меня"
    },
    {
      "time": 115.9,
      "end": 117.46,
      "text": "дурные палатки, два"
    },
    {
      "time": 117.46,
      "end": 118.22,
      "text": "бара и шесть"
    },
    {
      "time": 118.22,
      "end": 118.76,
      "text": "папов"
    },
    {
      "time": 118.76,
      "end": 120.3,
      "text": "Новый мой порядок,"
    },
    {
      "time": 120.74,
      "end": 122.02,
      "text": "поднимаю десятки"
    },
    {
      "time": 122.02,
      "end": 123.1,
      "text": "Мои яйца требуют"
    },
    {
      "time": 123.1,
      "end": 124.36,
      "text": "розетки, я оставляю"
    },
    {
      "time": 124.36,
      "end": 125.26,
      "text": "в эту ступу"
    },
    {
      "time": 125.26,
      "end": 126.74,
      "text": "Это наука, побеждать"
    },
    {
      "time": 126.74,
      "end": 128.0,
      "text": "твоей подругам, моя"
    },
    {
      "time": 128.0,
      "end": 128.5,
      "text": "шлюха"
    },
    {
      "time": 128.5,
      "end": 129.78,
      "text": "Я построил плитки"
    },
    {
      "time": 129.78,
      "end": 130.56,
      "text": "в ряд, моя"
    },
    {
      "time": 130.56,
      "end": 131.84,
      "text": "жизнь будто порнуха"
    },
    {
      "time": 131.84,
      "end": 133.38,
      "text": "Фрэнква делает дерьмо,"
    },
    {
      "time": 133.54,
      "end": 134.46,
      "text": "но не делает"
    },
    {
      "time": 134.46,
      "end": 136.02,
      "text": "дерьмо, я поджигаю"
    },
    {
      "time": 136.02,
      "end": 136.94,
      "text": "толстый джой и"
    },
    {
      "time": 136.94,
      "end": 138.58,
      "text": "выдуваю лицо лохом,"
    },
    {
      "time": 138.7,
      "end": 139.16,
      "text": "ааааа"
    },
    {
      "time": 140.65,
      "end": 141.73,
      "text": "Говоришь, что самый"
    },
    {
      "time": 141.73,
      "end": 144.73,
      "text": "умный? Вот ебучий"
    },
    {
      "time": 144.73,
      "end": 144.99,
      "text": "случай"
    },
    {
      "time": 145.95,
      "end": 148.44,
      "text": "Всё исплом, шаришь?"
    },
    {
      "time": 149.81,
      "end": 151.51,
      "text": "Это голос с"
    },
    {
      "time": 151.51,
      "end": 152.57,
      "text": "улиц, и у"
    },
    {
      "time": 152.57,
      "end": 154.11,
      "text": "меня ксаны, может"
    },
    {
      "time": 154.11,
      "end": 155.11,
      "text": "станет легче"
    },
    {
      "time": 155.11,
      "end": 156.67,
      "text": "Мне нужны деньги,"
    },
    {
      "time": 157.11,
      "end": 158.45,
      "text": "чтобы сделать деньги,"
    },
    {
      "time": 158.53,
      "end": 159.61,
      "text": "даже моя сука"
    },
    {
      "time": 159.61,
      "end": 160.07,
      "text": "на тэпе"
    },
    {
      "time": 160.07,
      "end": 161.03,
      "text": "Я слышал твои"
    },
    {
      "time": 161.03,
      "end": 162.59,
      "text": "куклы, знаешь ли,"
    },
    {
      "time": 162.73,
      "end": 163.63,
      "text": "что бэмби? По"
    },
    {
      "time": 163.63,
      "end": 164.53,
      "text": "какому стадию я"
    },
    {
      "time": 164.53,
      "end": 165.11,
      "text": "не рэпил?"
    },
    {
      "time": 166.24,
      "end": 167.62,
      "text": "Эээ, это Тибиси,"
    },
    {
      "time": 167.72,
      "end": 168.88,
      "text": "Суайк, я ебу,"
    },
    {
      "time": 169.02,
      "end": 169.9,
      "text": "парма, жопу, у"
    },
    {
      "time": 169.9,
      "end": 170.96,
      "text": "меня 140 белых"
    },
    {
      "time": 170.96,
      "end": 171.88,
      "text": "колёс, детка, я"
    },
    {
      "time": 171.88,
      "end": 172.62,
      "text": "имею допинг."
    },
    {
      "time": 175.11,
      "end": 176.15,
      "text": "Лилкаш -аут, как"
    },
    {
      "time": 176.15,
      "end": 177.21,
      "text": "дождь из золотых"
    },
    {
      "time": 177.21,
      "end": 178.21,
      "text": "монет, пока ты"
    },
    {
      "time": 178.21,
      "end": 179.25,
      "text": "толкал свой брикет,"
    },
    {
      "time": 179.33,
      "end": 180.61,
      "text": "нам банкомат испёк"
    },
    {
      "time": 180.61,
      "end": 180.95,
      "text": "атлет."
    },
    {
      "time": 181.21,
      "end": 182.59,
      "text": "Эта история, просвет,"
    },
    {
      "time": 182.71,
      "end": 183.87,
      "text": "ценю сегодня свой"
    },
    {
      "time": 183.87,
      "end": 184.65,
      "text": "обед, а у"
    },
    {
      "time": 184.65,
      "end": 185.57,
      "text": "тебя от слова"
    },
    {
      "time": 185.57,
      "end": 186.41,
      "text": "меф, по телу"
    },
    {
      "time": 186.41,
      "end": 187.35,
      "text": "только дрожь и"
    },
    {
      "time": 187.35,
      "end": 187.61,
      "text": "блеф."
    },
    {
      "time": 191.41,
      "end": 193.09,
      "text": "Флоу катаны, раздербаню"
    },
    {
      "time": 193.09,
      "end": 194.35,
      "text": "ублюдков на блюда"
    },
    {
      "time": 194.35,
      "end": 195.89,
      "text": "Хлопну тебя, мудак,"
    },
    {
      "time": 195.91,
      "end": 196.87,
      "text": "и ты закусишь"
    },
    {
      "time": 196.87,
      "end": 197.71,
      "text": "моей пяткой"
    },
    {
      "time": 197.71,
      "end": 198.75,
      "text": "Пока ты был"
    },
    {
      "time": 198.75,
      "end": 199.55,
      "text": "заляп, и я"
    },
    {
      "time": 199.55,
      "end": 200.49,
      "text": "играю в игры"
    },
    {
      "time": 200.49,
      "end": 201.07,
      "text": "с властью"
    },
    {
      "time": 201.07,
      "end": 202.21,
      "text": "Меня больше не"
    },
    {
      "time": 202.21,
      "end": 203.49,
      "text": "парит мнение тех"
    },
    {
      "time": 203.49,
      "end": 204.33,
      "text": "неимущих"
    },
    {
      "time": 204.33,
      "end": 205.21,
      "text": "Я иду к"
    },
    {
      "time": 205.21,
      "end": 206.59,
      "text": "цели, признавая лишь"
    },
    {
      "time": 206.59,
      "end": 207.17,
      "text": "то, что я"
    },
    {
      "time": 207.17,
      "end": 207.65,
      "text": "лучший"
    },
    {
      "time": 207.65,
      "end": 209.25,
      "text": "Моя матушка чует"
    },
    {
      "time": 209.25,
      "end": 210.87,
      "text": "Иоанна самой утробе"
    },
    {
      "time": 210.87,
      "end": 212.13,
      "text": "Я пустил корни"
    },
    {
      "time": 212.13,
      "end": 213.85,
      "text": "оттуда, куда зароют"
    },
    {
      "time": 213.85,
      "end": 214.45,
      "text": "твой гробик"
    },
    {
      "time": 214.45,
      "end": 215.67,
      "text": "Мой предрассудок все"
    },
    {
      "time": 215.67,
      "end": 216.67,
      "text": "определил"
    },
    {
      "time": 216.67,
      "end": 218.09,
      "text": "Я их строфил,"
    },
    {
      "time": 218.15,
      "end": 219.13,
      "text": "взял, дарил эти"
    },
    {
      "time": 219.13,
      "end": 220.47,
      "text": "куплеты, я скилл"
    },
    {
      "time": 220.47,
      "end": 221.65,
      "text": "Как быть иначе,"
    },
    {
      "time": 221.67,
      "end": 222.75,
      "text": "если не скрывать"
    },
    {
      "time": 222.75,
      "end": 223.77,
      "text": "свой анархизм"
    },
    {
      "time": 223.77,
      "end": 225.33,
      "text": "Не пропаганда, просто"
    },
    {
      "time": 225.33,
      "end": 226.99,
      "text": "провокация, обстись"
    },
    {
      "time": 226.99,
      "end": 228.41,
      "text": "Я натянут тебя"
    },
    {
      "time": 228.41,
      "end": 229.39,
      "text": "на жало, как"
    },
    {
      "time": 229.39,
      "end": 230.25,
      "text": "будто гандон"
    },
    {
      "time": 230.25,
      "end": 231.83,
      "text": "Не надо затирать"
    },
    {
      "time": 231.83,
      "end": 232.59,
      "text": "мне тут, какой"
    },
    {
      "time": 232.59,
      "end": 233.61,
      "text": "ты утробом"
    },
    {
      "time": 233.61,
      "end": 235.63,
      "text": "Знак Скорпион, Рил"
    },
    {
      "time": 235.63,
      "end": 237.17,
      "text": "Ван, чёрт, выкуси"
    },
    {
      "time": 237.17,
      "end": 238.21,
      "text": "На фоне дикой"
    },
    {
      "time": 238.21,
      "end": 240.15,
      "text": "примеси, пора легалиси"
    },
    {
      "time": 240.15,
      "end": 241.35,
      "text": "Ты встреча, ты"
    },
    {
      "time": 241.35,
      "end": 242.57,
      "text": "тотчас, конечно, в"
    },
    {
      "time": 242.57,
      "end": 243.55,
      "text": "асфальт ртом"
    },
    {
      "time": 243.55,
      "end": 244.59,
      "text": "Тогда ты не"
    },
    {
      "time": 244.59,
      "end": 245.73,
      "text": "задумался, что с"
    },
    {
      "time": 245.73,
      "end": 247.05,
      "text": "тобой станет потом"
    },
    {
      "time": 247.05,
      "end": 248.83,
      "text": "Я добивался звучания"
    },
    {
      "time": 248.83,
      "end": 250.15,
      "text": "крови и потом"
    },
    {
      "time": 250.15,
      "end": 251.03,
      "text": "Так что узнай,"
    },
    {
      "time": 251.13,
      "end": 252.33,
      "text": "сука, этот паттерн"
    },
    {
      "time": 252.33,
      "end": 253.11,
      "text": "есть мой прайм"
    },
    {
      "time": 253.11,
      "end": 253.53,
      "text": "-тайм"
    },
    {
      "time": 254.64,
      "end": 255.66,
      "text": "У суки был"
    },
    {
      "time": 255.66,
      "end": 256.36,
      "text": "парень, она ведь"
    },
    {
      "time": 256.36,
      "end": 256.9,
      "text": "с Плазкой, но"
    },
    {
      "time": 256.9,
      "end": 257.7,
      "text": "где её ставить?"
    },
    {
      "time": 258.04,
      "end": 259.22,
      "text": "Она даёт горло,"
    },
    {
      "time": 259.36,
      "end": 260.1,
      "text": "потом даёт жопу,"
    },
    {
      "time": 260.12,
      "end": 260.94,
      "text": "я делаю фото"
    },
    {
      "time": 261.58,
      "end": 262.94,
      "text": "Хочешь наверх, сделай"
    },
    {
      "time": 262.94,
      "end": 263.66,
      "text": "всё сам, лип"
    },
    {
      "time": 263.66,
      "end": 264.54,
      "text": "не поможет, нет"
    },
    {
      "time": 264.54,
      "end": 265.96,
      "text": "Вернулся на чистую"
    },
    {
      "time": 265.96,
      "end": 267.02,
      "text": "линию, в руке"
    },
