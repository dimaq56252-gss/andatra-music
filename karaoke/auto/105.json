    },
    {
      "time": 192.72,
      "end": 193.78,
      "text": "топят, нужен трек"
    },
    {
      "time": 193.78,
      "end": 195.12,
      "text": "Я лечу, вопросов"
    },
    {
      "time": 195.12,
      "end": 195.8,
      "text": "нет, А в"
    },
    {
      "time": 195.8,
      "end": 196.66,
