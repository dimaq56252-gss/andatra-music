    },
    {
      "time": 200.62,
      "end": 201.84,
      "text": "Мучу этот стэк,"
    },
    {
      "time": 201.92,
      "end": 203.04,
      "text": "она хочет лэк,"
    },
    {
      "time": 203.16,
      "end": 204.2,
      "text": "Майби комик делает"
    },
    {
      "time": 204.2,
      "end": 204.6,
      "text": "свэк"
    },
    {
      "time": 204.6,
      "end": 206.22,
      "text": "Какой нахуй интеллект?"
    },
    {
      "time": 206.3,
      "end": 207.36,
