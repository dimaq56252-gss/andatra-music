    },
    {
      "time": 118.14,
      "end": 119.3,
      "text": "даже костей, блять"
    },
    {
      "time": 119.3,
      "end": 120.36,
      "text": "Тут уже надо"
    },
    {
      "time": 120.36,
      "end": 121.52,
      "text": "было навалить рэпа,"
    },
    {
      "time": 121.66,
      "end": 122.26,
      "text": "а я навалил"
    },
    {
      "time": 122.26,
      "end": 122.64,
