    },
    {
      "time": 207.36,
      "end": 207.84,
      "text": "на рэк"
    },
    {
      "time": 207.84,
      "end": 209.36,
      "text": "Алмайе качает трек"
    },
    {
      "time": 209.36,
      "end": 210.74,
      "text": "Посадил типов на"
    },
    {
      "time": 210.74,
      "end": 210.94,
      "text": "бег"
    },
    {
      "time": 210.94,
      "end": 211.9,
      "text": "Он импакт и"
    },
    {
      "time": 211.9,
      "end": 212.44,
      "text": "на стрите"
    },
    {
      "time": 212.44,
      "end": 213.52,
      "text": "Не хочу жить"
    },
    {
      "time": 213.52,
      "end": 214.06,
      "text": "в нищете"
    },
    {
      "time": 214.06,
      "end": 215.32,
      "text": "Меня ломит во"
