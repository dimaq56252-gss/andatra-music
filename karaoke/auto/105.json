    },
    {
      "time": 217.2,
      "end": 218.22,
      "text": "Я как будто"
    },
    {
      "time": 218.22,
      "end": 218.94,
      "text": "в бороздье"
    },
    {
      "time": 218.94,
      "end": 220.0,
      "text": "Твоя жизнь, она"
    },
