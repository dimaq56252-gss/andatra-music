    },
    {
      "time": 175.88,
      "end": 177.14,
      "text": "Твоя каста мягкий,"
    },
    {
      "time": 177.34,
      "end": 177.74,
      "text": "как паст"
    },
    {
      "time": 177.74,
      "end": 178.42,
      "text": "А в моей"
    },
    {
      "time": 178.42,
      "end": 179.92,
