    },
    {
      "time": 222.12,
      "end": 223.82,
      "text": "Сука хочет, алмайе"
    },
    {
      "time": 223.82,
      "end": 225.02,
      "text": "Я не понура,"
    },
    {
      "time": 225.12,
      "end": 225.56,
