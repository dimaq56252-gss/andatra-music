    },
    {
      "time": 179.92,
      "end": 180.72,
      "text": "тайп опасный"
    },
    {
      "time": 180.72,
      "end": 181.92,
      "text": "Саламратья лес на"
    },
    {
      "time": 181.92,
      "end": 183.06,
