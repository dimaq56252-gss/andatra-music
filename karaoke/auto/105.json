    },
    {
      "time": 157.18,
      "end": 158.56,
      "text": "Прямо в глаза,"
    },
    {
      "time": 158.96,
      "end": 159.22,
      "text": "сука"
    },
    {
      "time": 159.22,
      "end": 160.28,
      "text": "I am alone,"
    },
    {
      "time": 160.58,
      "end": 161.32,
      "text": "на мне вилон,"
    },
    {
      "time": 161.42,
      "end": 162.06,
      "text": "салют, весь и"
    },
    {
      "time": 162.06,
      "end": 162.54,
      "text": "пардон"
    },
    {
      "time": 162.54,
      "end": 163.34,
      "text": "Я буду класть"
    },
    {
      "time": 163.34,
      "end": 164.58,
      "text": "сердце, жирный болт,"
    },
    {
      "time": 164.6,
      "end": 165.76,
      "text": "пыщающий сироп"
    },
    {
      "time": 165.76,
      "end": 166.62,
      "text": "I am alone,"
    },
    {
      "time": 166.94,
      "end": 168.16,
      "text": "параллельно шмот, милон,"
    },
    {
      "time": 168.28,
      "end": 168.86,
