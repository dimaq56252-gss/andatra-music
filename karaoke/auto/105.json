    },
    {
      "time": 230.46,
      "end": 231.7,
      "text": "Сделай мне икру"
    },
    {
      "time": 231.7,
      "end": 232.3,
      "text": "погромче"
    },
    {
      "time": 232.3,
      "end": 233.86,
      "text": "Ты понимаешь"
    },
    {
      "time": 233.86,
      "end": 234.52,
      "text": "что что я"
    },
    {
      "time": 234.52,
      "end": 236.16,
      "text": "намного типа толщиной"
    },
    {
      "time": 236.16,
      "end": 238.64,
      "text": "толще заборы нам"
    },
    {
      "time": 238.64,
      "end": 240.28,
      "text": "вообще не мешает"
    },
    {
      "time": 240.28,
      "end": 241.26,
      "text": "это снова и"
    },
    {
      "time": 241.26,
      "end": 243.12,
      "text": "снова мой лайфстайл"
    },
    {
      "time": 243.12,
      "end": 244.48,
      "text": "то что говорю"
    },
    {
      "time": 244.48,
      "end": 247.2,
      "text": "не забудешь серия"
    },
    {
      "time": 247.2,
      "end": 248.56,
      "text": "андатри здесь мы"
    },
    {
      "time": 248.56,
      "end": 249.8,
      "text": "не можем снова"
    },
    {
      "time": 249.8,
      "end": 250.68,
      "text": "выйти в люди"
    },
    {
      "time": 250.68,
      "end": 252.08,
      "text": "потому что четыре"
    },
    {
      "time": 252.08,
      "end": 253.44,
      "text": "стены возле нас"
    },
    {
      "time": 253.44,
      "end": 255.08,
      "text": "только прикрывают от"
    },
    {
      "time": 255.08,
      "end": 256.32,
      "text": "этой луны до"
    },
    {
      "time": 256.32,
      "end": 257.72,
      "text": "потолка нет и"
    },
    {
      "time": 257.72,
      "end": 259.12,
      "text": "его никогда не"
    },
    {
      "time": 259.12,
      "end": 260.24,
      "text": "будет потому что"
    },
    {
      "time": 260.24,
      "end": 260.48,
      "text": "я"
    },
    {
      "time": 260.48,
      "end": 262.08,
      "text": "Снова стою в"
    },
    {
      "time": 262.08,
      "end": 263.08,
      "text": "оверсайз худи"
    },
    {
      "time": 263.08,
      "end": 264.18,
      "text": "Эй, я"
    },
    {
      "time": 264.18,
      "end": 265.72,
      "text": "Может быть худой,"
    },
    {
      "time": 265.86,
      "end": 266.5,
      "text": "посмотри"
    },
    {
      "time": 266.5,
      "end": 267.5,
      "text": "На моих близких"
    },
    {
      "time": 267.5,
      "end": 268.56,
      "text": "каждый из них"
    },
    {
      "time": 268.56,
      "end": 270.62,
      "text": "И никак снова"
    },
    {
      "time": 270.62,
      "end": 271.46,
      "text": "Тут не будет"
