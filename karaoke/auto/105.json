    },
    {
      "time": 225.56,
      "end": 227.04,
      "text": "Эй, эй, эй"
    },
    {
      "time": 227.04,
      "end": 228.44,
      "text": "Я снова могу"
    },
    {
      "time": 228.44,
      "end": 230.06,
      "text": "Зачитать здесь для"
    },
    {
      "time": 230.06,
      "end": 230.46,
