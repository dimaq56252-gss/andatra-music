      "time": 95.85,
      "end": 96.27,
      "text": "стропон"
    },
    {
      "time": 96.27,
      "end": 97.91,
      "text": "Когда читает мужчина,"
    },
    {
      "time": 98.23,
      "end": 99.11,
      "text": "вы сосете под"
    },
    {
      "time": 99.11,
      "end": 99.53,
      "text": "столом"
    },
    {
      "time": 99.53,
      "end": 101.17,
      "text": "Ты вырастал пидорасом,"
    },
    {
      "time": 101.37,
      "end": 102.75,
      "text": "я остался пацаном"
    },
    {
      "time": 102.75,
      "end": 104.19,
      "text": "Кот свою ебальник,"
    },
    {
      "time": 104.55,
      "end": 105.49,
      "text": "в автозаке не"
    },
    {
      "time": 105.49,
      "end": 106.05,
      "text": "поеду"
    },
    {
      "time": 106.05,
      "end": 108.15,
      "text": "Гражданин начальник, девочка"
    },
    {
      "time": 108.15,
      "end": 108.85,
      "text": "не шлюха"
    },
    {
      "time": 108.85,
      "end": 110.09,
      "text": "Поэтому фото в"
    },
    {
      "time": 110.09,
      "end": 111.67,
      "text": "купальнике, ты ебаный"
    },
    {
      "time": 111.67,
      "end": 112.05,
      "text": "пидор"
    },
    {
      "time": 112.05,
      "end": 113.95,
      "text": "Великий умывальник, мы"
    },
    {
      "time": 113.95,
      "end": 115.19,
      "text": "сплетим очень ярко"
    },
    {
      "time": 115.19,
      "end": 116.25,
      "text": "Как с Китая"
    },
    {
      "time": 116.25,
      "end": 117.73,
      "text": "фонарик, на мою"
    },
    {
      "time": 117.73,
      "end": 118.49,
      "text": "залопу"
    },
    {
      "time": 118.49,
      "end": 120.45,
      "text": "Прилетел комарик, я"
    },
    {
      "time": 120.45,
      "end": 121.69,
      "text": "тебя не узнаю"
    },
    {
      "time": 121.69,
      "end": 123.49,
      "text": "Рэпер обладает, хотел"
    },
    {
      "time": 123.49,
      "end": 124.25,
      "text": "стать героем для"
    },
    {
      "time": 124.25,
      "end": 124.69,
      "text": "мамы"
    },
    {
      "time": 124.69,
      "end": 125.79,
      "text": "Но стал ебаным"
    },
    {
      "time": 125.79,
      "end": 126.27,
      "text": "фраером"
    },
    {
      "time": 126.27,
      "end": 127.65,
      "text": "Мы раздаем пизды,"
    },
    {
      "time": 127.83,
      "end": 128.95,
      "text": "как пиздюки, блять,"
    },
    {
      "time": 129.01,
      "end": 129.41,
      "text": "флайеры"
    },
    {
      "time": 129.41,
      "end": 130.85,
      "text": "Ваш лейбл это"
    },
    {
      "time": 130.85,
      "end": 132.17,
      "text": "катер, наш лейбл"
    },
    {
      "time": 132.17,
      "end": 132.97,
      "text": "это лайнер"
    },
    {
      "time": 132.97,
      "end": 133.55,
      "text": "Шел в аван"
    },
    {
      "time": 133.55,
      "end": 134.71,
      "text": "работать, в аван"
    },
    {
      "time": 134.71,
      "end": 135.69,
      "text": "теперь ты таймер"
    },
    {
      "time": 135.69,
      "end": 136.65,
      "text": "Меряю в ряд"
    },
    {
      "time": 136.65,
      "end": 137.99,
      "text": "как дайвер, меняю"
    },
    {
      "time": 137.99,
      "end": 139.03,
      "text": "девку как драйвер"
    },
    {
      "time": 139.03,
      "end": 140.79,
      "text": "Раньше качался на"
    },
    {
      "time": 140.79,
      "end": 142.23,
      "text": "фарме, теперь тружусь"
    },
    {
      "time": 142.23,
      "end": 142.75,
      "text": "на фирме"
    },
    {
      "time": 142.75,
      "end": 144.15,
      "text": "Колумб на партизан"
    },
    {
      "time": 144.15,
      "end": 146.77,
      "text": "54А, конторы, фирма"
    },
    {
      "time": 146.77,
      "end": 148.13,
      "text": "Я убил твоих"
    },
    {
      "time": 148.13,
      "end": 149.63,
      "text": "соседей, зови меня"
    },
    {
      "time": 149.63,
      "end": 150.29,
      "text": "зефира"
    },
    {
      "time": 150.29,
      "end": 152.37,
      "text": "Моя малышка какает"
    },
    {
      "time": 152.37,
      "end": 153.57,
      "text": "только зефиром"
    },
    {
      "time": 153.57,
      "end": 155.07,
      "text": "Не заебись от"
    },
    {
      "time": 155.07,
      "end": 156.41,
      "text": "пива, хуево от"
    },
    {
      "time": 156.41,
      "end": 156.99,
      "text": "кефира"
    },
    {
      "time": 156.99,
      "end": 158.93,
      "text": "За людское воровское"
    },
    {
      "time": 158.93,
      "end": 160.13,
      "text": "наебну чефира"
    },
    {
      "time": 160.13,
      "end": 162.11,
      "text": "Плачу налог на"
    },
    {
      "time": 162.11,
      "end": 163.01,
      "text": "воздух, как в"
    },
    {
      "time": 163.01,
      "end": 164.33,
      "text": "сказке Чиполина"
    },
    {
      "time": 166.65,
      "end": 167.53,
      "text": "Молчать!"
    },
    {
      "time": 170.14,
      "end": 171.26,
      "text": "У меня есть"
    },
    {
      "time": 171.26,
      "end": 173.08,
      "text": "таковед, пара порванных"
    },
    {
      "time": 173.08,
      "end": 173.46,
      "text": "колет"
    },
    {
      "time": 173.46,
      "end": 174.8,
      "text": "Ты карьере будешь"
    },
    {
      "time": 174.8,
      "end": 175.74,
      "text": "дед, вредь дерьми"
    },
    {
      "time": 175.74,
      "end": 176.6,
      "text": "я буду сед"
    },
    {
      "time": 176.6,
      "end": 177.52,
      "text": "Ты щиток, ты"
    },
    {
      "time": 177.52,
      "end": 178.2,
      "text": "мой близец"
    },
    {
      "time": 178.2,
      "end": 179.2,
      "text": "Крыса, бой, тебе"
    },
    {
      "time": 179.2,
      "end": 179.82,
      "text": "пиздец"
    },
    {
      "time": 179.82,
      "end": 180.8,
      "text": "Мой крепок, тебе"
    },
    {
      "time": 180.8,
      "end": 181.4,
      "text": "конец"
    },
    {
      "time": 181.4,
      "end": 182.5,
      "text": "Ты закатка, я"
