      "end": 84.79,
      "text": "делать? Ходить на"
    },
    {
      "time": 84.79,
      "end": 86.57,
      "text": "работу, гулять. Гулять"
    },
    {
      "time": 86.57,
      "end": 87.33,
      "text": "и слушать биты"
    },
    {
      "time": 87.33,
      "end": 88.71,
      "text": "только, блядь. А"
    },
    {
      "time": 88.71,
      "end": 89.23,
      "text": "че еще я"
    },
    {
      "time": 89.23,
      "end": 90.31,
      "text": "буду делать? Да"
    },
    {
      "time": 90.31,
      "end": 91.29,
      "text": "мне, блядь, больше"
    },
    {
      "time": 91.29,
      "end": 92.73,
      "text": "интереса нет никакого."
    },
    {
      "time": 92.73,
      "end": 94.29,
      "text": "Коля любит кока"
    },
    {
      "time": 94.29,
      "end": 94.89,
      "text": "-колу"
    },
    {
      "time": 94.89,
      "end": 96.29,
      "text": "Я ему захватил,"
    },
    {
      "time": 96.39,
      "end": 96.95,
      "text": "а себе пил"
    },
    {
      "time": 96.95,
      "end": 97.43,
      "text": "вайсика"
    },
    {
      "time": 97.43,
      "end": 98.51,
      "text": "Он тоже любит"
    },
    {
      "time": 98.51,
      "end": 99.49,
      "text": "пивайсика иногда"
    },
    {
      "time": 99.49,
      "end": 100.71,
      "text": "Но не курит"
    },
    {
      "time": 100.71,
      "end": 101.21,
      "text": "никогда"
    },
    {
      "time": 101.21,
      "end": 103.15,
      "text": "Этот, этот, блядь,"
    },
    {
      "time": 103.23,
      "end": 104.27,
      "text": "чувак наш братан"
    },
    {
      "time": 104.27,
      "end": 106.29,
      "text": "Я нахуярился, извините,"
    },
    {
      "time": 106.31,
      "end": 107.63,
      "text": "язык заплетается"
    },
    {
      "time": 107.69,
      "end": 109.83,
      "text": "Алмае, скажи, какие"
    },
    {
      "time": 109.83,
      "end": 110.93,
      "text": "зажили -были"
    },
    {
      "time": 110.93,
      "end": 113.71,
      "text": "Я накурился, и"
    },
    {
      "time": 113.71,
      "end": 114.37,
      "text": "глаза как у"
    },
    {
      "time": 114.37,
      "end": 115.21,
      "text": "китайца"
    },
    {
      "time": 115.21,
      "end": 116.51,
      "text": "Вы в Казахстане,"
    },
    {
      "time": 116.55,
      "end": 117.61,
      "text": "как в Алмате"
    },
    {
      "time": 117.61,
      "end": 118.57,
      "text": "У нас очень"
    },
    {
      "time": 118.57,
      "end": 119.87,
      "text": "все грустно"
    },
    {
      "time": 119.87,
      "end": 120.89,
      "text": "Я как Анар"
    },
    {
      "time": 120.89,
      "end": 122.19,
      "text": "Абдулаев, я буду"
    },
    {
      "time": 122.19,
      "end": 123.57,
      "text": "сидеть за капусту"
    },
    {
      "time": 123.57,
      "end": 124.71,
      "text": "Скажу, что мне"
    },
    {
      "time": 124.71,
      "end": 125.73,
      "text": "было очень не"
    },
    {
      "time": 125.73,
      "end": 126.33,
      "text": "грустно"
    },
    {
      "time": 126.33,
      "end": 127.89,
      "text": "Там кормили заебись"
    },
    {
      "time": 127.89,
      "end": 129.71,
      "text": "Коляна, спасибо за"
    },
    {
      "time": 129.71,
      "end": 130.39,
      "text": "этот бит"
    },
    {
      "time": 130.39,
      "end": 131.59,
      "text": "Я хочу сказать"
    },
    {
      "time": 131.59,
      "end": 133.09,
      "text": "на этом треке"
    },
    {
      "time": 133.09,
      "end": 134.53,
      "text": "Я буду стелить"
    },
    {
      "time": 134.53,
      "end": 135.23,
      "text": "так то, что"
    },
    {
      "time": 135.23,
      "end": 136.41,
      "text": "будет этот бит"
    },
    {
      "time": 136.41,
      "end": 137.21,
      "text": "на репите"
    },
    {
      "time": 137.21,
      "end": 138.63,
      "text": "Андрюха и Шурик,"
    },
    {
      "time": 138.89,
      "end": 139.67,
      "text": "мы здесь все"
    },
    {
      "time": 139.67,
      "end": 140.71,
      "text": "читаем"
    },
    {
      "time": 140.71,
      "end": 141.73,
      "text": "И нам папа"
    },
    {
      "time": 141.73,
      "end": 142.25,
      "text": "раздет"
    },
    {
      "time": 142.25,
      "end": 143.69,
      "text": "Твои проблемы нам"
    },
    {
      "time": 143.69,
      "end": 145.09,
      "text": "похуй вообще, бро"
    },
    {
      "time": 145.09,
      "end": 146.53,
      "text": "Знаешь, я буду"
    },
    {
      "time": 146.53,
      "end": 147.79,
      "text": "стелить как автомат"
    },
    {
      "time": 147.79,
      "end": 148.67,
      "text": "Калашникова"
    },
    {
      "time": 148.67,
      "end": 150.57,
      "text": "Буду строчить, а,"
    },
    {
      "time": 150.81,
      "end": 151.95,
      "text": "ты видишь трейсера"
    },
    {
      "time": 153.02,
      "end": 154.38,
      "text": "Твоя жизнь пизда,"
    },
    {
      "time": 154.56,
      "end": 155.64,
      "text": "ты видишь трейсера"
    },
    {
      "time": 155.64,
      "end": 156.94,
      "text": "Твоя жизнь пизда,"
    },
    {
      "time": 157.04,
      "end": 159.75,
      "text": "а, ты видишь"
    },
    {
      "time": 159.75,
      "end": 160.41,
      "text": "трейсера"
    },
    {
      "time": 160.41,
      "end": 161.81,
      "text": "Твоя жизнь пизда,"
    },
    {
      "time": 161.81,
      "end": 162.11,
      "text": "а"
    },
    {
      "time": 165.95,
      "end": 167.91,
      "text": "Этой жизни краски"
    },
    {
      "time": 167.91,
      "end": 169.07,
      "text": "снова готовы размыться"
    },
    {
      "time": 169.07,
      "end": 169.69,
      "text": "В них летают"
    },
    {
      "time": 169.69,
      "end": 171.45,
      "text": "глазами, готовы раствориться"
    },
    {
      "time": 171.45,
      "end": 172.39,
      "text": "Кучу людей и"
    },
    {
      "time": 172.39,
      "end": 172.99,
      "text": "судеб, но ты"
    },
    {
      "time": 172.99,
      "end": 173.81,
      "text": "не обессудь"
    },
    {
      "time": 173.81,
      "end": 175.47,
      "text": "Накрывает мгла, я"
    },
    {
      "time": 175.47,
      "end": 176.37,
      "text": "смотрю эту жуть"
    },
    {
      "time": 176.37,
      "end": 177.25,
      "text": "Когда один все"
    },
    {
      "time": 177.25,
      "end": 178.05,
      "text": "мимо, вокруг все"
    },
    {
      "time": 178.05,
      "end": 178.85,
      "text": "примитивно"
    },
    {
      "time": 178.85,
      "end": 179.41,
      "text": "В моем лице"
    },
    {
      "time": 179.41,
      "end": 181.19,
      "text": "печаль, лишняя мина"
    },
    {
      "time": 181.19,
      "end": 182.99,
      "text": "Живем неперспективно, делаем"
    },
    {
      "time": 182.99,
      "end": 183.29,
      "text": "откровенно"
    },
    {
      "time": 183.29,
      "end": 184.29,
      "text": "Чё -то хочу"
    },
    {
      "time": 184.29,
      "end": 185.59,
      "text": "сказать, уже пришло"
    },
    {
      "time": 185.59,
      "end": 186.07,
      "text": "то время"
    },
    {
      "time": 186.07,
      "end": 186.91,
      "text": "Немного в жизни"
    },
    {
      "time": 186.91,
      "end": 187.81,
      "text": "один, я сам"
    },
    {
      "time": 187.81,
      "end": 188.59,
      "text": "так захотел"
    },
    {
      "time": 188.59,
      "end": 189.33,
      "text": "Мой друг не"
    },
    {
      "time": 189.33,
      "end": 190.47,
      "text": "Аладдин, верю в"
    },
    {
      "time": 190.47,
      "end": 191.03,
      "text": "беспредел"
    },
    {
      "time": 191.03,
      "end": 191.85,
      "text": "Лица не моя"
    },
    {
      "time": 191.85,
      "end": 192.69,
      "text": "печать, когда на"
    },
    {
      "time": 192.69,
      "end": 193.51,
      "text": "сердце печаль"
    },
    {
      "time": 193.51,
      "end": 194.81,
      "text": "Это уже случилось,"
    },
    {
      "time": 194.99,
      "end": 195.95,
      "text": "мне немного жаль"
    },
    {
      "time": 195.95,
      "end": 196.79,
      "text": "Пчёлы в сердце"
    },
    {
      "time": 196.79,
      "end": 197.87,
      "text": "летят, они ужать"
    },
    {
      "time": 197.87,
      "end": 198.35,
      "text": "хотят"
    },
    {
      "time": 198.35,
      "end": 199.61,
      "text": "Просто вновь улетели,"
    },
    {
      "time": 199.75,
      "end": 200.31,
      "text": "как будто чё"
    },
    {
      "time": 200.31,
      "end": 200.89,
      "text": "-то хотели"
    },
    {
      "time": 200.89,
      "end": 202.17,
      "text": "Донести мне моменты,"
    },
    {
      "time": 202.27,
      "end": 202.79,
      "text": "когда я чё"
    },
    {
      "time": 202.79,
      "end": 203.35,
      "text": "-то теряю"
    },
    {
      "time": 203.35,
      "end": 204.61,
      "text": "Тут без комплиментов,"
    },
    {
      "time": 204.69,
      "end": 205.09,
      "text": "в жезу я"
    },
    {
      "time": 205.09,
      "end": 205.79,
      "text": "отпускаю"
    },
    {
      "time": 205.79,
      "end": 207.05,
      "text": "Я почти бросаюсь"
    },
    {
      "time": 207.05,
      "end": 207.77,
      "text": "и в огонь"
    },
    {
      "time": 207.77,
      "end": 208.33,
      "text": "и в воду"
    },
    {
      "time": 208.33,
      "end": 209.49,
      "text": "Этого не стесняюсь,"
    },
    {
      "time": 209.57,
      "end": 210.23,
      "text": "неважно чё за"
    },
    {
      "time": 210.23,
      "end": 210.65,
      "text": "погода"
    },
    {
      "time": 210.65,
      "end": 211.47,
      "text": "В своём кразе"
    },
    {
      "time": 211.47,
      "end": 212.49,
      "text": "движении почти всех"
    },
    {
      "time": 212.49,
      "end": 213.07,
      "text": "потерял"
    },
    {
      "time": 213.07,
      "end": 213.95,
      "text": "Я не мальбра"
    },
    {
      "time": 213.95,
      "end": 214.87,
      "text": "-ковбой, я просто"
    },
    {
      "time": 214.87,
      "end": 215.63,
      "text": "дерзкий вандал"
    },
    {
      "time": 215.63,
      "end": 216.35,
      "text": "Я не знаю"
    },
    {
      "time": 216.35,
      "end": 217.13,
      "text": "меры, и тут"
    },
    {
      "time": 217.13,
      "end": 218.05,
      "text": "нет примеров"
    },
    {
      "time": 218.05,
      "end": 219.31,
      "text": "Берегу свои нервы,"
    },
    {
      "time": 219.33,
      "end": 220.01,
      "text": "но чуть коснусь"
    },
    {
      "time": 220.01,
      "end": 220.65,
      "text": "своей нервы"
    },
    {
      "time": 220.65,
      "end": 221.31,
      "text": "Е -бой!"
    },
    {
      "time": 221.51,
      "end": 230.269388,
      "text": "♪ Приятный подарок"
    }
