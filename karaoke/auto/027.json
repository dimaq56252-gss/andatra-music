      "text": "этот лютый стиль"
    },
    {
      "time": 16.28,
      "end": 18.28,
      "text": "Подвалил 26 -й"
    },
    {
      "time": 18.28,
      "end": 20.3,
      "text": "год, ебаные перепонки"
    },
    {
      "time": 20.3,
      "end": 20.84,
      "text": "лопнули"
    },
    {
      "time": 20.84,
      "end": 21.96,
      "text": "Жди наш альбом,"
    },
    {
      "time": 22.2,
      "end": 23.46,
      "text": "мы его уже"
    },
    {
      "time": 23.46,
      "end": 24.38,
      "text": "дробнули"
    },
    {
      "time": 24.38,
      "end": 26.2,
      "text": "С пацаками встали"
    },
    {
      "time": 26.2,
      "end": 28.1,
      "text": "на районе, поправляли"
    },
    {
      "time": 28.1,
      "end": 28.74,
      "text": "здоровье"
    },
    {
      "time": 28.74,
      "end": 30.16,
      "text": "Миша не уровни"
    },
    {
      "time": 30.16,
      "end": 31.48,
      "text": "крышку"
    },
    {
      "time": 31.48,
      "end": 33.02,
      "text": "Значит все будет"
    },
    {
      "time": 33.02,
      "end": 33.62,
      "text": "поровну"
    },
    {
      "time": 33.62,
      "end": 35.84,
      "text": "3D курнул плюшку"
    },
    {
      "time": 35.84,
      "end": 36.72,
      "text": "Из -за ЦПА"
    },
    {
      "time": 36.72,
      "end": 37.5,
      "text": "базарит"
    },
    {
      "time": 37.5,
      "end": 39.46,
      "text": "Сгоняли в каучи"
    },
    {
      "time": 39.46,
      "end": 40.54,
      "text": "Нам посуп сделал"
    },
    {
      "time": 40.54,
      "end": 41.84,
      "text": "ебаные борщи"
    },
    {
      "time": 41.84,
      "end": 43.68,
      "text": "Жень роняет каждого"
    },
    {
      "time": 43.68,
      "end": 45.6,
      "text": "Ожидаем чего -то"
    },
    {
      "time": 45.6,
      "end": 45.98,
      "text": "там"
    },
    {
      "time": 45.98,
      "end": 46.66,
      "text": "Дважды"
    },
    {
      "time": 46.66,
      "end": 48.26,
      "text": "Скоро придет весна"
    },
    {
      "time": 48.26,
      "end": 50.2,
      "text": "Надеемся на лучшее"
    },
    {
      "time": 50.2,
      "end": 52.06,
      "text": "Прилетели грачи"
    },
    {
      "time": 52.06,
      "end": 53.44,
      "text": "Жизнь станет лучше"
    },
    {
      "time": 53.44,
      "end": 54.9,
      "text": "Да мы бухаем"
    },
    {
      "time": 54.9,
      "end": 55.86,
      "text": "Мы себя, сука,"
    },
    {
      "time": 55.9,
      "end": 56.68,
      "text": "осуждаем"
    },
    {
      "time": 56.68,
      "end": 58.4,
      "text": "Обычные пацаны из"
    },
    {
      "time": 58.4,
      "end": 59.68,
      "text": "уличных дворов"
    },
    {
      "time": 59.71,
      "end": 61.33,
      "text": "Ставим жизнь на"
    },
    {
      "time": 61.33,
      "end": 62.27,
      "text": "плы, а оскорблять"
    },
    {
      "time": 62.27,
      "end": 63.15,
      "text": "нас и смеет"
    },
    {
      "time": 63.15,
      "end": 64.75,
      "text": "Серия андатра стелет"
    },
    {
      "time": 64.75,
      "end": 66.77,
      "text": "Андрюха Князев варит"
    },
    {
      "time": 66.77,
      "end": 67.59,
      "text": "пелемень"
    },
    {
      "time": 68.95,
      "end": 70.19,
      "text": "Мишанец гонял на"
    },
    {
      "time": 70.19,
      "end": 71.27,
      "text": "дачу, закрыл свою"
    },
    {
      "time": 71.27,
      "end": 71.73,
      "text": "дверь"
    },
    {
      "time": 71.73,
      "end": 72.61,
      "text": "Эй, ты, сука,"
    },
    {
      "time": 72.71,
      "end": 73.93,
      "text": "закрой свою дверь"
    },
    {
      "time": 73.93,
      "end": 76.26,
      "text": "Сука, блядь, чё"
    },
    {
      "time": 76.26,
      "end": 77.52,
      "text": "-то там проебал"
    },
    {
      "time": 77.52,
      "end": 78.08,
      "text": "бы какой -то"
    },
    {
      "time": 78.08,
      "end": 79.38,
      "text": "За стол"
    },
    {
      "time": 79.38,
      "end": 82.22,
      "text": "Где -то кого"
    },
    {
      "time": 82.22,
      "end": 83.56,
      "text": "-то забыли, кого"
    },
    {
      "time": 83.56,
      "end": 84.8,
      "text": "-то выебали, брод"
    },
    {
      "time": 84.8,
      "end": 86.62,
      "text": "Подняли нот кротам"
    },
    {
      "time": 86.62,
      "end": 88.44,
      "text": "Донат кинули котам"
    },
    {
      "time": 88.44,
      "end": 89.28,
      "text": "бездомным"
    },
    {
      "time": 89.28,
      "end": 90.62,
      "text": "Братан, какой ты"
    },
    {
      "time": 90.62,
      "end": 91.7,
      "text": "мужик, если ты"
    },
    {
      "time": 91.7,
      "end": 92.54,
      "text": "с пиздой"
    },
    {
      "time": 92.54,
      "end": 94.04,
      "text": "В бездну упали,"
    },
    {
      "time": 94.4,
      "end": 96.08,
      "text": "поплюхи дали, пригнули"
    },
    {
      "time": 96.08,
      "end": 97.02,
      "text": "в импалу"
    },
    {
      "time": 97.02,
      "end": 99.0,
      "text": "Бей бабу поебалу,"
    },
    {
      "time": 99.1,
      "end": 100.14,
      "text": "как укупник"
    },
    {
      "time": 100.14,
      "end": 102.48,
      "text": "Добавил супу кропик,"
    },
    {
      "time": 102.78,
      "end": 104.38,
      "text": "когда -нибудь отдохнел"
    },
    {
      "time": 104.38,
      "end": 105.28,
      "text": "в тропиках"
    },
    {
      "time": 105.28,
      "end": 106.68,
      "text": "Про собачку был"
    },
    {
      "time": 106.68,
      "end": 108.34,
      "text": "разъеб у Есенина"
    },
    {
      "time": 108.34,
      "end": 110.22,
      "text": "Мы зависли тоже"
    },
    {
      "time": 110.22,
      "end": 111.78,
      "text": "неплохо, не то"
    },
    {
      "time": 111.78,
      "end": 112.82,
      "text": "что вы лохи"
    },
    {
      "time": 113.27,
      "end": 115.53,
      "text": "Оставили крохи на"
    },
    {
      "time": 115.53,
      "end": 117.17,
      "text": "столе, не убрались"
    },
    {
      "time": 117.17,
      "end": 119.23,
      "text": "Как всегда нажрались"
    },
    {
      "time": 119.23,
      "end": 121.43,
      "text": "Крадемся, как спринтал"
    },
    {
      "time": 121.43,
      "end": 122.09,
      "text": "в цел на"
    },
    {
      "time": 122.09,
      "end": 123.43,
      "text": "чужом районе"
    },
    {
      "time": 123.43,
      "end": 125.89,
      "text": "За нами наблюдает"
    },
    {
      "time": 125.89,
      "end": 127.23,
      "text": "товарищ майор"
    },
    {
      "time": 127.23,
      "end": 128.73,
      "text": "Читаем рэп и"
    },
    {
      "time": 128.73,
      "end": 130.11,
      "text": "поем, как новая"
    },
    {
      "time": 130.11,
      "end": 130.89,
      "text": "школа"
    },
    {
      "time": 130.89,
      "end": 132.65,
      "text": "Смотрели батл с"
    },
    {
      "time": 132.65,
      "end": 133.21,
      "text": "броллом"
    },
    {
      "time": 133.21,
      "end": 135.01,
      "text": "Это тот, который"
    },
    {
      "time": 135.01,
      "end": 136.33,
      "text": "он приебал"
    },
    {
      "time": 136.33,
      "end": 138.83,
      "text": "Мимо пробегал дырявый"
    },
    {
      "time": 138.83,
      "end": 140.31,
      "text": "А мне похуй,"
    },
    {
      "time": 140.61,
      "end": 141.73,
      "text": "я бы записал"
    },
    {
      "time": 141.73,
      "end": 142.77,
      "text": "его на трек"
    },
    {
      "time": 142.77,
      "end": 144.81,
      "text": "Чебурек съел несвежий,"
    },
    {
      "time": 144.87,
      "end": 145.99,
      "text": "грязный, как мои"
    },
    {
      "time": 145.99,
      "end": 146.73,
      "text": "куплеты"
    },
    {
      "time": 146.73,
      "end": 148.03,
      "text": "В голове пусто,"
    },
    {
      "time": 148.25,
      "end": 148.93,
      "text": "как и в"
    },
    {
      "time": 148.93,
      "end": 149.65,
      "text": "карманах"
    },
    {
      "time": 149.65,
      "end": 151.41,
      "text": "Отдохнул в могиле"
    },
    {
      "time": 151.41,
      "end": 152.99,
      "text": "или на нарах"
    },
    {
      "time": 152.99,
      "end": 154.99,
      "text": "Работали в ресторанах"
    },
    {
      "time": 154.99,
      "end": 155.75,
      "text": "и барах"
    },
    {
      "time": 155.75,
      "end": 157.35,
      "text": "Попивайся к пикну"
    },
    {
      "time": 157.35,
