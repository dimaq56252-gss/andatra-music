    },
    {
      "time": 45.62,
      "end": 47.08,
      "text": "Вокруг меня кульчальдин,"
    },
    {
      "time": 47.24,
      "end": 47.74,
      "text": "я в этой"
    },
    {
      "time": 47.74,
      "end": 48.56,
      "text": "жизни кретин"
    },
    {
      "time": 48.56,
      "end": 49.5,
      "text": "Ко мне придет"
    },
    {
      "time": 49.5,
      "end": 50.2,
      "text": "кто -то свыше,"
    },
    {
      "time": 50.34,
      "end": 51.3,
      "text": "когда снесет мою"
    },
    {
      "time": 51.3,
      "end": 51.74,
      "text": "крышу"
    },
    {
      "time": 51.74,
      "end": 52.36,
      "text": "Хоть в этом"
    },
    {
      "time": 52.36,
      "end": 53.24,
      "text": "мире я лишний,"
    },
    {
      "time": 53.34,
      "end": 54.4,
      "text": "текст откровенный и"
    },
    {
      "time": 54.4,
      "end": 54.8,
      "text": "личный"
    },
    {
      "time": 54.8,
      "end": 55.78,
      "text": "В окно сияет"
    },
    {
      "time": 55.78,
      "end": 57.1,
      "text": "луна, грустный взгляд"
    },
    {
      "time": 57.1,
      "end": 57.66,
      "text": "из окна"
    },
    {
      "time": 57.66,
      "end": 58.76,
      "text": "Но не поможет"
    },
    {
      "time": 58.76,
      "end": 60.34,
      "text": "она, вокруг сгущается"
    },
    {
      "time": 60.34,
      "end": 60.72,
      "text": "тьма"
    },
    {
      "time": 60.72,
      "end": 61.86,
      "text": "Почусь скажу из"
    },
    {
      "time": 61.86,
      "end": 62.26,
      "text": "ума"
    },
    {
      "time": 63.42,
      "end": 64.5,
      "text": "В Москву на"
    },
    {
      "time": 64.5,
      "end": 66.02,
      "text": "запись, писать негде"
    },
    {
      "time": 66.02,
      "end": 67.34,
      "text": "Пиво напился, в"
    },
    {
      "time": 67.34,
      "end": 68.08,
      "text": "Питске не будет"
    },
    {
      "time": 68.08,
      "end": 69.08,
      "text": "сегодня домой"
    },
    {
      "time": 69.08,
      "end": 70.8,
      "text": "Долой уныние, до"
    },
    {
      "time": 70.8,
      "end": 71.6,
      "text": "сих пор ебём"
    },
    {
      "time": 71.6,
      "end": 72.66,
      "text": "и не вынимаем"
    },
    {
      "time": 72.66,
      "end": 74.0,
      "text": "Этот город держит"
    },
    {
      "time": 74.0,
      "end": 75.1,
      "text": "в Альдемар, ставка"
    },
    {
      "time": 75.1,
      "end": 75.84,
      "text": "на венера не"
    },
    {
      "time": 75.84,
      "end": 76.64,
      "text": "проканала"
    },
    {
      "time": 76.64,
      "end": 77.34,
      "text": "Но в этой"
    },
    {
      "time": 77.34,
      "end": 78.22,
      "text": "канале под наш"
    },
    {
      "time": 78.22,
      "end": 79.34,
      "text": "пасть качаются и"
    },
    {
      "time": 79.34,
      "end": 80.02,
      "text": "работяги"
    },
    {
      "time": 80.02,
      "end": 81.76,
      "text": "Мои бархатные тяги,"
    },
    {
      "time": 81.8,
      "end": 83.14,
      "text": "как всегда, прекрасно"
    },
    {
      "time": 83.14,
      "end": 85.48,
      "text": "Солнышко красное, морозы"
    },
    {
      "time": 85.48,
      "end": 86.26,
      "text": "этой зимой"
    },
    {
      "time": 86.26,
      "end": 87.66,
      "text": "Зил не заводится,"
    },
    {
      "time": 87.84,
      "end": 88.64,
      "text": "боже мой"
    },
    {
      "time": 88.64,
      "end": 90.14,
      "text": "В секретной ложе"
    },
    {
      "time": 90.14,
      "end": 91.74,
      "text": "сидим и хлебаем"
    },
    {
      "time": 91.74,
      "end": 92.94,
      "text": "бульон из дырявой"
    },
    {
      "time": 92.94,
      "end": 93.38,
      "text": "ложки"
    },
    {
      "time": 93.38,
      "end": 95.68,
      "text": "Балалайка, водочка, матрёшки"
    },
    {
      "time": 95.68,
      "end": 96.7,
      "text": "и не грамма"
    },
    {
      "time": 96.7,
      "end": 97.34,
      "text": "порошка"
    },
    {
      "time": 97.34,
      "end": 98.68,
      "text": "Я попрошайка в"
    },
    {
      "time": 98.68,
      "end": 99.56,
      "text": "плане битов"
    },
    {
      "time": 99.56,
      "end": 100.98,
      "text": "Ходили в бассейн,"
    },
    {
      "time": 101.0,
      "end": 102.44,
      "text": "играли в бадминтон"
    },
    {
      "time": 102.44,
      "end": 103.9,
      "text": "Барыга много лет"
    },
    {
      "time": 103.9,
      "end": 105.34,
      "text": "работал, он под"
    },
    {
      "time": 105.34,
      "end": 105.94,
      "text": "ментом"
    },
    {
      "time": 105.94,
      "end": 107.18,
      "text": "На лагере теперь"
    },
    {
      "time": 107.18,
      "end": 108.5,
      "text": "продол подметает"
    },
    {
      "time": 108.5,
      "end": 109.78,
      "text": "Самой скуп этот"
    },
    {
      "time": 109.78,
      "end": 110.74,
      "text": "дядя Виталик"
    },
    {
      "time": 110.92,
      "end": 111.84,
      "text": "Берут друга с"
    },
    {
      "time": 111.84,
