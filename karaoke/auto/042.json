      "text": "разносить"
    },
    {
      "time": 84.67,
      "end": 85.95,
      "text": "Это замкнутый круг,"
    },
    {
      "time": 86.25,
      "end": 87.33,
      "text": "надо дальше читать"
    },
    {
      "time": 87.33,
      "end": 88.71,
