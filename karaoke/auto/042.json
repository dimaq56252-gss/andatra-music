    },
    {
      "time": 106.05,
      "end": 107.29,
      "text": "под офигеннейший бит"
    },
    {
      "time": 107.29,
      "end": 108.19,
      "text": "Сейчас Хаги -Ваги"
    },
    {
      "time": 108.19,
      "end": 109.21,
      "text": "влетит в этот"
    },
    {
      "time": 109.21,
      "end": 109.99,
