    },
    {
      "time": 111.73,
      "end": 112.63,
      "text": "поставит на рек"
    },
    {
      "time": 117.53,
      "end": 118.67,
      "text": "Залетел на биток,"
    },
    {
      "time": 118.97,
      "end": 119.55,
