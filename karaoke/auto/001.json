  "cues": [
    {
      "time": 14.93,
      "end": 17.39,
      "text": "Самый ебанутый аутист"
    },
    {
      "time": 17.39,
      "end": 19.41,
      "text": "Зарядил свою ковылу"
    },
    {
      "time": 19.41,
      "end": 20.59,
      "text": "Просто выдав ей"
    },
    {
      "time": 20.59,
      "end": 21.31,
      "text": "зарплату"
    },
    {
      "time": 21.31,
      "end": 22.65,
      "text": "Пусть напишет ещё"
    },
    {
      "time": 22.65,
      "end": 23.17,
      "text": "текст"
    },
    {
      "time": 23.17,
      "end": 24.15,
      "text": "Всё равно не"
    },
    {
      "time": 24.15,
      "end": 25.03,
      "text": "зачитает"
    },
    {
      "time": 25.03,
      "end": 26.93,
      "text": "Финансы всё порешают"
    },
    {
      "time": 26.93,
      "end": 28.23,
      "text": "Все проблемы и"
    },
    {
      "time": 28.23,
      "end": 28.87,
      "text": "задачи"
    },
    {
      "time": 28.87,
      "end": 30.23,
      "text": "Похуй даже если"
    },
    {
      "time": 30.23,
      "end": 30.85,
      "text": "квест"
    },
    {
      "time": 30.85,
      "end": 32.25,
      "text": "В салоне нету"
    },
    {
      "time": 32.25,
      "end": 32.67,
      "text": "мест"
    },
    {
      "time": 32.67,
      "end": 33.63,
      "text": "Если что -то"
    },
    {
      "time": 33.63,
      "end": 34.67,
      "text": "удаляют"
    },
    {
      "time": 34.67,
      "end": 35.59,
      "text": "То мне нужен"
    },
    {
      "time": 35.59,
      "end": 36.35,
      "text": "интерес"
    },
    {
      "time": 36.35,
      "end": 37.85,
      "text": "Ты качаешь свои"
    },
    {
      "time": 37.85,
      "end": 38.43,
      "text": "банки"
    },
    {
      "time": 38.43,
      "end": 39.79,
      "text": "Я качаю только"
    },
    {
      "time": 39.79,
      "end": 40.37,
      "text": "пресс"
    },
    {
      "time": 40.37,
      "end": 41.79,
      "text": "Видишь эту пачку"
    },
    {
      "time": 41.79,
      "end": 42.21,
      "text": "денег"
    },
    {
      "time": 42.21,
      "end": 44.23,
      "text": "Это чистый антистресс"
    },
    {
      "time": 45.95,
      "end": 47.71,
      "text": "Аутис на Эвике,"
    },
    {
      "time": 47.93,
      "end": 49.05,
      "text": "мы летим, как"
    },
    {
      "time": 49.05,
      "end": 49.85,
      "text": "Маверик."
    },
    {
      "time": 50.31,
      "end": 51.43,
      "text": "Я твой рот"
    },
    {
      "time": 51.43,
      "end": 53.29,
      "text": "ебал, можешь мне"
    },
    {
      "time": 53.29,
      "end": 54.25,
      "text": "поверить."
    },
    {
      "time": 54.51,
      "end": 56.09,
      "text": "Или можешь пойти"
    },
    {
      "time": 56.09,
      "end": 56.85,
      "text": "нахуй."
    },
    {
      "time": 57.27,
      "end": 58.51,
      "text": "Хахаль твой со"
    },
    {
      "time": 58.51,
      "end": 59.69,
      "text": "мной читает."
    },
    {
      "time": 60.17,
      "end": 61.71,
      "text": "Браток оставь, добит"
    },
    {
      "time": 61.71,
      "end": 62.55,
      "text": "чинарик."
    },
    {
      "time": 62.97,
      "end": 64.85,
      "text": "За 19 косарей"
    },
    {
      "time": 64.85,
      "end": 66.79,
      "text": "Мишаня взял фонарик."
    },
    {
      "time": 67.39,
      "end": 69.37,
      "text": "Сегодня день рождения"
    },
    {
      "time": 69.37,
      "end": 70.91,
      "text": "Кили Вилли, но"
    },
    {
      "time": 70.91,
      "end": 72.03,
      "text": "нет шариков."
    },
    {
      "time": 72.51,
      "end": 73.81,
      "text": "Въебал по паре"
    },
    {
      "time": 73.81,
      "end": 74.61,
      "text": "париков."
    },
    {
      "time": 74.61,
      "end": 77.11,
      "text": "Если есть надувная"
    },
    {
      "time": 77.11,
      "end": 78.87,
      "text": "кукла, то на"
    },
    {
      "time": 78.87,
      "end": 80.13,
      "text": "ней есть парик"
    },
    {
      "time": 80.13,
      "end": 82.16,
      "text": "Ты в панике"
    },
    {
      "time": 82.16,
      "end": 83.82,
      "text": "от моей хуйни,"
    },
    {
      "time": 83.82,
      "end": 84.98,
      "text": "понимаю"
    },
    {
      "time": 84.98,
      "end": 87.1,
      "text": "Но ебу тебя"
    },
    {
      "time": 87.1,
      "end": 89.14,
      "text": "дальше и не"
    },
    {
      "time": 89.14,
      "end": 90.38,
      "text": "вынимаю"
    },
    {
      "time": 90.38,
      "end": 93.34,
      "text": "Тебя как малыша"
    },
    {
      "time": 93.34,
      "end": 95.34,
      "text": "мы запеленали"
    },
    {
      "time": 95.34,
      "end": 97.48,
      "text": "Хуёво, если тебя"
    },
    {
      "time": 97.48,
      "end": 99.08,
      "text": "пиздюком во дворе"
    },
    {
      "time": 99.08,
      "end": 100.1,
      "text": "пинали"
    },
    {
      "time": 100.1,
      "end": 103.24,
      "text": "Карандаши, фломастеры в"
    },
    {
      "time": 103.24,
      "end": 103.96,
      "text": "пенале"
    },
    {
      "time": 103.96,
      "end": 106.06,
      "text": "Похуй, что в"
    },
    {
      "time": 106.06,
      "end": 106.8,
      "text": "начале"
    },
    {
      "time": 106.8,
      "end": 108.0,
      "text": "Важно, что в"
    },
    {
      "time": 108.0,
      "end": 108.74,
      "text": "финале"
    },
    {
      "time": 108.74,
      "end": 111.4,
      "text": "Как говорится, братан"
    },
    {
      "time": 111.4,
      "end": 112.84,
      "text": "Мы на Урале"
    },
    {
      "time": 112.84,
      "end": 114.56,
      "text": "Что скажешь"
    },
    {
      "time": 114.56,
      "end": 115.88,
      "text": "Об анале"
    },
    {
      "time": 117.3,
      "end": 120.45,
      "text": "С днем рождения,"
    },
    {
      "time": 120.57,
      "end": 121.11,
      "text": "братка"
    },
    {
      "time": 121.11,
      "end": 121.83,
      "text": "Мой"
    },
    {
      "time": 121.83,
      "end": 123.21,
      "text": "Если бы не"
    },
    {
      "time": 123.21,
      "end": 123.57,
      "text": "ты"
    },
    {
      "time": 123.57,
      "end": 124.89,
      "text": "То не было"
    },
    {
      "time": 124.89,
      "end": 126.41,
      "text": "бы этой песни"
    },
    {
      "time": 126.41,
      "end": 128.41,
      "text": "И всех остальных"
    },
    {
      "time": 128.41,
      "end": 130.97,
      "text": "250 треков"
    },
    {
      "time": 130.97,
      "end": 131.43,
      "text": "Блять"
    },
    {
      "time": 131.43,
      "end": 133.39,
      "text": "Или сколько там"
    },
    {
      "time": 133.39,
      "end": 135.83,
      "text": "Ай, было бы"
    },
    {
      "time": 135.83,
      "end": 137.37,
      "text": "неплохо хук от"
    },
    {
      "time": 137.37,
      "end": 137.77,
      "text": "тебя."
    },
