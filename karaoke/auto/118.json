    },
    {
      "time": 88.74,
      "end": 90.08,
      "text": "Спиву, клинок"
    },
    {
      "time": 90.08,
      "end": 91.68,
      "text": "Девять мышной андатры"
    },
    {
      "time": 91.68,
      "end": 92.58,
