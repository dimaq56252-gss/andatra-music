      "time": 78.64,
      "end": 79.84,
      "text": "Привет, ты Диди"
    },
    {
      "time": 79.84,
      "end": 80.98,
      "text": "и Кенни Весту"
    },
    {
      "time": 81.9,
      "end": 83.18,
      "text": "Я разъебал вас,"
    },
    {
      "time": 83.2,
      "end": 84.02,
      "text": "ебаный рок, ты"
    },
    {
      "time": 84.02,
      "end": 85.12,
      "text": "хочешь вверх, подам"
    },
    {
      "time": 85.12,
      "end": 85.42,
