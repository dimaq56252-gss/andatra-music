      "time": 54.46,
      "end": 55.32,
      "text": "в халатик"
    },
    {
      "time": 55.32,
      "end": 56.14,
      "text": "Вы мне в"
    },
    {
      "time": 56.14,
      "end": 57.3,
      "text": "душу не гадьте"
    },
    {
      "time": 57.3,
      "end": 58.48,
      "text": "Мы с мешаней"
