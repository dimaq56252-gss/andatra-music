  "cues": [
    {
      "time": 9.26,
      "end": 12.34,
      "text": "Андатра, Мишаня"
    },
    {
      "time": 12.34,
      "end": 18.16,
      "text": "Я залетаю на"
    },
    {
      "time": 18.16,
      "end": 18.5,
      "text": "бит"
    },
    {
      "time": 18.5,
      "end": 20.76,
      "text": "Серия Андатры троглодит"
    },
    {
      "time": 20.76,
      "end": 22.48,
      "text": "Ты молодые нахуй"
    },
    {
      "time": 22.48,
      "end": 24.5,
      "text": "под солями перекрыты"
    },
    {
      "time": 24.5,
      "end": 26.06,
      "text": "Тайник магнит да"
    },
    {
      "time": 26.06,
      "end": 26.58,
      "text": "похуй"
    },
    {
      "time": 26.58,
      "end": 27.8,
      "text": "Говно к жопе"
    },
    {
      "time": 27.8,
      "end": 28.56,
      "text": "присохло"
    },
    {
      "time": 28.56,
      "end": 30.02,
      "text": "Еду к барыге"
    },
    {
      "time": 30.02,
      "end": 30.74,
      "text": "за трех"
    },
    {
      "time": 30.74,
      "end": 33.08,
      "text": "Городы мои пороха"
    },
    {
      "time": 33.08,
      "end": 34.7,
      "text": "Так сказал великий"
    },
    {
      "time": 34.7,
      "end": 36.68,
      "text": "Не оставляй улики"
    },
    {
      "time": 36.68,
      "end": 38.22,
      "text": "Нашли мне новый"
    },
    {
      "time": 38.22,
      "end": 38.84,
      "text": "домик"
    },
    {
      "time": 38.84,
      "end": 40.78,
      "text": "Я теперь улитка"
    },
    {
      "time": 40.78,
      "end": 42.8,
      "text": "Заберусь под плитку"
    },
    {
      "time": 42.8,
      "end": 43.46,
      "text": "горит"
    },
    {
      "time": 43.46,
      "end": 44.32,
      "text": "А ей буду"
    },
    {
      "time": 44.32,
      "end": 45.16,
      "text": "угорать"
    },
    {
      "time": 45.16,
      "end": 47.1,
      "text": "Френдли тага каратель"
    },
    {
      "time": 47.1,
      "end": 48.3,
      "text": "Албак лежит в"
    },
    {
      "time": 48.3,
      "end": 48.88,
      "text": "кровати"
    },
    {
      "time": 48.88,
      "end": 50.32,
      "text": "Храпит как будто"
    },
    {
      "time": 50.32,
      "end": 51.4,
      "text": "бы мой батя"
    },
    {
      "time": 51.4,
      "end": 52.2,
