  "cues": [
    {
      "time": 16.41,
      "end": 18.65,
      "text": "Возвращается чёрный король"
    },
    {
      "time": 18.65,
      "end": 20.53,
      "text": "на связь, Нам"
    },
    {
      "time": 20.53,
      "end": 22.13,
      "text": "всем светит тёмная"
    },
    {
      "time": 22.13,
      "end": 22.71,
      "text": "масть."
    },
    {
      "time": 23.55,
      "end": 26.07,
      "text": "Закрой свою ебаную"
    },
    {
      "time": 26.07,
      "end": 28.87,
      "text": "пасть, Я, блядь,"
    },
    {
      "time": 28.87,
      "end": 30.21,
      "text": "пропасть не упал."
    },
    {
      "time": 30.21,
      "end": 32.11,
      "text": "Мы теперь наймайсы,"
    },
    {
      "time": 32.27,
      "end": 33.39,
      "text": "ебашим ряд для"
    },
    {
      "time": 33.39,
      "end": 34.01,
      "text": "массы"
    },
    {
      "time": 34.01,
      "end": 35.61,
      "text": "Каэнджел это мой"
    },
    {
      "time": 35.61,
      "end": 37.59,
      "text": "сынок, не для"
    },
    {
      "time": 37.59,
      "end": 39.79,
      "text": "тебя выращивал цветок"
    },
    {
      "time": 39.79,
      "end": 41.11,
      "text": "Ты знаешь, как"
    },
    {
      "time": 41.11,
      "end": 42.71,
      "text": "люблю писать тексток,"
    },
    {
      "time": 42.87,
      "end": 44.39,
      "text": "как вайпер любит"
    },
    {
      "time": 44.39,
      "end": 44.93,
      "text": "чеснок"
    },
    {
      "time": 44.93,
      "end": 46.45,
      "text": "Как пидор любит"
    },
    {
      "time": 46.45,
      "end": 48.31,
      "text": "челок, мы разъебали"
    },
    {
      "time": 48.31,
      "end": 48.99,
      "text": "чуток"
    },
    {
      "time": 48.99,
      "end": 50.63,
      "text": "Коломна это не"
    },
    {
      "time": 50.63,
      "end": 52.87,
      "text": "чукотка, я темный"
    },
    {
      "time": 52.87,
      "end": 53.77,
      "text": "принц, а значит"
    },
    {
      "time": 53.77,
      "end": 54.89,
      "text": "у меня на"
    },
    {
      "time": 54.89,
      "end": 56.07,
      "text": "жопе чесотка"
    },
    {
      "time": 56.07,
      "end": 57.33,
      "text": "Сейчас бы сотку"
    },
    {
      "time": 57.33,
      "end": 59.13,
      "text": "водки, потом вернуть"
    },
    {
      "time": 59.13,
      "end": 60.49,
      "text": "сушки в пилотку"
    },
    {
      "time": 60.49,
      "end": 62.17,
      "text": "Я, блядь, не"
    },
    {
      "time": 62.17,
      "end": 64.29,
      "text": "знаю, это разъёб"
    },
    {
      "time": 64.29,
      "end": 65.23,
      "text": "или ебал"
    },
    {
      "time": 65.23,
      "end": 66.37,
      "text": "Что это? Не"
    },
    {
      "time": 66.37,
      "end": 67.91,
      "text": "вышло только боком"
    },
    {
      "time": 67.91,
      "end": 69.33,
      "text": "Я уже скупу,"
    },
    {
      "time": 69.37,
      "end": 70.11,
      "text": "а значит нас"
    },
    {
      "time": 70.11,
      "end": 71.31,
      "text": "всех ебанет сейчас"
    },
    {
      "time": 71.31,
      "end": 71.93,
      "text": "током"
    },
    {
      "time": 71.93,
      "end": 73.27,
      "text": "Не знаю, какой"
    },
    {
      "time": 73.27,
      "end": 75.37,
      "text": "толк глушает Стивен"
    },
    {
      "time": 75.37,
      "end": 75.93,
      "text": "Хокинг"
    },
    {
      "time": 75.93,
      "end": 76.97,
      "text": "А я скорее"
    },
    {
      "time": 76.97,
      "end": 79.05,
      "text": "охотник на кокера"
    },
    {
      "time": 80.05,
      "end": 81.53,
      "text": "Хочешь, буду для"
    },
    {
      "time": 81.53,
      "end": 83.71,
      "text": "тебя пиздатым рокером"
    },
    {
      "time": 83.71,
      "end": 85.37,
      "text": "А хочешь рэпом"
    },
    {
      "time": 85.37,
      "end": 86.47,
      "text": "или трэпом, я"
    },
    {
      "time": 86.47,
      "end": 87.09,
      "text": "тебе в рот,"
    },
    {
      "time": 87.11,
      "end": 87.81,
      "text": "блядь, дам"
    },
    {
      "time": 87.81,
      "end": 91.15,
      "text": "Буду пиздатым рокером"
    },
    {
      "time": 91.15,
      "end": 93.91,
      "text": "Или трэпом рэпом,"
    },
    {
      "time": 93.99,
      "end": 94.91,
      "text": "я тебе в"
    },
    {
      "time": 94.91,
      "end": 95.75,
      "text": "рот, блядь, дам"
    },
    {
      "time": 96.99,
      "end": 99.43,
      "text": "Интулил меня мажет"
    },
    {
      "time": 99.43,
      "end": 100.37,
      "text": "пертусин"
    },
    {
      "time": 100.37,
      "end": 101.95,
      "text": "Я пасты белый"
    },
    {
      "time": 101.95,
      "end": 103.85,
      "text": "заводной апельсин"
    },
    {
      "time": 103.85,
      "end": 105.55,
      "text": "Если у тебя"
    },
    {
      "time": 105.55,
      "end": 107.87,
      "text": "горит, это керосин"
    },
    {
      "time": 107.87,
      "end": 109.37,
      "text": "Вы ебов всех"
    },
    {
      "time": 109.37,
      "end": 111.11,
      "text": "сучек, будто бы"
    },
    {
      "time": 111.11,
      "end": 111.83,
      "text": "Джон Син"
    },
    {
      "time": 111.83,
      "end": 113.93,
      "text": "Если ты базаришь"
    },
    {
      "time": 113.93,
      "end": 115.05,
      "text": "криво, то ты"
    },
    {
      "time": 115.05,
      "end": 116.09,
      "text": "полный кретин"
    },
    {
      "time": 116.09,
      "end": 118.37,
      "text": "Зарядил на битах,"
    },
    {
      "time": 118.57,
      "end": 119.83,
      "text": "пьебал креатин"
    },
    {
      "time": 119.83,
      "end": 121.97,
      "text": "Мне почти тридцатик,"
    },
    {
      "time": 122.09,
      "end": 123.79,
      "text": "выгляжу как Алин"
    },
    {
      "time": 123.79,
      "end": 127.75,
      "text": "Сел новым акваром,"
    },
    {
      "time": 127.85,
      "end": 129.25,
      "text": "я поднялся сам"
    },
    {
      "time": 129.25,
      "end": 130.35,
      "text": "Похуй, что ты"
    },
    {
      "time": 130.35,
      "end": 131.81,
      "text": "скажешь, папин"
    },
    {
      "time": 131.81,
      "end": 134.11,
      "text": "Моя сука со"
    },
    {
      "time": 134.11,
      "end": 135.19,
      "text": "мной рядом"
    },
    {
      "time": 135.19,
      "end": 137.17,
      "text": "Я как экзасты"
    },
    {
      "time": 137.17,
      "end": 138.71,
      "text": "занимаюсь с ней"
    },
    {
      "time": 138.71,
      "end": 139.91,
      "text": "обрядом"
    },
    {
      "time": 139.91,
      "end": 143.67,
      "text": "Покажи, покажи, покажи"
    },
    {
      "time": 143.67,
      "end": 145.03,
      "text": "Показал на что"
    },
    {
      "time": 145.03,
      "end": 147.63,
      "text": "способен, написал глухую"
    },
    {
      "time": 147.63,
      "end": 150.05,
      "text": "Называй меня биткоинец,"
    },
    {
      "time": 150.15,
      "end": 151.71,
      "text": "видо добрый малый"
    },
    {
      "time": 151.71,
      "end": 152.91,
      "text": "Но я очень"
    },
    {
      "time": 152.91,
      "end": 154.45,
      "text": "беспокоен, как для"
    },
    {
      "time": 154.45,
      "end": 156.51,
      "text": "моих близких подняться"
    },
    {
      "time": 156.51,
      "end": 159.93,
      "text": "Как ёбаный биткоин"
    },
    {
      "time": 160.13,
