      "end": 117.23,
      "text": "Их пытаюсь обойти,"
    },
    {
      "time": 117.45,
      "end": 118.45,
      "text": "меня уже не"
    },
    {
      "time": 118.45,
      "end": 118.95,
      "text": "спасти"
    },
    {
      "time": 118.95,
      "end": 120.05,
      "text": "Ведь ты всегда"
    },
    {
      "time": 120.05,
      "end": 121.43,
      "text": "говоришь, что я"
    },
    {
      "time": 121.43,
      "end": 122.81,
      "text": "кайфую спонтанно"
    },
    {
      "time": 122.81,
      "end": 123.73,
      "text": "Но это мы"
    },
    {
      "time": 123.73,
      "end": 125.01,
      "text": "страны движ, пусть"
    },
    {
      "time": 125.01,
      "end": 126.47,
      "text": "это будет странно"
    },
    {
      "time": 126.47,
      "end": 127.87,
      "text": "Ты отпусти мою"
    },
    {
      "time": 127.87,
      "end": 129.01,
      "text": "душу, не делай"
    },
    {
      "time": 129.01,
      "end": 130.33,
      "text": "из нее игрушку"
    },
    {
      "time": 130.33,
      "end": 131.27,
      "text": "Ведь летел я"
    },
    {
      "time": 131.27,
      "end": 132.13,
      "text": "в твои ушки,"
    },
    {
      "time": 132.29,
      "end": 133.07,
      "text": "для меня ты"
    },
    {
      "time": 133.07,
      "end": 133.97,
      "text": "не подружка"
    },
    {
      "time": 133.97,
      "end": 134.93,
      "text": "Обидно, что не"
    },
    {
      "time": 134.93,
      "end": 136.71,
      "text": "захотела, мое время"
    },
    {
      "time": 136.71,
      "end": 137.55,
      "text": "пролетело"
    },
    {
      "time": 137.55,
      "end": 138.83,
      "text": "Это просто не"
    },
    {
      "time": 138.83,
      "end": 139.99,
      "text": "важно, это мое"
    },
    {
      "time": 139.99,
      "end": 140.95,
      "text": "личное дело"
    },
    {
      "time": 140.95,
      "end": 142.29,
      "text": "Я выхожу из"
    },
    {
      "time": 142.29,
      "end": 144.79,
      "text": "системы, медленно удаляюсь"
    },
    {
      "time": 144.79,
      "end": 146.01,
      "text": "Я жму кнопку"
    },
    {
      "time": 146.01,
      "end": 147.49,
      "text": "дэлит и тихо"
    },
    {
      "time": 147.49,
      "end": 148.47,
      "text": "растворяюсь"
    },
    {
      "time": 148.47,
      "end": 150.07,
      "text": "Немного ты пойми"
    },
    {
      "time": 150.07,
      "end": 151.89,
      "text": "и тему отпусти"
    },
    {
      "time": 151.89,
      "end": 153.31,
      "text": "И если лишнего"
    },
    {
      "time": 153.31,
      "end": 154.85,
      "text": "сказал, ты меня"
    },
    {
      "time": 154.85,
      "end": 155.57,
      "text": "прости"
    },
    {
      "time": 156.15,
      "end": 159.89,
      "text": "И похабдай, я"
    },
    {
      "time": 159.89,
      "end": 161.15,
      "text": "чутка похавал"
    },
    {
      "time": 161.15,
      "end": 162.95,
      "text": "Мои друзья нахалы,"
    },
    {
      "time": 163.49,
      "end": 164.79,
      "text": "кили -вили, хаги"
    },
    {
      "time": 164.79,
      "end": 165.27,
      "text": "-ваги"
    },
    {
      "time": 165.27,
      "end": 167.51,
      "text": "Мы стелим андеграунд,"
    },
    {
      "time": 167.73,
      "end": 168.97,
      "text": "а ты кроватку"
    },
    {
      "time": 168.97,
      "end": 170.53,
      "text": "Я вон ебал,"
    },
    {
      "time": 170.63,
      "end": 171.27,
      "text": "ты где мать,"
    },
    {
      "time": 171.37,
      "end": 172.63,
      "text": "твои закладки"
    },
    {
      "time": 172.63,
      "end": 175.03,
      "text": "Еблан Кизару играет"
    },
    {
      "time": 175.03,
      "end": 175.81,
      "text": "со мною в"
    },
    {
      "time": 175.81,
      "end": 176.25,
      "text": "прятки"
    },
    {
      "time": 176.25,
      "end": 178.39,
      "text": "Я подпурил пятку,"
    },
    {
      "time": 178.81,
      "end": 180.37,
      "text": "твою ебалу смятку"
    },
    {
      "time": 180.37,
      "end": 181.67,
      "text": "Пиздую вновь на"
    },
    {
      "time": 181.67,
      "end": 182.21,
      "text": "блядке"
    },
    {
      "time": 182.21,
      "end": 184.05,
      "text": "Андеграунд Андадра"
    },
    {
      "time": 184.05,
      "end": 186.31,
      "text": "Тебя ебали, долбоёба"
    },
    {
      "time": 186.31,
      "end": 187.97,
      "text": "Со мной Санёк"
    },
    {
      "time": 187.97,
      "end": 188.57,
      "text": "Кирпич"
    },
    {
      "time": 188.57,
      "end": 190.37,
      "text": "Олег Нечипаренко"
    },
    {
      "time": 190.37,
      "end": 192.25,
      "text": "Это ебаный снич"
    },
    {
      "time": 192.25,
      "end": 193.53,
      "text": "Мы скоро своей"
    },
    {
      "time": 193.53,
      "end": 194.19,
      "text": "хуйнёй"
    },
    {
      "time": 194.19,
      "end": 196.09,
      "text": "Будем ловушку стричь"
    },
    {
      "time": 196.09,
      "end": 197.87,
      "text": "Мой братуха Лекарь"
    },
    {
      "time": 197.87,
      "end": 200.07,
      "text": "Есть чем подлечиться"
    },
    {
      "time": 200.07,
      "end": 201.99,
      "text": "Ты долбоёб ебаный"
    },
    {
      "time": 201.99,
      "end": 204.13,
      "text": "Это нихуя не"
    },
    {
      "time": 204.13,
      "end": 204.83,
      "text": "лечится"
    },
    {
      "time": 204.83,
      "end": 206.41,
      "text": "Твоя шалаба"
    },
    {
      "time": 206.41,
      "end": 207.31,
      "text": "Видит меня"
    },
    {
      "time": 207.31,
      "end": 208.99,
      "text": "Сразу мечется"
    },
    {
      "time": 208.99,
      "end": 211.47,
      "text": "Лох, пидор"
    },
    {
      "time": 211.47,
      "end": 213.79,
      "text": "У меня на"
    },
    {
      "time": 213.79,
      "end": 214.59,
      "text": "вас наводка"
    },
    {
      "time": 214.59,
      "end": 216.37,
      "text": "Раздвигай сейчас пилот"
    },
    {
      "time": 216.37,
      "end": 217.15,
      "text": "Был на типов"
    },
    {
      "time": 217.15,
      "end": 218.25,
      "text": "твоих наводка"
    },
    {
      "time": 218.25,
      "end": 220.11,
      "text": "Пиздолбов море лодка"
    },
    {
      "time": 220.11,
      "end": 220.83,
      "text": "А в моих"
    },
    {
      "time": 220.83,
      "end": 221.93,
      "text": "новостях сводка"
    },
    {
      "time": 221.93,
      "end": 223.45,
      "text": "Я трущит инфобляс"
    },
    {
      "time": 223.45,
      "end": 223.85,
      "text": "водка"
    },
    {
      "time": 223.85,
      "end": 225.23,
      "text": "Вермишит себе на"
    },
    {
      "time": 225.23,
      "end": 225.73,
      "text": "ужин"
    },
    {
      "time": 225.73,
      "end": 227.53,
      "text": "Ландатр сейчас сужен"
    },
    {
      "time": 227.53,
      "end": 228.83,
      "text": "Эти пэду нужен"
    },
    {
      "time": 228.83,
      "end": 229.31,
      "text": "фрейм"
    },
    {
      "time": 229.31,
      "end": 231.21,
      "text": "Пайсушки будут сужен"
    },
    {
      "time": 231.73,
      "end": 233.53,
      "text": "Я работал"
    },
    {
      "time": 233.53,
      "end": 234.97,
      "text": "Я блядь тружен"
    },
    {
      "time": 235.03,
      "end": 237.41,
      "text": "Поднимаюсь за братья"
    },
    {
      "time": 237.41,
      "end": 238.53,
      "text": "Этот фужер"
    },
    {
      "time": 238.53,
      "end": 239.17,
      "text": "А в моей"
    },
    {
      "time": 239.17,
      "end": 240.57,
      "text": "реально фьюжен"
    },
    {
      "time": 240.6,
      "end": 241.68,
      "text": "Ай!"
    },
    {
      "time": 241.88,
      "end": 265.822041,
      "text": "♪ нет отчаяния"
    }
