    {
      "time": 13.74,
      "end": 14.86,
      "text": "Где -то море"
    },
    {
      "time": 14.86,
      "end": 15.9,
      "text": "кайфов, а где"
    },
    {
      "time": 15.9,
      "end": 17.16,
      "text": "-то море грусти"
    },
    {
      "time": 17.16,
      "end": 18.26,
      "text": "К любым раскладам"
    },
    {
      "time": 18.26,
      "end": 19.82,
      "text": "готов, пока биток"
    },
    {
      "time": 19.82,
      "end": 20.7,
      "text": "не отпустит"
    },
    {
      "time": 20.7,
      "end": 22.06,
      "text": "Этой жизни и"
    },
    {
      "time": 22.06,
      "end": 23.26,
      "text": "боли я пилю"
    },
    {
      "time": 23.26,
      "end": 24.06,
      "text": "на доле"
    },
    {
      "time": 24.06,
      "end": 25.06,
      "text": "Их так много"
    },
    {
      "time": 25.06,
      "end": 26.0,
      "text": "в душе, я"
    },
    {
      "time": 26.0,
      "end": 27.48,
      "text": "меньше не позволю"
    },
    {
      "time": 27.48,
      "end": 28.48,
      "text": "Хочу нырнуть в"
    },
    {
      "time": 28.48,
      "end": 29.7,
      "text": "глубину, я там"
    },
    {
      "time": 29.7,
      "end": 30.76,
      "text": "не утону"
    },
    {
      "time": 30.76,
      "end": 32.12,
      "text": "Не полечу туда"
    },
    {
      "time": 32.12,
      "end": 33.72,
      "text": "мигом, словно камень"
    },
    {
      "time": 33.72,
      "end": 34.16,
      "text": "ко дну"
    },
    {
      "time": 34.16,
      "end": 35.2,
      "text": "Мне от судьбы"
    },
    {
      "time": 35.2,
      "end": 36.64,
      "text": "звонки, все это"
    },
    {
      "time": 36.64,
      "end": 37.52,
      "text": "пустяки"
    },
    {
      "time": 37.52,
      "end": 38.86,
      "text": "И на пламя"
    },
    {
      "time": 38.86,
      "end": 40.98,
      "text": "мое слетятся мотыльки"
    },
    {
      "time": 40.98,
      "end": 42.04,
      "text": "Опять в душе"
    },
    {
      "time": 42.04,
      "end": 43.52,
      "text": "пожар, сейчас люди"
    },
    {
      "time": 43.52,
      "end": 44.52,
      "text": "как товар"
    },
    {
      "time": 44.52,
      "end": 45.68,
      "text": "Пока идешь ты"
    },
    {
      "time": 45.68,
      "end": 46.58,
      "text": "на базар, я"
    },
    {
      "time": 46.58,
      "end": 48.08,
      "text": "собираю полный зал"
    },
    {
      "time": 48.08,
      "end": 49.4,
      "text": "Тебе дорога на"
    },
    {
      "time": 49.4,
      "end": 50.3,
      "text": "вокзал, я только"
    },
    {
      "time": 50.3,
      "end": 51.22,
      "text": "что сказал"
    },
    {
      "time": 51.22,
      "end": 53.1,
      "text": "Внутри меня напал,"
    },
    {
      "time": 53.2,
      "end": 54.34,
      "text": "это вообще не"
    },
    {
      "time": 54.34,
      "end": 54.84,
      "text": "шар"
    },
    {
      "time": 54.84,
      "end": 56.44,
      "text": "Мой непонятный план,"
    },
    {
      "time": 56.74,
      "end": 57.34,
      "text": "ведь снова в"
    },
    {
      "time": 57.34,
      "end": 58.2,
      "text": "жизни бедлам"
    },
    {
      "time": 58.2,
      "end": 59.4,
      "text": "И иногда все"
    },
    {
      "time": 59.4,
      "end": 61.26,
      "text": "затеи просто сыпятся"
    },
    {
      "time": 61.26,
      "end": 61.7,
      "text": "в хлам"
    },
    {
      "time": 64.52,
      "end": 66.52,
      "text": "Куплю себе звезду"
    },
    {
      "time": 66.52,
      "end": 68.02,
      "text": "шерифа в Мичигане"
    },
    {
      "time": 68.02,
      "end": 70.16,
      "text": "Ханда, Тремениган, мы"
    },
    {
      "time": 70.16,
      "end": 71.5,
      "text": "негров кочегарим"
    },
    {
      "time": 71.5,
      "end": 73.46,
      "text": "Звезда Давида по"
    },
    {
      "time": 73.46,
      "end": 74.88,
      "text": "пустыне кочевала"
    },
    {
      "time": 74.88,
      "end": 76.68,
      "text": "Шалава на этой"
    },
    {
      "time": 76.68,
      "end": 77.42,
      "text": "тропхатя"
    },
    {
      "time": 77.42,
      "end": 79.78,
      "text": "Сегодня ночевала, делаем"
    },
    {
      "time": 79.78,
      "end": 80.92,
      "text": "только кочево"
    },
    {
      "time": 80.92,
      "end": 82.72,
      "text": "Начался отчет досудного"
    },
    {
      "time": 82.72,
      "end": 83.5,
      "text": "денечка"
    },
    {
      "time": 83.5,
      "end": 85.06,
      "text": "Мы сидим в"
    },
    {
      "time": 85.06,
      "end": 86.58,
      "text": "подъезде на карточках"
    },
    {
      "time": 86.61,
      "end": 88.55,
      "text": "Менту не беру,"
    },
    {
      "time": 88.67,
      "end": 89.87,
      "text": "у неба фальшивка"
    },
    {
      "time": 89.87,
      "end": 90.49,
      "text": "корочка"
    },
    {
      "time": 90.49,
      "end": 91.75,
      "text": "На целый не"
    },
    {
      "time": 91.75,
      "end": 92.47,
      "text": "хватает"
    },
    {
      "time": 92.47,
      "end": 94.55,
      "text": "Замутили полочку, ты"
    },
    {
      "time": 94.55,
      "end": 95.81,
      "text": "как ебаный крот"
    },
    {
      "time": 95.81,
      "end": 97.33,
      "text": "Но увели твою"
    },
    {
      "time": 97.33,
      "end": 98.21,
      "text": "дерьмовочку"
    },
    {
      "time": 98.72,
      "end": 100.3,
      "text": "Твой рэп такой"
    },
    {
      "time": 100.3,
      "end": 102.08,
      "text": "смешной, как анекдот"
    },
    {
      "time": 102.08,
      "end": 102.84,
      "text": "-рабовочку"
    },
    {
      "time": 102.84,
      "end": 104.46,
      "text": "Проверил твои факты,"
    },
    {
      "time": 104.68,
      "end": 106.82,
      "text": "получилась нестыковочка"
    },
    {
      "time": 106.82,
      "end": 108.06,
      "text": "Во мне шизы"
    },
    {
      "time": 108.06,
      "end": 109.6,
      "text": "побольше, чем у"
    },
    {
      "time": 109.6,
      "end": 110.94,
      "text": "цинка папы бочи"
    },
    {
      "time": 110.94,
      "end": 112.08,
      "text": "Ты с рэпом"
    },
    {
      "time": 112.08,
      "end": 113.56,
      "text": "слишком ласков, надо"
    },
    {
      "time": 113.56,
      "end": 114.76,
      "text": "ебать пожестче"
    },
    {
      "time": 114.76,
      "end": 116.68,
      "text": "Ты дохуя навязчивый"
    },
    {
      "time": 116.68,
      "end": 118.42,
      "text": "или пизда настойчивый"
    },
    {
      "time": 118.42,
      "end": 119.44,
      "text": "Я зачитал на"
    },
    {
      "time": 119.44,
      "end": 120.96,
      "text": "мужика, ты зачитал"
    },
    {
      "time": 120.96,
      "end": 121.72,
      "text": "на сочного"
    },
    {
      "time": 121.72,
      "end": 123.32,
      "text": "Андать растелить стихи,"
    },
    {
      "time": 123.5,
