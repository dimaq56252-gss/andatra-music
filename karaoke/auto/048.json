      "time": 100.86,
      "end": 102.76,
      "text": "этих бетах вывожу,"
    },
    {
      "time": 103.28,
      "end": 103.78,
      "text": "и я где"
    },
    {
      "time": 103.78,
      "end": 104.46,
      "text": "-то сижу"
    },
    {
      "time": 104.46,
      "end": 105.96,
      "text": "Я скажу тебе,"
    },
    {
      "time": 106.64,
      "end": 108.64,
      "text": "просто почитаю без"
    },
    {
      "time": 108.64,
      "end": 110.86,
      "text": "какого -то куража"
    },
    {
      "time": 110.86,
      "end": 112.56,
      "text": "У меня будет"
    },
    {
      "time": 112.56,
      "end": 114.0,
      "text": "какой -то вояж"
    },
    {
      "time": 114.0,
      "end": 115.12,
      "text": "Это не будет"
    },
    {
      "time": 115.12,
      "end": 116.16,
      "text": "какой -то для"
    },
    {
      "time": 116.16,
      "end": 116.6,
      "text": "тебя"
    },
    {
      "time": 116.6,
      "end": 118.34,
      "text": "Сумасшедший мираж"
    },
    {
      "time": 118.34,
      "end": 119.42,
      "text": "Не попадет и"
    },
    {
      "time": 119.42,
      "end": 119.98,
      "text": "в кураж"
    },
    {
      "time": 119.98,
      "end": 121.14,
      "text": "Для тебя я"
    },
    {
      "time": 121.14,
      "end": 121.58,
      "text": "окраш"
    },
    {
      "time": 121.58,
      "end": 123.32,
      "text": "Ты меня извини"
    },
    {
      "time": 123.32,
      "end": 125.66,
      "text": "Просто если что"
    },
    {
      "time": 125.66,
      "end": 126.14,
      "text": "-то в жизни"
    },
    {
      "time": 126.14,
      "end": 126.98,
      "text": "служилось"
    },
    {
      "time": 126.98,
      "end": 128.04,
      "text": "Ну как бы"
    },
    {
      "time": 128.04,
      "end": 130.28,
      "text": "Я не туда"
    },
    {
      "time": 130.28,
      "end": 131.34,
      "text": "залетел"
    },
    {
      "time": 131.34,
      "end": 132.08,
      "text": "Мне к тебе"
    },
    {
      "time": 132.08,
      "end": 133.04,
      "text": "и в твою"
    },
    {
      "time": 133.04,
      "end": 133.92,
      "text": "каретку"
    },
    {
      "time": 133.92,
      "end": 135.62,
      "text": "Не надо ебать"
    },
    {
      "time": 135.62,
      "end": 137.22,
      "text": "эту тетюлитку"
    },
    {
      "time": 137.22,
      "end": 138.1,
      "text": "Мне не важно"
    },
    {
      "time": 138.1,
      "end": 140.24,
      "text": "Я влетаю в"
    },
    {
      "time": 140.24,
      "end": 140.86,
      "text": "этот бит, как"
    },
    {
      "time": 140.86,
      "end": 142.36,
      "text": "самолётик бумажный"
    },
    {
      "time": 142.36,
      "end": 144.7,
      "text": "Пацаны угорают, ничего"
    },
    {
      "time": 144.7,
      "end": 145.82,
      "text": "не стесняюсь"
    },
    {
      "time": 145.82,
      "end": 147.48,
      "text": "Я просто живу"
    },
    {
      "time": 147.48,
      "end": 148.62,
      "text": "и никак не"
    },
    {
      "time": 148.62,
      "end": 149.52,
      "text": "напрягаюсь"
    },
    {
      "time": 149.52,
      "end": 151.82,
      "text": "Неремножко на битте"
    },
    {
      "time": 151.82,
      "end": 153.56,
      "text": "я качаюсь, раздаю,"
    },
    {
      "time": 153.66,
      "end": 154.36,
      "text": "как могу"
    },
    {
      "time": 154.36,
      "end": 156.18,
      "text": "Под этот бит,"
    },
    {
      "time": 156.24,
      "end": 157.26,
      "text": "как по куэта,"
    },
    {
      "time": 157.72,
      "end": 159.24,
      "text": "сраную курагу"
    },
    {
      "time": 159.24,
      "end": 161.68,
      "text": "Влетаю, залетаю, я"
    },
    {
      "time": 161.68,
      "end": 162.92,
      "text": "этого хочу"
    },
    {
      "time": 162.92,
      "end": 164.9,
      "text": "Он закончился, но"
    },
    {
      "time": 164.9,
      "end": 166.08,
      "text": "я не молчу"
    },
    {
      "time": 166.08,
      "end": 168.78,
      "text": "Серия Андатры наносит"
    },
    {
      "time": 168.78,
      "end": 169.52,
      "text": "свой удар"
    },
    {
      "time": 169.52,
      "end": 172.06,
      "text": "Читать приколдессы, это"
    },
    {
      "time": 172.06,
      "end": 172.9,
      "text": "мой дар"
    },
    {
      "time": 172.9,
      "end": 174.08,
      "text": "Ты был когда"
    },
    {
      "time": 174.08,
      "end": 175.3,
      "text": "-то нужен, тебя"
    },
    {
      "time": 175.3,
      "end": 176.62,
      "text": "списали, ты бура"
    },
    {
      "time": 176.62,
      "end": 178.16,
      "text": "На русском мотоцикле"
    },
    {
      "time": 178.16,
      "end": 179.2,
      "text": "еду за горе"
    },
    {
      "time": 179.2,
      "end": 180.02,
      "text": "уральские"
    },
    {
      "time": 180.02,
      "end": 181.22,
      "text": "Каждый день, как"
    },
    {
      "time": 181.22,
      "end": 182.7,
      "text": "Новый год, огни"
    },
    {
      "time": 182.7,
      "end": 183.42,
      "text": "бенгальские"
    },
    {
      "time": 183.42,
      "end": 184.78,
      "text": "Не поменяю свой"
    },
    {
      "time": 184.78,
      "end": 185.6,
      "text": "рэпчик, как в"
    },
    {
      "time": 185.6,
      "end": 186.7,
      "text": "офертюре масла"
    },
    {
      "time": 186.7,
      "end": 188.48,
      "text": "Теперь собрался пазл,"
    },
    {
      "time": 188.8,
      "end": 190.04,
      "text": "Андатры создана для"
    },
    {
      "time": 190.04,
      "end": 190.5,
      "text": "хасла"
    },
    {
      "time": 190.5,
      "end": 191.92,
      "text": "Ебашу до отказа,"
    },
    {
      "time": 192.1,
      "end": 192.96,
      "text": "пизда в долгах"
    },
    {
      "time": 192.96,
      "end": 193.6,
      "text": "повязла"
    },
    {
      "time": 193.6,
      "end": 195.06,
      "text": "Моей повязку на"
    },
    {
      "time": 195.06,
      "end": 196.34,
      "text": "глаза, я сижу"
    },
    {
      "time": 196.34,
      "end": 197.06,
      "text": "в телеге"
    },
    {
      "time": 197.06,
      "end": 198.1,
      "text": "А ты сидишь"
    },
    {
      "time": 198.1,
      "end": 199.18,
      "text": "в повозке, на"
    },
    {
      "time": 199.18,
      "end": 200.48,
      "text": "адике полоске"
    },
    {
      "time": 200.48,
      "end": 201.56,
      "text": "Мы пьем сачок"
    },
    {
      "time": 201.56,
      "end": 202.74,
      "text": "с березки, тебя"
    },
    {
      "time": 202.74,
      "end": 204.06,
      "text": "назвали пидором"
    },
    {
      "time": 204.06,
      "end": 205.18,
      "text": "Тогда Алблак твой"
    },
    {
      "time": 205.18,
      "end": 207.06,
      "text": "тезка, твои подруги"
    },
    {
      "time": 207.06,
      "end": 207.78,
      "text": "плоские"
    },
    {
      "time": 207.78,
      "end": 209.48,
      "text": "Зову их доски,"
    },
    {
      "time": 210.22,
      "end": 212.06,
      "text": "мои братишки накурились"
    },
    {
      "time": 212.06,
      "end": 213.86,
      "text": "Сидят в киоске,"
    },
    {
      "time": 214.46,
      "end": 215.02,
      "text": "на мне сейчас"
    },
    {
      "time": 215.02,
      "end": 216.06,
      "text": "рваные носки"
    },
    {
      "time": 216.06,
      "end": 216.72,
      "text": "Я на тебе"
    },
    {
      "time": 216.72,
      "end": 218.68,
      "text": "обноски, чтобы не"
    },
    {
      "time": 218.68,
      "end": 219.38,
      "text": "замерзла"
    },
    {
      "time": 219.38,
      "end": 221.08,
      "text": "Залил тебя горячим"
    },
    {
      "time": 221.08,
      "end": 221.68,
      "text": "доском"
    },
    {
      "time": 221.68,
      "end": 224.46,
      "text": "Вооруженная толпа андатра,"
    },
    {
      "time": 224.76,
      "end": 225.38,
      "text": "это войско"
    },
    {
      "time": 225.38,
      "end": 226.64,
      "text": "Пади под мостик,"
    },
    {
      "time": 226.7,
      "end": 228.14,
      "text": "дружбусь, ты дарас"
    },
    {
      "time": 228.14,
      "end": 228.82,
      "text": "ковбойский"
    },
    {
      "time": 228.82,
      "end": 229.88,
      "text": "Со мной Диман"
    },
    {
      "time": 229.88,
      "end": 231.08,
      "text": "Адроскин, с тобой"
    },
    {
      "time": 231.08,
      "end": 232.22,
      "text": "четыре мостки"
    },
    {
      "time": 232.22,
      "end": 233.24,
      "text": "Мы не хотим"
    },
    {
      "time": 233.24,
      "end": 235.14,
      "text": "стреляться, мы наблюдаем,"
    },
    {
      "time": 235.26,
      "end": 235.8,
      "text": "как космос"
    },
    {
      "time": 235.8,
      "end": 237.46,
      "text": "Кручу рыпасик, нахую,"
    },
    {
      "time": 237.66,
      "end": 239.1,
      "text": "как крутятся колеса"
    },
    {
      "time": 239.1,
      "end": 240.88,
      "text": "Моя малышка побрита,"
    },
    {
      "time": 241.06,
      "end": 242.26,
      "text": "твоя с начосом"
    },
    {
      "time": 242.26,
      "end": 244.22,
      "text": "Мечтаю быть калугой"
    },
    {
      "time": 244.22,
      "end": 245.98,
      "text": "или крюецким осом"
    },
    {
      "time": 245.98,
      "end": 247.78,
      "text": "Ты маленький паровозик,"
    },
    {
      "time": 247.82,
      "end": 248.66,
      "text": "а я кунул"
    },
    {
      "time": 248.66,
      "end": 249.56,
      "text": "паровозом"
    },
    {
      "time": 249.56,
      "end": 251.48,
      "text": "Заболел рпасем, а"
    },
    {
      "time": 251.48,
      "end": 252.78,
      "text": "ты туберкулезом"
    },
    {
      "time": 252.78,
      "end": 253.76,
      "text": "Я как герой"
    },
    {
      "time": 253.76,
      "end": 255.02,
      "text": "матросов, а ты"
    },
    {
      "time": 255.02,
      "end": 256.24,
      "text": "сейчас под наркозом"
    },
    {
      "time": 256.24,
      "end": 257.52,
      "text": "Не буду читать"
    },
    {
      "time": 257.52,
      "end": 259.08,
      "text": "лучше, даже если"
    },
    {
      "time": 259.08,
      "end": 259.92,
      "text": "попросят"
    },
    {
      "time": 260.12,
      "end": 262.347755,
      "text": "♪ Фритюрное Масло"
    }
  ],
