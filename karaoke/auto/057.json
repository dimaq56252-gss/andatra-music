    },
    {
      "time": 103.64,
      "end": 104.92,
      "text": "Эта детка супер"
    },
    {
      "time": 104.92,
      "end": 106.06,
      "text": "-бьюти, спасибо своей"
    },
    {
      "time": 106.06,
      "end": 107.36,
      "text": "гуи моему бате"
    },
    {
      "time": 107.36,
      "end": 108.66,
      "text": "Ща в тумане"
    },
    {
      "time": 108.66,
      "end": 109.44,
      "text": "в моем хате,"
    },
    {
      "time": 109.64,
      "end": 110.46,
      "text": "эти броки в"
    },
    {
      "time": 110.46,
      "end": 110.98,
      "text": "бумате"
    },
    {
      "time": 110.98,
      "end": 112.0,
      "text": "Пять патронов в"
    },
    {
      "time": 112.0,
      "end": 113.4,
      "text": "автомате, ебу эту"
    },
    {
      "time": 113.4,
      "end": 114.28,
      "text": "суку в фате"
    },
    {
      "time": 114.28,
      "end": 115.6,
      "text": "Занял у тети"
    },
    {
      "time": 115.6,
      "end": 116.66,
      "text": "на пиво, мечта"
    },
    {
      "time": 116.66,
      "end": 117.7,
      "text": "о пулемете на"
    },
    {
      "time": 117.7,
      "end": 118.14,
      "text": "тачке"
    },
    {
      "time": 118.14,
      "end": 119.2,
      "text": "Я делаю пачки,"
    },
    {
      "time": 119.32,
      "end": 119.88,
      "text": "со мной мои"
    },
    {
      "time": 119.88,
      "end": 120.8,
      "text": "братья качки"
    },
    {
      "time": 120.8,
      "end": 121.56,
      "text": "У них очень"
    },
    {
      "time": 121.56,
      "end": 122.86,
      "text": "красные зрачки, нам"
    },
    {
      "time": 122.86,
      "end": 123.9,
      "text": "хотелось бы сейчас"
    },
    {
      "time": 123.9,
      "end": 124.52,
      "text": "жрачки"
    },
    {
      "time": 124.52,
      "end": 126.14,
      "text": "Замутил, блядь, криминала"
    },
    {
      "time": 126.14,
      "end": 126.88,
      "text": "для Аллы"
    },
    {
      "time": 126.88,
      "end": 127.98,
      "text": "Навалил ей на"
    },
    {
      "time": 127.98,
      "end": 128.68,
      "text": "пьедестал"
    },
    {
      "time": 128.68,
      "end": 129.56,
      "text": "Хавой"
    },
    {
      "time": 129.56,
      "end": 131.84,
      "text": "Хава, Нагила, Гуф"
    },
    {
      "time": 131.94,
      "end": 134.0,
      "text": "Респект, шалом всем"
    },
    {
      "time": 134.0,
      "end": 134.54,
      "text": "нашим"
    },
    {
      "time": 134.54,
      "end": 137.36,
      "text": "За Москворечье"
    },
    {
      "time": 137.36,
      "end": 138.62,
      "text": "Я варил коза"
    },
    {
      "time": 138.62,
      "end": 139.1,
      "text": "речки"
    },
    {
      "time": 139.1,
      "end": 141.1,
      "text": "Братан, мы тусуем"
    },
    {
      "time": 141.1,
      "end": 141.78,
      "text": "на речке"
    },
    {
      "time": 141.78,
      "end": 143.1,
      "text": "Братуха стал мое"
    },
    {
      "time": 143.1,
      "end": 144.5,
      "text": "Это серия андатры"
    },
    {
      "time": 144.5,
      "end": 145.44,
      "text": "Мы удараем с"
    },
    {
      "time": 145.44,
      "end": 146.02,
      "text": "пацанами"
    },
    {
      "time": 146.02,
      "end": 146.84,
      "text": "Калян сейчас может"
    },
    {
      "time": 146.84,
      "end": 147.76,
      "text": "застелить с нами"
    },
    {
      "time": 147.76,
      "end": 149.04,
      "text": "Это Кили Вилли"
    },
    {
      "time": 149.04,
      "end": 150.9,
      "text": "Продакшн, нам похуй"
    },
    {
      "time": 150.9,
      "end": 152.52,
      "text": "Контора андеграунд"
    },
    {
