      "end": 266.63,
      "text": "смесь"
    },
    {
      "time": 266.63,
      "end": 267.37,
      "text": "Чужих все нет,"
    },
    {
      "time": 267.51,
      "end": 268.61,
      "text": "печатки порог внутри"
    },
    {
      "time": 268.61,
      "end": 269.37,
      "text": "слишком гадки"
    },
    {
      "time": 269.37,
      "end": 270.71,
      "text": "Я беру перчатки,"
    },
    {
      "time": 270.99,
      "end": 272.05,
      "text": "зарываю грядки"
    },
    {
      "time": 272.05,
      "end": 273.23,
      "text": "Мертвых блеск огней"
    },
    {
      "time": 273.23,
      "end": 274.13,
      "text": "из чужих далеких"
    },
    {
      "time": 274.13,
      "end": 274.57,
      "text": "планет"
    },
    {
      "time": 274.57,
      "end": 275.89,
      "text": "Хочу поймать быстрей,"
    },
    {
      "time": 276.09,
      "end": 276.77,
      "text": "в портале ждет"
    },
    {
      "time": 276.77,
      "end": 277.19,
      "text": "амулет"
    },
    {
      "time": 277.19,
      "end": 278.19,
      "text": "В портале несколько"
    },
    {
      "time": 278.19,
      "end": 279.55,
      "text": "лет, не включается"
    },
    {
      "time": 279.55,
      "end": 279.91,
      "text": "свет"
    },
    {
      "time": 279.91,
      "end": 281.31,
      "text": "Выжить не помогает,"
    },
    {
      "time": 281.37,
      "end": 282.55,
      "text": "даже холодный рассвет"
    },
    {
      "time": 282.55,
      "end": 283.71,
      "text": "В городе мертвом"
    },
    {
      "time": 283.71,
      "end": 284.45,
      "text": "том, не будешь"
    },
    {
      "time": 284.45,
      "end": 285.13,
      "text": "жизнью потом"
    },
    {
      "time": 285.13,
      "end": 286.67,
      "text": "Стар своим коршун,"
    },
    {
      "time": 286.83,
      "end": 287.97,
      "text": "машет чёрным крылом"
    },
    {
      "time": 287.97,
      "end": 289.25,
      "text": "Дома покрылись огнём,"
    },
    {
      "time": 289.37,
      "end": 290.17,
      "text": "их не потушишь"
    },
    {
      "time": 290.17,
      "end": 290.57,
      "text": "дождём"
    },
    {
      "time": 290.57,
      "end": 291.31,
      "text": "То счастья мы"
    },
    {
      "time": 291.31,
      "end": 292.23,
      "text": "не найдём, в"
    },
    {
      "time": 292.23,
      "end": 293.21,
      "text": "горизонт свой пойдём"
    },
    {
      "time": 293.21,
      "end": 294.33,
      "text": "Истины, может, не"
    },
    {
      "time": 294.33,
      "end": 295.23,
      "text": "найдём, стоя под"
    },
    {
      "time": 295.23,
      "end": 295.99,
      "text": "огненным дождём"
    },
    {
      "time": 295.99,
      "end": 296.81,
      "text": "В этом мире"
    },
    {
      "time": 296.81,
      "end": 297.99,
      "text": "безумном точно не"
    },
    {
      "time": 297.99,
      "end": 298.71,
      "text": "пропадём"
    },
    {
      "time": 300.4,
      "end": 304.32,
      "text": "Ебать, колотить, кошмарить"
    },
    {
