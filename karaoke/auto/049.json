      "end": 122.68,
      "text": "не подойду"
    },
    {
      "time": 122.68,
      "end": 123.84,
      "text": "Это топлив нашим"
    },
    {
      "time": 123.84,
      "end": 124.9,
      "text": "крю, я читаю,"
    },
    {
      "time": 124.94,
      "end": 125.56,
      "text": "не пою"
    },
    {
      "time": 125.56,
      "end": 126.38,
      "text": "Я на трапе"
    },
    {
      "time": 126.38,
      "end": 127.44,
      "text": "на коне, большой"
    },
    {
      "time": 127.44,
      "end": 128.2,
      "text": "зав сидит на"
    },
    {
      "time": 128.2,
      "end": 128.38,
      "text": "мне"
    },
    {
      "time": 128.38,
      "end": 129.42,
      "text": "Сучка рядом, я"
    },
    {
