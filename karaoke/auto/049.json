  "cues": [
    {
      "time": 1.23,
      "end": 2.11,
      "text": "В общем, чтобы"
    },
    {
      "time": 2.11,
      "end": 2.89,
      "text": "у тебя мыслей"
    },
    {
      "time": 2.89,
      "end": 4.25,
      "text": "больше не возникало,"
    },
    {
      "time": 5.4,
      "end": 6.62,
      "text": "людей в багажнике"
    },
    {
      "time": 6.62,
      "end": 7.04,
      "text": "возить."
    },
    {
      "time": 7.72,
      "end": 8.46,
      "text": "Тачку я у"
    },
    {
      "time": 8.46,
      "end": 9.26,
      "text": "тебя забираю."
    },
    {
      "time": 11.66,
      "end": 12.94,
      "text": "Пригласили на званный"
    },
    {
      "time": 12.94,
      "end": 14.14,
      "text": "ужин, кишка вылезла"
    },
    {
      "time": 14.14,
      "end": 14.64,
      "text": "наружу."
    },
    {
      "time": 14.78,
      "end": 15.72,
      "text": "Хотел всегда быть"
    },
    {
      "time": 15.72,
      "end": 16.8,
      "text": "примерным ужин, как"
    },
    {
      "time": 16.8,
      "end": 17.38,
      "text": "алмаря."
    },
    {
      "time": 17.58,
      "end": 18.96,
      "text": "Дурака валяем, стоим"
    },
    {
      "time": 18.96,
      "end": 19.66,
      "text": "на голове."
    },
    {
      "time": 20.0,
      "end": 21.62,
      "text": "Чужие половые губы"
    },
    {
      "time": 21.62,
      "end": 22.64,
      "text": "тебя ласкают."
    },
    {
      "time": 22.88,
      "end": 24.3,
      "text": "Болеем за скакобарск."
    },
    {
      "time": 24.48,
      "end": 25.28,
      "text": "Будем считать, что"
    },
    {
      "time": 25.28,
      "end": 26.36,
      "text": "знакомство с татарами"
    },
    {
      "time": 26.36,
      "end": 27.12,
      "text": "состоялось."
    },
    {
      "time": 27.28,
      "end": 28.08,
      "text": "Я в нетрезвом"
    },
    {
      "time": 28.08,
      "end": 28.94,
      "text": "состоянии."
    },
    {
      "time": 29.24,
      "end": 30.84,
      "text": "Газпром наше достояние."
    },
    {
      "time": 30.84,
      "end": 32.12,
      "text": "Читаем сей андатрей,"
    },
    {
      "time": 32.42,
      "end": 33.12,
      "text": "я на этом"
    },
    {
      "time": 33.12,
      "end": 33.82,
      "text": "настоял"
    },
    {
      "time": 33.82,
      "end": 35.38,
      "text": "Как цветочки в"
    },
    {
      "time": 35.38,
      "end": 36.22,
      "text": "Азии, утром мой"
    },
    {
      "time": 36.22,
      "end": 36.74,
      "text": "стояк"
    },
    {
      "time": 36.74,
      "end": 38.32,
      "text": "Кельвили вожак стаи,"
    },
    {
      "time": 38.36,
      "end": 39.26,
      "text": "бил ногами за"
    },
    {
      "time": 39.26,
      "end": 40.22,
      "text": "хуёвый парт"
    },
    {
      "time": 40.22,
      "end": 41.46,
      "text": "Макана ждём на"
    },
    {
      "time": 41.46,
      "end": 42.18,
      "text": "дембель, он наш"
    },
    {
      "time": 42.18,
      "end": 42.84,
      "text": "братский брат"
    },
    {
      "time": 42.84,
      "end": 44.22,
      "text": "Давно не виделись,"
    },
    {
      "time": 44.54,
      "end": 45.12,
      "text": "хули ты не"
    },
    {
      "time": 45.12,
      "end": 45.58,
      "text": "рад мне"
    },
    {
      "time": 45.58,
      "end": 46.6,
      "text": "В ГТА сам"
    },
    {
      "time": 46.6,
      "end": 47.76,
      "text": "на сервере пусто"
    },
    {
      "time": 47.76,
      "end": 48.52,
      "text": "В том году"
    },
    {
      "time": 48.52,
      "end": 49.62,
      "text": "записали трек про"
    },
    {
      "time": 49.62,
      "end": 50.1,
      "text": "мангуста"
    },
    {
      "time": 50.1,
      "end": 51.06,
      "text": "У астронавта из"
    },
    {
      "time": 51.06,
      "end": 53.02,
      "text": "нас проблемы, сообщает"
    },
    {
      "time": 53.02,
      "end": 53.56,
      "text": "Хьюстон"
    },
    {
      "time": 53.56,
      "end": 55.18,
      "text": "Заебался делать биты"
    },
    {
      "time": 55.18,
      "end": 56.48,
      "text": "мне, Джонатан Русский"
    },
    {
      "time": 56.48,
      "end": 58.42,
      "text": "Закуска гранёт граду,"
    },
    {
      "time": 58.5,
      "end": 59.58,
      "text": "сказал мне Мишаня"
    },
    {
      "time": 59.58,
      "end": 60.28,
      "text": "Он же с"
    },
    {
      "time": 60.28,
      "end": 61.32,
      "text": "куфра жил дохуя"
    },
    {
      "time": 61.32,
      "end": 62.62,
      "text": "Он теми шарит"
    },
    {
      "time": 62.62,
      "end": 63.86,
      "text": "на большом воздушном"
    },
    {
      "time": 63.86,
      "end": 64.28,
      "text": "шаре"
    },
    {
      "time": 64.28,
      "end": 65.94,
      "text": "Мандаринового цвета"
    },
    {
      "time": 65.94,
      "end": 67.14,
      "text": "В столовой празднует"
    },
    {
      "time": 67.14,
      "end": 68.48,
      "text": "день рождения повариха"
    },
    {
      "time": 68.48,
      "end": 68.84,
      "text": "света"
    },
    {
      "time": 68.84,
      "end": 70.58,
      "text": "Поздравьте ее, она"
    },
    {
      "time": 70.58,
      "end": 71.6,
      "text": "ебет и кормит"
    },
    {
      "time": 71.6,
      "end": 72.84,
      "text": "Как андатра"
    },
    {
      "time": 74.33,
      "end": 75.79,
      "text": "Андатра ебет и"
    },
    {
      "time": 75.79,
      "end": 77.75,
      "text": "кормит, блядь"
    },
    {
      "time": 79.2,
      "end": 80.68,
      "text": "Не кричи в"
    },
    {
      "time": 80.68,
      "end": 82.24,
      "text": "пустоту, кричи в"
    },
    {
      "time": 82.24,
      "end": 82.8,
      "text": "микрофон"
    },
    {
      "time": 82.8,
      "end": 83.82,
      "text": "Но в полете"
    },
    {
      "time": 83.82,
      "end": 85.28,
      "text": "отключен домофон"
    },
    {
      "time": 85.28,
      "end": 86.68,
      "text": "Под маурикой дважды"
    },
    {
      "time": 86.68,
      "end": 87.48,
      "text": "не заходит"
    },
    {
      "time": 87.48,
      "end": 88.3,
      "text": "Но и не"
    },
    {
      "time": 88.3,
      "end": 89.08,
      "text": "в себе прикол,"
    },
    {
      "time": 89.18,
      "end": 90.78,
      "text": "устроим скандал, сделаем"
    },
    {
      "time": 90.78,
      "end": 91.62,
      "text": "еще прокол"
    },
    {
      "time": 91.62,
      "end": 92.4,
      "text": "Есть чуть лапнуть"
    },
    {
      "time": 92.4,
      "end": 93.54,
      "text": "гляд смелости, без"
    },
    {
      "time": 93.54,
      "end": 94.24,
      "text": "лишних слов и"
    },
    {
      "time": 94.24,
      "end": 95.2,
      "text": "нет нечестностей"
    },
    {
      "time": 95.2,
      "end": 96.02,
      "text": "Я играл в"
    },
    {
      "time": 96.02,
      "end": 97.04,
      "text": "игру с пустотой"
    },
    {
      "time": 97.04,
      "end": 97.8,
      "text": "и залез в"
    },
