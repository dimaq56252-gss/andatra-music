    {
      "time": 51.56,
      "end": 52.66,
      "text": "Хотел он просто"
    },
    {
      "time": 52.66,
      "end": 53.86,
      "text": "влететь, ее в"
    },
    {
      "time": 53.86,
      "end": 54.9,
      "text": "жизнь сделать лучше"
    },
    {
      "time": 54.9,
      "end": 56.34,
      "text": "Осталось грустно смотреть,"
    },
    {
      "time": 56.52,
