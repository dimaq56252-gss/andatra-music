    },
    {
      "time": 93.1,
      "end": 93.62,
      "text": "Оля"
    },
    {
      "time": 93.62,
      "end": 95.6,
      "text": "Королевский хит, позволь"
    },
    {
      "time": 95.6,
      "end": 96.72,
      "text": "мне сделать это"
    },
    {
      "time": 96.72,
      "end": 97.78,
      "text": "Беда с башкой"
    },
    {
      "time": 97.78,
      "end": 98.3,
      "text": "от рэпа"
    },
    {
      "time": 98.3,
      "end": 100.08,
      "text": "Наезд русский конкретный"
    },
    {
      "time": 100.08,
      "end": 101.0,
      "text": "убрал конкурента"
    },
    {
      "time": 101.0,
