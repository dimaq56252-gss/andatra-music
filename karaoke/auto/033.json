      "text": "кто придет и"
    },
    {
      "time": 49.38,
      "end": 50.42,
      "text": "меня заменит"
    },
    {
      "time": 52.02,
      "end": 54.16,
      "text": "День поставил на"
    },
    {
      "time": 54.16,
      "end": 55.2,
      "text": "петлю, как суп"
    },
    {
      "time": 55.2,
      "end": 56.76,
      "text": "поставил на плиту"
    },
    {
      "time": 56.76,
      "end": 57.82,
      "text": "Ты ждешь меня,"
    },
    {
      "time": 57.84,
      "end": 59.0,
      "text": "я не триду,"
    },
    {
      "time": 59.12,
      "end": 60.68,
      "text": "чокеля там, давай"
    },
    {
      "time": 60.68,
