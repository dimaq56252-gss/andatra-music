    },
    {
      "time": 107.54,
      "end": 109.0,
      "text": "На столе гостиниц"
    },
    {
      "time": 109.0,
      "end": 111.2,
      "text": "Посуду моет кубинец"
    },
    {
      "time": 111.2,
      "end": 113.06,
      "text": "Купили десяток яиц"
    },
    {
      "time": 113.06,
      "end": 114.36,
