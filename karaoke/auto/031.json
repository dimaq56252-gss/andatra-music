      "time": 62.35,
      "end": 63.17,
      "text": "Дэнсит, бэй"
    },
    {
      "time": 63.17,
      "end": 64.11,
      "text": "Под мою жопу"
    },
    {
      "time": 64.11,
      "end": 64.95,
      "text": "сейчас корлей"
    },
    {
      "time": 64.95,
      "end": 66.09,
      "text": "Хочу на карте"
    },
    {
      "time": 66.09,
      "end": 66.93,
      "text": "шесть нулей"
    },
    {
      "time": 66.93,
      "end": 67.73,
      "text": "Бич, мне не"
    },
    {
      "time": 67.73,
      "end": 68.89,
      "text": "надо сто глядей"
    },
    {
      "time": 68.89,
      "end": 70.05,
      "text": "От твоих трусиков"
    },
    {
      "time": 70.05,
      "end": 70.85,
      "text": "есть свой клей"
    },
    {
      "time": 70.85,
      "end": 71.89,
      "text": "Во мне таблетка"
    },
    {
      "time": 71.89,
      "end": 72.85,
      "text": "все окей"
    },
    {
      "time": 72.85,
      "end": 74.13,
      "text": "Тебя убила, на"
    },
    {
      "time": 74.13,
      "end": 74.71,
      "text": "попей"
    },
    {
      "time": 74.71,
      "end": 75.65,
      "text": "Едя на бал,"
    },
    {
      "time": 75.77,
      "end": 76.67,
      "text": "надень, бал, мэйн"
    },
    {
      "time": 76.67,
      "end": 77.51,
      "text": "Ведь я тот,"
    },
    {
      "time": 77.61,
      "end": 78.57,
      "text": "кто нужен ей"
    },
    {
      "time": 78.57,
      "end": 80.11,
      "text": "Один -единственный, буду"
    },
    {
      "time": 80.11,
      "end": 80.53,
      "text": "мэйн"
    },
    {
      "time": 80.53,
      "end": 81.35,
      "text": "Хоу, я хочу"
    },
    {
      "time": 81.35,
      "end": 82.33,
      "text": "от тебя детей"
    },
    {
      "time": 82.33,
      "end": 83.77,
      "text": "Опа, пиздят они"
    },
    {
      "time": 83.77,
      "end": 84.41,
      "text": "все лэйн"
    },
    {
      "time": 84.41,
      "end": 85.33,
      "text": "Сука, я злой,"
    },
    {
      "time": 85.39,
      "end": 86.37,
      "text": "зови меня бэйн"
    },
    {
      "time": 86.37,
      "end": 87.47,
      "text": "За меня топит"
    },
    {
      "time": 87.47,
      "end": 88.29,
      "text": "весь мой гэйн"
    },
    {
      "time": 88.29,
      "end": 88.91,
      "text": "Мы с моим"
    },
    {
      "time": 88.91,
      "end": 90.21,
      "text": "складом криклокбэйн"
    },
    {
      "time": 90.21,
      "end": 90.87,
      "text": "Мы с моим"
    },
    {
      "time": 90.87,
      "end": 92.19,
      "text": "плагом пушим свэйн"
    },
    {
      "time": 92.19,
      "end": 93.11,
      "text": "У меня жестко"
    },
    {
      "time": 93.11,
      "end": 94.71,
      "text": "прокаченный спект, дэйн"
    },
    {
      "time": 94.71,
      "end": 96.09,
      "text": "Еще не устал,"
    },
    {
      "time": 96.25,
      "end": 97.15,
      "text": "много работал, я"
    },
    {
      "time": 97.15,
      "end": 97.99,
      "text": "много читал"
    },
    {
      "time": 97.99,
      "end": 98.89,
      "text": "В третьи сутки"
    },
    {
      "time": 98.89,
      "end": 99.55,
      "text": "почти что не"
    },
    {
      "time": 99.55,
      "end": 99.89,
      "text": "спал"
    },
    {
      "time": 99.89,
      "end": 101.11,
      "text": "Голодный вампир, никого"
    },
    {
      "time": 101.11,
      "end": 101.77,
      "text": "не кусал"
    },
    {
      "time": 101.77,
      "end": 102.81,
      "text": "Буду любить, как"
    },
    {
      "time": 102.81,
      "end": 103.73,
      "text": "детей любят дрэйн"
    },
    {
      "time": 103.73,
      "end": 104.49,
      "text": "Сует, но ты"
    },
    {
      "time": 104.49,
      "end": 105.75,
      "text": "похуел, твой тейк"
    },
    {
      "time": 105.75,
      "end": 107.17,
      "text": "Купил сатаник, готовлю"
    },
    {
      "time": 107.17,
      "end": 107.53,
      "text": "омлет"
    },
    {
      "time": 107.53,
      "end": 108.79,
      "text": "Духу я прожитых"
    },
    {
      "time": 108.79,
      "end": 109.47,
      "text": "уже лет"
    },
    {
      "time": 109.47,
      "end": 110.93,
      "text": "Чёрный и глянцевый"
    },
    {
      "time": 110.93,
      "end": 111.43,
      "text": "палет"
    },
    {
      "time": 111.43,
      "end": 112.53,
      "text": "Я француз, мне"
    },
    {
      "time": 112.53,
      "end": 113.41,
      "text": "нужен багет"
    },
    {
      "time": 113.41,
      "end": 114.55,
      "text": "А моя тащит,"
    },
    {
      "time": 114.69,
      "end": 115.37,
      "text": "трущит свек"
    },
    {
      "time": 115.37,
      "end": 116.77,
      "text": "Моё дерьмо качает"
    },
    {
      "time": 116.77,
      "end": 117.25,
      "text": "букет"
    },
    {
      "time": 117.25,
      "end": 118.19,
      "text": "Чек -аут бит,"
    },
    {
      "time": 118.23,
      "end": 119.17,
      "text": "танцуй мне балет"
    },
    {
      "time": 119.17,
      "end": 120.71,
      "text": "Ты кривососка, сделай"
    },
    {
      "time": 120.71,
      "end": 121.15,
      "text": "миньет"
    },
    {
      "time": 121.15,
      "end": 122.19,
      "text": "Эти мне больно,"
    },
    {
      "time": 122.39,
      "end": 122.83,
      "text": "отдай мне свой"
    },
    {
      "time": 122.83,
      "end": 123.17,
      "text": "фейн"
    },
    {
      "time": 123.17,
      "end": 124.23,
      "text": "Ты очень мокрая,"
    },
    {
      "time": 124.35,
      "end": 125.19,
      "text": "буду рейн"
    },
    {
      "time": 125.19,
      "end": 126.51,
      "text": "Танцуй на мне,"
    },
    {
      "time": 126.67,
      "end": 127.93,
      "text": "танцуй на мне,"
    },
    {
      "time": 128.01,
      "end": 128.91,
      "text": "гори в огне"
    },
    {
      "time": 128.91,
      "end": 130.43,
      "text": "Танцуй на мне,"
    },
    {
      "time": 130.81,
      "end": 131.71,
      "text": "танцуй на мне,"
    },
    {
      "time": 131.91,
      "end": 132.61,
      "text": "как на плите"
    },
    {
      "time": 132.61,
      "end": 134.29,
      "text": "Танцуй на мне,"
    },
    {
      "time": 134.71,
      "end": 135.61,
      "text": "танцуй на мне,"
    },
    {
      "time": 135.69,
      "end": 136.71,
      "text": "танцуй на мне"
    },
    {
      "time": 136.71,
      "end": 138.07,
      "text": "Танцуй на мне,"
    },
    {
      "time": 138.35,
      "end": 140.15,
      "text": "мне, мне, мне"
    },
    {
      "time": 140.15,
      "end": 142.4,
      "text": "Мне мысля прилетела"
    },
    {
      "time": 142.4,
      "end": 143.18,
      "text": "прям в бошку"
    },
    {
      "time": 143.18,
      "end": 144.56,
      "text": "Подорвать всех, используя"
    },
    {
      "time": 144.56,
      "end": 145.14,
      "text": "бошки"
    },
    {
      "time": 145.14,
      "end": 146.36,
      "text": "Почему я проснулся"
    },
    {
      "time": 146.36,
      "end": 147.2,
      "text": "весь в порошке"
    },
    {
      "time": 147.2,
      "end": 148.08,
      "text": "С малышкой и"
    },
    {
      "time": 148.08,
      "end": 148.84,
      "text": "дымом в башке"
    },
    {
      "time": 148.84,
      "end": 150.88,
      "text": "Чиганата коломенский андер"
    },
    {
      "time": 150.88,
      "end": 151.98,
      "text": "Варим густо и"
    },
    {
      "time": 151.98,
      "end": 152.66,
      "text": "это пуэр"
    },
    {
      "time": 152.66,
      "end": 153.64,
      "text": "Достал свой хуй,"
    },
    {
      "time": 153.82,
      "end": 154.74,
      "text": "как револьвер"
    },
    {
      "time": 154.74,
      "end": 156.28,
      "text": "Предзови меня Шиловский"
    },
    {
      "time": 156.28,
      "end": 156.74,
      "text": "райдер"
    },
    {
      "time": 156.74,
      "end": 158.08,
      "text": "Моя пушка огромный"
    },
    {
      "time": 158.08,
      "end": 158.76,
      "text": "коллайдер"
    },
    {
      "time": 158.76,
      "end": 159.96,
      "text": "Сие ярко, словно"
    },
    {
      "time": 159.96,
      "end": 160.54,
      "text": "гирлянда"
    },
    {
      "time": 160.54,
      "end": 161.32,
      "text": "Я гуляю вверх"
    },
    {
      "time": 161.32,
      "end": 161.96,
      "text": "по сравнению с"
    },
    {
      "time": 161.96,
      "end": 162.6,
      "text": "колдайсом"
    },
    {
      "time": 162.6,
      "end": 163.64,
      "text": "Он работает ртом,"
    },
    {
      "time": 163.8,
      "end": 164.7,
      "text": "думая о прайсе"
    },
    {
      "time": 164.7,
      "end": 165.82,
      "text": "Еду на митсубиси,"
    },
    {
      "time": 165.86,
      "end": 166.72,
      "text": "еду на лайнс"
    },
    {
      "time": 166.72,
      "end": 167.7,
      "text": "Реиграю в доту,"
    },
    {
      "time": 167.82,
      "end": 168.88,
      "text": "играю на траксе"
    },
    {
      "time": 168.88,
      "end": 170.1,
      "text": "Вы все, блядищи,"
    },
    {
      "time": 170.18,
      "end": 171.36,
      "text": "стоите на трассе"
    },
    {
      "time": 171.36,
      "end": 172.96,
      "text": "Идём с парнями"
    },
    {
      "time": 172.96,
      "end": 174.04,
      "text": "купаться на газе"
    },
    {
      "time": 174.04,
      "end": 175.04,
      "text": "Просто так из"
    },
    {
      "time": 175.04,
      "end": 175.86,
      "text": "дома никто не"
    },
    {
      "time": 175.86,
      "end": 176.42,
      "text": "вылазит"
    },
    {
      "time": 176.42,
      "end": 177.74,
      "text": "Я квадратный, зови"
    },
    {
      "time": 177.74,
      "end": 178.52,
      "text": "меня фаздник"
    },
    {
      "time": 178.52,
      "end": 179.4,
      "text": "И скоро с"
    },
    {
      "time": 179.4,
      "end": 180.5,
      "text": "армейки вернётся наш"
    },
    {
      "time": 180.5,
      "end": 181.08,
      "text": "браздник"
    },
    {
      "time": 181.3,
      "end": 183.08,
      "text": "Браздник 65 дней"
    },
    {
      "time": 183.08,
      "end": 184.74,
      "text": "Я стою в"
    },
    {
      "time": 184.74,
      "end": 185.42,
      "text": "бубке, а сзади"
    },
    {
      "time": 185.42,
      "end": 186.42,
      "text": "Андрюха сидит и"
    },
    {
      "time": 186.42,
      "end": 187.22,
      "text": "пьёт пиво"
    },
    {
      "time": 187.51,
      "end": 189.11,
      "text": "Я разъебался не"
    },
    {
      "time": 189.11,
      "end": 189.67,
      "text": "по хуне"
    },
    {
      "time": 189.67,
      "end": 190.97,
      "text": "Пусуюсь на студии"
    },
    {
      "time": 190.97,
      "end": 191.75,
      "text": "каждый день"
    },
    {
      "time": 191.75,
      "end": 192.87,
      "text": "Ебашу рэп, как"
    },
    {
      "time": 192.87,
      "end": 193.61,
      "text": "старый пень"
    },
    {
      "time": 193.61,
      "end": 194.55,
      "text": "За вашу хуйню"
    },
    {
      "time": 194.55,
      "end": 195.33,
      "text": "ни одна будет"
    },
    {
      "time": 195.33,
      "end": 195.61,
      "text": "пень"
    },
    {
      "time": 195.61,
      "end": 196.77,
      "text": "Коломенский тупак, он"
    },
    {
      "time": 196.77,
      "end": 197.55,
      "text": "сука, гений"
    },
    {
      "time": 197.55,
      "end": 198.33,
      "text": "Не залетел на"
    },
    {
      "time": 198.33,
      "end": 198.95,
      "text": "бит, как гей"
    },
    {
      "time": 198.95,
      "end": 199.47,
      "text": "Сергей"
    },
    {
      "time": 199.47,
      "end": 200.61,
      "text": "Ебал рэперов, но"
    },
    {
      "time": 200.61,
      "end": 201.37,
      "text": "не матерей"
    },
    {
      "time": 201.37,
      "end": 202.73,
      "text": "Была мастачка, теперь"
    },
    {
      "time": 202.73,
      "end": 203.35,
      "text": "я отец"
    },
    {
      "time": 203.35,
      "end": 204.37,
      "text": "Андатры на месте,"
    },
    {
      "time": 204.39,
      "end": 205.23,
      "text": "тебе босс конец"
    },
    {
      "time": 205.23,
      "end": 206.05,
      "text": "Зафляк сел на"
    },
    {
      "time": 206.05,
      "end": 206.83,
      "text": "изи, как будто"
    },
    {
      "time": 206.83,
      "end": 207.27,
      "text": "юнец"
    },
    {
      "time": 207.27,
      "end": 208.33,
      "text": "Я люблю трепить,"
    },
    {
      "time": 208.41,
      "end": 209.15,
      "text": "ты любишь хуец"
    },
    {
      "time": 209.15,
      "end": 210.27,
      "text": "От моего рэпа"
    },
    {
      "time": 210.27,
      "end": 211.21,
      "text": "пазднуют лица"
    },
    {
      "time": 211.21,
      "end": 212.23,
      "text": "Я андриграунд, а"
    },
    {
      "time": 212.23,
      "end": 213.17,
      "text": "ваша хуйня фикса"
    },
    {
      "time": 213.17,
      "end": 214.05,
      "text": "Я люблю дуть,"
    },
    {
      "time": 214.11,
      "end": 215.09,
      "text": "ты любишь милицию"
    },
    {
      "time": 215.09,
      "end": 216.09,
      "text": "Пишусь под кайфом,"
    },
    {
      "time": 216.11,
      "end": 216.63,
      "text": "а ты под"
    },
    {
      "time": 216.63,
      "end": 216.97,
      "text": "кислом"
    },
    {
      "time": 216.97,
      "end": 217.99,
      "text": "Да, мы андатры,"
    },
    {
      "time": 218.01,
      "end": 218.51,
      "text": "но мы как"
    },
    {
      "time": 218.51,
      "end": 218.91,
      "text": "гризли"
    },
    {
      "time": 218.91,
      "end": 220.03,
      "text": "Все дают атаками,"
    },
    {
      "time": 220.25,
      "end": 220.63,
      "text": "а тата"
    },
    {
      "time": 220.63,
      "end": 221.55,
      "text": "Я с ровным"
    },
    {
      "time": 221.55,
      "end": 222.81,
      "text": "бегом над татами"
    },
    {
      "time": 222.81,
      "end": 223.65,
      "text": "С русскими бог,"
    },
    {
      "time": 223.75,
      "end": 224.27,
      "text": "а с богом"
    },
    {
      "time": 224.27,
      "end": 224.71,
      "text": "татары"
    },
    {
      "time": 224.71,
      "end": 225.63,
      "text": "Не делаю рэп,"
    },
    {
      "time": 225.73,
      "end": 226.65,
      "text": "я угораю"
    },
    {
      "time": 226.65,
      "end": 227.59,
      "text": "Мы только начали,"
    },
    {
      "time": 227.75,
      "end": 228.59,
      "text": "в самом разгаре"
    },
    {
      "time": 228.59,
      "end": 229.67,
      "text": "Твой отчим показался"
    },
    {
      "time": 229.67,
      "end": 230.47,
      "text": "на радаре"
    },
    {
      "time": 230.47,
      "end": 231.75,
      "text": "Работаю поваром, как"
    },
    {
      "time": 231.75,
      "end": 232.53,
      "text": "сойка чигаром"
    },
    {
      "time": 232.53,
      "end": 233.33,
      "text": "Мы делаем кач,"
    },
    {
      "time": 233.45,
      "end": 234.11,
      "text": "мы работали в"
    },
    {
      "time": 234.11,
      "end": 234.37,
      "text": "яре"
    },
    {
      "time": 234.37,
      "end": 235.37,
      "text": "Услышал этот бит"
    },
    {
      "time": 235.37,
      "end": 236.35,
      "text": "и меня разъебало"
    },
    {
      "time": 236.35,
      "end": 237.35,
      "text": "Я Астон Мартин,"
    },
    {
      "time": 237.41,
      "end": 238.15,
      "text": "а ты Ягуар"
    },
    {
      "time": 238.15,
      "end": 239.59,
      "text": "Леший сказал, хуйня"
    },
    {
      "time": 239.59,
      "end": 240.17,
      "text": "ваш товар"
    },
    {
      "time": 240.17,
      "end": 240.81,
      "text": "Да у меня"
    },
    {
      "time": 240.81,
      "end": 242.01,
      "text": "треков дохуя"
    },
    {
      "time": 242.01,
      "end": 243.07,
      "text": "Но не хватает"
    },
    {
      "time": 243.07,
      "end": 243.99,
      "text": "паучь по чутья"
    },
    {
