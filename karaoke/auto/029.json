  "cues": [
    {
      "time": 0.5,
      "end": 0.98,
      "text": "А?"
    },
    {
      "time": 2.93,
      "end": 3.65,
      "text": "Чё здесь?"
    },
    {
      "time": 3.79,
      "end": 4.21,
      "text": "А чё здесь"
    },
    {
      "time": 4.21,
      "end": 5.27,
      "text": "такое происходит -то,"
    },
    {
      "time": 5.27,
      "end": 5.57,
      "text": "ебать?"
    },
    {
      "time": 5.81,
      "end": 6.33,
      "text": "Андатра?"
    },
    {
      "time": 6.57,
      "end": 7.31,
      "text": "А, это мы!"
    },
    {
      "time": 8.18,
      "end": 9.08,
      "text": "Опять перестали?"
    },
    {
      "time": 9.24,
      "end": 9.48,
      "text": "А?"
    },
    {
      "time": 10.24,
      "end": 11.24,
      "text": "Чё -то хотели"
    },
    {
      "time": 11.24,
      "end": 12.24,
      "text": "почитать, кто будет"
    },
    {
      "time": 12.24,
      "end": 13.08,
      "text": "начинать, я хуй"
    },
    {
      "time": 13.08,
      "end": 13.44,
      "text": "знает."
    },
    {
      "time": 13.88,
      "end": 14.42,
      "text": "Не пиши мне,"
    },
    {
      "time": 14.5,
      "end": 15.08,
      "text": "не звони, я"
    },
    {
      "time": 15.08,
      "end": 15.46,
      "text": "занят."
    },
    {
      "time": 15.58,
      "end": 16.36,
      "text": "Мы не издари,"
    },
    {
      "time": 16.46,
      "end": 17.06,
      "text": "но мы вышли,"
    },
    {
      "time": 17.2,
      "end": 17.74,
      "text": "заебись."
    },
    {
      "time": 17.94,
      "end": 19.46,
      "text": "Тебе Максим Энцеркевич"
    },
    {
      "time": 19.46,
      "end": 21.26,
      "text": "предложил поцеловать пипиську."
    },
    {
      "time": 21.46,
      "end": 22.38,
      "text": "Не перевелись ещё"
    },
    {
      "time": 22.38,
      "end": 23.42,
      "text": "ритмиранной Руси."
    },
    {
      "time": 23.68,
      "end": 24.74,
      "text": "Ебать тебя будем,"
    },
    {
      "time": 24.88,
      "end": 25.74,
      "text": "давай снимай свои"
    },
    {
      "time": 25.74,
      "end": 26.26,
      "text": "трусы."
    },
    {
      "time": 26.64,
      "end": 28.7,
      "text": "Анальные бусы, отжимаемся"
    },
    {
      "time": 28.7,
      "end": 29.48,
      "text": "на брусьях."
    },
    {
      "time": 29.48,
      "end": 30.7,
      "text": "Тебя скупы на"
    },
    {
      "time": 30.7,
      "end": 31.8,
      "text": "битах опустят"
    },
    {
      "time": 31.8,
      "end": 33.08,
      "text": "Белые люди, как"
    },
    {
      "time": 33.08,
      "end": 33.62,
      "text": "снежок"
    },
    {
      "time": 33.62,
      "end": 34.72,
      "text": "Они под ногами"
    },
    {
      "time": 34.72,
      "end": 35.8,
      "text": "заебись хрустят"
    },
    {
      "time": 35.8,
      "end": 36.96,
      "text": "Я волка, вы"
    },
    {
      "time": 36.96,
      "end": 37.64,
      "text": "поросята"
    },
    {
      "time": 37.64,
      "end": 38.54,
      "text": "Я сдул ваш"
    },
    {
      "time": 38.54,
      "end": 39.68,
      "text": "дом из сена"
    },
    {
      "time": 39.68,
      "end": 41.16,
      "text": "Накорнил тебя своим"
    },
    {
      "time": 41.16,
      "end": 41.86,
      "text": "семенем"
    },
    {
      "time": 41.86,
      "end": 42.98,
      "text": "Очень хочу стать"
    },
    {
      "time": 42.98,
      "end": 43.78,
      "text": "новым мемом"
    },
    {
      "time": 43.78,
      "end": 45.0,
      "text": "Тебя наебал на"
    },
    {
      "time": 45.0,
      "end": 45.84,
      "text": "Гарик и Белый"
    },
    {
      "time": 45.84,
      "end": 47.26,
      "text": "Говно, говно, жопа"
    },
    {
      "time": 47.26,
      "end": 48.46,
      "text": "Я Руслан Белый"
    },
    {
      "time": 48.46,
      "end": 49.66,
      "text": "52 -й идет"
    },
    {
      "time": 49.66,
      "end": 50.18,
      "text": "нахуй"
    },
    {
      "time": 50.18,
      "end": 51.46,
      "text": "На месте 51"
    },
    {
      "time": 51.46,
      "end": 52.02,
      "text": "-й"
    },
    {
      "time": 52.02,
      "end": 53.4,
      "text": "Сегодня акция в"
    },
    {
      "time": 53.4,
      "end": 54.46,
      "text": "магазине Верном"
    },
    {
      "time": 54.46,
      "end": 56.12,
      "text": "Я такой жесткий"
    },
    {
      "time": 56.12,
      "end": 57.24,
      "text": "Меня вселился в"
    },
    {
      "time": 57.24,
      "end": 57.66,
      "text": "вином"
    },
    {
      "time": 57.66,
      "end": 59.18,
      "text": "Тебя ебали все"
    },
    {
      "time": 59.18,
      "end": 59.8,
      "text": "и андатры"
    },
    {
      "time": 59.8,
      "end": 61.18,
      "text": "Значит, тебя ебали"
    },
    {
      "time": 61.18,
      "end": 61.86,
      "text": "всемиром"
    },
    {
      "time": 61.86,
      "end": 62.68,
      "text": "Скинь мне на"
    },
    {
      "time": 62.68,
      "end": 63.2,
      "text": "флешку"
    },
    {
      "time": 63.2,
      "end": 64.04,
      "text": "А потом я"
    },
    {
      "time": 64.04,
      "end": 64.82,
      "text": "скину тебе на"
    },
    {
      "time": 64.82,
      "end": 65.38,
      "text": "CD -ROM"
    },
    {
      "time": 65.38,
      "end": 66.92,
      "text": "Наши треки все"
    },
    {
      "time": 67.68,
      "end": 68.32,
      "text": "Ай"
    },
    {
      "time": 69.04,
      "end": 70.2,
      "text": "Нахуй иди, блять"
    },
    {
      "time": 70.2,
      "end": 71.38,
      "text": "Похуй мне"
    },
    {
      "time": 72.12,
      "end": 73.38,
      "text": "Где есть реальность,"
    },
    {
      "time": 73.4,
      "end": 73.84,
      "text": "а где миф"
    },
    {
      "time": 73.84,
      "end": 74.88,
      "text": "Тут странный речитатив"
    },
    {
      "time": 74.88,
      "end": 75.72,
      "text": "С тобой печальней"
    },
    {
      "time": 75.72,
      "end": 76.26,
      "text": "разделив"
    },
    {
      "time": 76.26,
      "end": 77.46,
      "text": "Меняю тексты, крусив"
    },
    {
      "time": 77.46,
      "end": 78.86,
      "text": "Твою душу распилю"
    },
    {
      "time": 78.86,
      "end": 80.04,
      "text": "Словно злой абразив"
    },
    {
      "time": 80.04,
      "end": 80.9,
      "text": "Я эти темы"
    },
    {
      "time": 80.9,
      "end": 81.5,
      "text": "выливаю"
    },
    {
      "time": 81.5,
      "end": 82.22,
      "text": "Как бокал до"
    },
    {
      "time": 82.22,
      "end": 82.7,
      "text": "окрая"
    },
    {
      "time": 82.7,
      "end": 83.48,
      "text": "Может, кто -то"
    },
    {
      "time": 83.48,
      "end": 83.9,
      "text": "не знаю"
    },
    {
      "time": 83.9,
      "end": 84.6,
      "text": "В бытность я"
    },
    {
      "time": 84.6,
      "end": 85.24,
      "text": "улетаю"
    },
    {
      "time": 85.24,
      "end": 86.5,
      "text": "Почитаю, раздаю"
    },
    {
      "time": 86.5,
      "end": 88.1,
      "text": "Речитативу струю, уже"
    },
    {
      "time": 88.1,
      "end": 88.7,
      "text": "давно я не"
    },
    {
      "time": 88.7,
      "end": 89.0,
      "text": "сплю,"
    },
    {
      "time": 89.16,
      "end": 89.82,
      "text": "Но он остался"
    },
    {
      "time": 89.82,
      "end": 90.86,
      "text": "в строю, тему"
    },
    {
      "time": 90.86,
      "end": 91.7,
      "text": "вынести свою,"
    },
    {
      "time": 91.92,
      "end": 93.26,
      "text": "Просто захотел, опять"
    },
    {
      "time": 93.26,
      "end": 94.32,
      "text": "кипит мой воздух,"
    },
    {
      "time": 94.38,
      "end": 95.5,
      "text": "Снова башке беспредел,"
    },
    {
      "time": 95.72,
      "end": 96.4,
      "text": "для кого -то"
    },
    {
      "time": 96.4,
      "end": 96.74,
      "text": "мем,"
    },
    {
      "time": 96.98,
      "end": 97.68,
      "text": "Для кого -то"
    },
    {
      "time": 97.68,
      "end": 98.44,
      "text": "как мёд, кому"
    },
    {
      "time": 98.44,
      "end": 98.98,
      "text": "я в душу"
    },
    {
      "time": 98.98,
      "end": 99.52,
      "text": "залетел,"
    },
    {
      "time": 99.6,
      "end": 100.66,
      "text": "Тот меня поймёт,"
    },
    {
      "time": 100.74,
      "end": 101.36,
      "text": "на сцене я"
    },
    {
      "time": 101.36,
      "end": 101.98,
      "text": "как рот,"
    },
    {
      "time": 102.08,
      "end": 102.76,
      "text": "Вокруг не вижу"
    },
    {
      "time": 102.76,
      "end": 104.5,
      "text": "господ, забирает релток,"
    },
    {
      "time": 104.58,
      "end": 105.14,
      "text": "Влетел я в"
    },
    {
      "time": 105.14,
      "end": 106.3,
      "text": "свой поток, читай,"
    },
    {
      "time": 106.42,
      "end": 107.1,
      "text": "я между трок,"
    },
    {
      "time": 107.22,
      "end": 107.84,
      "text": "Весь год пошёл"
    },
    {
      "time": 107.84,
      "end": 108.94,
      "text": "поперёк, в чужой"
    },
    {
      "time": 108.94,
      "end": 109.8,
      "text": "дом я ворвался,"
    },
    {
      "time": 109.88,
      "end": 111.14,
      "text": "Тут почуть разогнался,"
    },
    {
      "time": 111.34,
      "end": 113.02,
      "text": "о боже, как"
    },
    {
      "time": 113.02,
      "end": 114.04,
      "text": "я заебался."
    },
    {
      "time": 114.04,
      "end": 117.86,
      "text": "Я устал. Да"
    },
    {
      "time": 117.86,
      "end": 120.4,
      "text": "и похуй. Все"
    },
    {
