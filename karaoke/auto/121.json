      "text": "Сформировал свою личность,"
    },
    {
      "time": 114.61,
      "end": 116.13,
      "text": "не хочу доказать"
    },
    {
      "time": 116.13,
      "end": 117.69,
      "text": "Я никому ничего,"
    },
    {
      "time": 118.25,
      "end": 119.33,
      "text": "в башке обычный"
    },
    {
      "time": 119.33,
      "end": 119.87,
      "text": "прятвол"
    },
    {
      "time": 119.87,
      "end": 120.77,
      "text": "Я не на"
    },
    {
      "time": 120.77,
      "end": 121.93,
      "text": "отстанцу гоу -гоу,"
    },
    {
      "time": 122.11,
      "end": 122.79,
      "text": "но жизнь как"
    },
    {
      "time": 122.79,
      "end": 123.79,
      "text": "будто прикол"
    },
    {
      "time": 123.79,
      "end": 124.87,
      "text": "Но из проблем"
    },
    {
      "time": 124.87,
      "end": 126.45,
      "text": "вылезаю, но снова"
    },
    {
      "time": 126.45,
      "end": 127.79,
      "text": "в них залезаю"
    },
    {
      "time": 127.79,
      "end": 129.73,
      "text": "Никому не обязан,"
    },
    {
      "time": 129.97,
      "end": 131.61,
      "text": "как краситету мозаик"
    },
    {
      "time": 131.61,
      "end": 133.51,
      "text": "Своими вижу глазами,"
    },
    {
      "time": 133.73,
      "end": 135.05,
      "text": "как разлетаюсь на"
    },
    {
      "time": 135.05,
      "end": 135.49,
      "text": "части"
    },
    {
      "time": 135.49,
      "end": 136.79,
      "text": "Как купе, если"
    },
    {
      "time": 136.79,
      "end": 137.57,
      "text": "я в пасте,"
    },
    {
      "time": 137.73,
      "end": 138.67,
      "text": "не нужны мне"
    },
    {
      "time": 138.67,
      "end": 139.43,
      "text": "запчасти"
    },
    {
      "time": 139.43,
      "end": 141.33,
      "text": "Жизнь случается страсти,"
    },
    {
      "time": 141.63,
      "end": 142.53,
