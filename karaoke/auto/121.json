    },
    {
      "time": 174.23,
      "end": 175.03,
      "text": "Но жить -то"
    },
    {
      "time": 175.03,
      "end": 176.23,
      "text": "надо, как хочешь"
    },
    {
      "time": 176.23,
      "end": 177.29,
      "text": "Не важно, дном"
    },
    {
      "time": 177.29,
      "end": 178.13,
