      "end": 141.49,
      "text": "нужен"
    },
    {
      "time": 141.49,
      "end": 143.99,
      "text": "Уебывай, я закажу"
    },
    {
      "time": 143.99,
      "end": 145.65,
      "text": "тебе пиццулю на"
    },
    {
      "time": 145.65,
      "end": 146.21,
      "text": "ужин"
    },
    {
      "time": 146.21,
      "end": 147.43,
      "text": "Я че гранаты"
    },
    {
      "time": 147.43,
      "end": 149.29,
      "text": "жарю вам таракана"
    },
    {
      "time": 149.29,
      "end": 150.23,
      "text": "на завтрак"
    },
    {
      "time": 150.23,
      "end": 151.41,
      "text": "А на обед"
    },
    {
      "time": 151.41,
      "end": 152.71,
      "text": "смесь мочи, говна"
    },
    {
      "time": 152.71,
      "end": 153.51,
      "text": "и фарша"
    },
    {
      "time": 153.51,
      "end": 155.55,
      "text": "Билет в один"
    },
    {
      "time": 155.55,
      "end": 156.25,
      "text": "конец"
    },
    {
      "time": 156.25,
      "end": 157.91,
      "text": "В сраную жопу"
    },
    {
      "time": 157.91,
      "end": 158.57,
      "text": "бомжа"
    },
    {
      "time": 158.57,
      "end": 159.99,
      "text": "Я уебу прям"
    },
    {
      "time": 159.99,
      "end": 160.71,
      "text": "с ножа"
    },
    {
      "time": 160.71,
      "end": 162.41,
      "text": "Ержан, бля, вставай"
    },
    {
      "time": 162.41,
      "end": 164.41,
      "text": "Вставай, Ержан"
    },
    {
      "time": 164.41,
      "end": 165.47,
      "text": "Ну ты чё"
    },
    {
      "time": 165.47,
      "end": 166.81,
      "text": "разлёгся, нахуй"
    },
    {
      "time": 166.81,
      "end": 168.87,
      "text": "Поднимай свою жопу"
    },
    {
      "time": 168.87,
      "end": 170.31,
      "text": "Тут чё граната,"
    },
    {
      "time": 170.35,
      "end": 170.85,
      "text": "нахуй"
    },
    {
      "time": 170.85,
      "end": 172.79,
      "text": "Ержан, бля, вставай"
    },
    {
      "time": 172.79,
      "end": 174.39,
      "text": "Где пароль на"
    },
    {
