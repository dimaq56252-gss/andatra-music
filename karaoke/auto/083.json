      "text": "кирпич"
    },
    {
      "time": 134.13,
      "end": 136.47,
      "text": "Соси мои яички,"
    },
    {
      "time": 136.65,
      "end": 137.55,
      "text": "ты бичара"
    },
    {
      "time": 137.55,
      "end": 138.95,
      "text": "Как банный лист"
    },
    {
      "time": 138.95,
      "end": 139.69,
