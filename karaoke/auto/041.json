    },
    {
      "time": 121.49,
      "end": 122.93,
      "text": "Стрижем овец, потом"
    },
    {
      "time": 122.93,
      "end": 124.27,
      "text": "стреляем поперёс"
    },
    {
      "time": 124.27,
      "end": 125.25,
      "text": "И бой, я"
    },
    {
      "time": 125.25,
      "end": 126.49,
      "text": "тупо зафристайлил"
    },
    {
      "time": 126.49,
      "end": 127.67,
      "text": "У тебя тупое"
    },
    {
      "time": 127.67,
      "end": 128.13,
      "text": "ебло"
    },
    {
      "time": 128.13,
      "end": 129.71,
      "text": "Нарядчик много слили,"
    },
    {
      "time": 129.89,
      "end": 130.55,
      "text": "но нам не"
    },
    {
      "time": 130.55,
      "end": 131.41,
      "text": "жалко бабло"
    },
    {
      "time": 131.41,
      "end": 132.93,
      "text": "Ты обосрелся, когда"
    },
    {
      "time": 132.93,
      "end": 134.35,
      "text": "дрилил, обосрелся с"
    },
    {
      "time": 134.35,
      "end": 134.91,
