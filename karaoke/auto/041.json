  "cues": [
    {
      "time": 26.03,
      "end": 27.63,
      "text": "Мы ночели на"
    },
    {
      "time": 27.63,
      "end": 28.87,
      "text": "ворке и летят"
    },
    {
      "time": 28.87,
      "end": 29.69,
      "text": "пусть иголки"
    },
    {
      "time": 29.69,
      "end": 31.27,
      "text": "Почуть будут пронзать"
    },
    {
      "time": 31.27,
      "end": 32.99,
      "text": "моих рифм осколки"
    },
    {
      "time": 32.99,
      "end": 33.95,
      "text": "В этом тексте"
    },
    {
      "time": 33.95,
      "end": 34.67,
      "text": "нет смысла, в"
    },
    {
      "time": 34.67,
      "end": 35.75,
      "text": "башке какие -то"
    },
    {
      "time": 35.75,
      "end": 36.21,
      "text": "числа"
    },
    {
      "time": 36.21,
      "end": 37.25,
      "text": "Чуть хожу я"
    },
    {
      "time": 37.25,
      "end": 38.23,
      "text": "по крыше, в"
    },
    {
      "time": 38.23,
      "end": 39.07,
      "text": "этом мире я"
    },
    {
      "time": 39.07,
      "end": 39.57,
      "text": "лишний"
    },
    {
      "time": 39.57,
      "end": 40.41,
      "text": "И ведь так"
    },
    {
      "time": 40.41,
      "end": 41.51,
      "text": "не сложно просто"
    },
    {
      "time": 41.51,
      "end": 42.63,
      "text": "сойти с ума"
    },
    {
      "time": 42.63,
      "end": 43.77,
      "text": "В этом мире"
    },
    {
      "time": 43.77,
      "end": 44.81,
      "text": "все сложно, вокруг"
    },
    {
      "time": 44.81,
      "end": 45.95,
      "text": "однако дерьма"
    },
    {
      "time": 45.95,
      "end": 47.15,
      "text": "Но и хватает"
    },
    {
      "time": 47.15,
      "end": 47.63,
      "text": "дерьма"
    },
    {
      "time": 47.63,
      "end": 48.89,
      "text": "И справа, и"
    },
    {
      "time": 48.89,
      "end": 49.77,
      "text": "слева, ты не"
    },
    {
      "time": 49.77,
      "end": 50.97,
      "text": "моя королева"
    },
    {
      "time": 50.97,
      "end": 51.97,
      "text": "Иди ты просто"
    },
    {
      "time": 51.97,
      "end": 53.47,
      "text": "налево, этот куплет"
    },
    {
      "time": 53.47,
      "end": 54.27,
      "text": "без припева"
    },
    {
      "time": 54.27,
      "end": 55.29,
      "text": "Ведь так обычно"
    },
    {
      "time": 55.29,
      "end": 56.39,
      "text": "бывает, мой мир"
    },
    {
      "time": 56.39,
      "end": 57.01,
      "text": "со мной, а"
    },
    {
      "time": 57.01,
      "end": 57.49,
      "text": "я в нем"
    },
    {
      "time": 57.49,
      "end": 59.11,
      "text": "Готов кидаться огнем,"
    },
    {
      "time": 59.37,
      "end": 60.31,
      "text": "об скалы зубы"
    },
    {
      "time": 60.31,
      "end": 60.87,
      "text": "набиты"
    },
    {
      "time": 60.87,
      "end": 62.01,
      "text": "И летит этот"
    },
    {
      "time": 62.01,
      "end": 63.77,
      "text": "ритм, метаморфозу и"
    },
    {
      "time": 63.77,
      "end": 64.33,
      "text": "вечности"
    },
    {
      "time": 64.33,
      "end": 65.89,
      "text": "Немного мы говорим,"
    },
    {
      "time": 66.17,
      "end": 66.89,
      "text": "и так качает"
    },
    {
      "time": 66.89,
      "end": 67.33,
      "text": "бетло"
    },
    {
      "time": 67.33,
      "end": 68.51,
      "text": "Я говорю под"
    },
    {
      "time": 68.51,
      "end": 69.87,
      "text": "музло, чуток меня"
    },
    {
      "time": 69.87,
      "end": 70.63,
      "text": "занесло"
    },
    {
      "time": 70.63,
      "end": 71.97,
      "text": "Я разгоню вокруг"
    },
    {
      "time": 71.97,
      "end": 73.25,
      "text": "зло, солнце мне"
    },
    {
      "time": 73.25,
      "end": 74.13,
      "text": "освещает"
    },
    {
      "time": 74.13,
      "end": 75.59,
      "text": "Мой темный путь,"
    },
    {
      "time": 75.79,
      "end": 76.31,
      "text": "что в этом"
    },
    {
      "time": 76.31,
      "end": 77.33,
      "text": "мире случилось"
    },
    {
      "time": 77.33,
      "end": 78.85,
      "text": "Уже давно забудь,"
    },
    {
      "time": 79.01,
      "end": 80.53,
      "text": "хожу босыми ногами"
    },
    {
      "time": 80.53,
      "end": 81.63,
      "text": "Я по осколкам"
    },
    {
      "time": 81.63,
      "end": 82.61,
      "text": "и пеплу, хоть"
    },
    {
      "time": 82.61,
      "end": 83.79,
      "text": "и внутри пожар"
    },
    {
      "time": 83.79,
      "end": 85.15,
      "text": "Вокруг живого тут"
    },
    {
      "time": 85.15,
      "end": 86.37,
      "text": "нету, я закурил"
    },
    {
      "time": 86.37,
      "end": 87.13,
      "text": "сигарету"
    },
    {
      "time": 87.13,
      "end": 89.79,
      "text": "Проблемы отлетели, отвалили"
    },
    {
      "time": 89.79,
      "end": 90.35,
      "text": "навсегда"
    },
    {
      "time": 90.35,
      "end": 91.07,
      "text": "В своем я"
    },
    {
      "time": 91.07,
      "end": 92.09,
      "text": "без приели"
    },
    {
      "time": 93.69,
      "end": 95.13,
      "text": "Вандатры здесь ебать"
    },
    {
      "time": 95.13,
      "end": 96.85,
      "text": "Я ебанул вандрила,"
    },
    {
      "time": 96.99,
      "end": 98.53,
      "text": "все репера педрилы"
    },
    {
      "time": 98.53,
      "end": 100.19,
      "text": "Кроме моей банды,"
    },
    {
      "time": 100.41,
      "end": 101.69,
      "text": "вандатры все крутые"
    },
    {
      "time": 101.69,
      "end": 102.83,
      "text": "Но зончик наш"
    },
    {
      "time": 102.83,
      "end": 104.45,
      "text": "бесплатный, шотландца не"
    },
    {
      "time": 104.45,
      "end": 105.03,
      "text": "купить"
    },
    {
      "time": 105.03,
      "end": 106.31,
      "text": "Не брошу репчик"
    },
    {
      "time": 106.31,
      "end": 107.53,
      "text": "никогда, как не"
    },
    {
      "time": 107.53,
      "end": 108.43,
      "text": "брошу курить"
    },
    {
      "time": 108.43,
      "end": 109.87,
      "text": "Я залетаю на"
    },
    {
      "time": 109.87,
      "end": 110.65,
      "text": "биты, как не"
    },
    {
      "time": 110.65,
      "end": 111.29,
      "text": "худелать"
    },
    {
      "time": 111.29,
      "end": 113.03,
      "text": "Ты читаешь, я"
    },
    {
      "time": 113.03,
      "end": 113.53,
      "text": "прям с год,"
    },
    {
      "time": 113.63,
      "end": 114.25,
      "text": "ты для меня"
    },
    {
      "time": 114.25,
      "end": 114.95,
      "text": "без денег"
    },
    {
      "time": 114.95,
      "end": 115.97,
      "text": "В конторе не"
    },
    {
      "time": 115.97,
      "end": 117.17,
      "text": "был давно, сейчас"
    },
    {
      "time": 117.17,
      "end": 118.35,
      "text": "начнется пиздец"
    },
    {
      "time": 118.35,
      "end": 119.57,
      "text": "Я хламину в"
    },
    {
      "time": 119.57,
      "end": 120.69,
      "text": "говно, почти как"
    },
    {
      "time": 120.69,
