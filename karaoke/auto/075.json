      "end": 157.33,
      "text": "а нам все"
    },
    {
      "time": 157.33,
      "end": 157.93,
      "text": "до пизды"
    },
    {
      "time": 157.93,
      "end": 159.21,
      "text": "Хочешь, дадим тебе"
    },
    {
