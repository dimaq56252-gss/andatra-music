    },
    {
      "time": 161.49,
      "end": 162.53,
      "text": "твоим соседям"
    },
    {
      "time": 162.53,
      "end": 163.67,
      "text": "Что мешают спать?"
    },
    {
      "time": 163.83,
      "end": 164.67,
      "text": "Я как Джейсон"
    },
    {
      "time": 164.67,
      "end": 166.03,
      "text": "Стэдхи, я запретил"
    },
    {
