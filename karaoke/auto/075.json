      "end": 166.55,
      "text": "вам срать"
    },
    {
      "time": 166.55,
      "end": 167.65,
      "text": "На Альткоин все"
    },
    {
      "time": 167.65,
      "end": 168.81,
      "text": "деньги потратили"
    },
    {
      "time": 168.81,
      "end": 169.71,
      "text": "Мы с тобой,"
