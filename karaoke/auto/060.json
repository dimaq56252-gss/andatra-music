  "cues": [
    {
      "time": 20.82,
      "end": 21.74,
      "text": "Детка, как же"
    },
    {
      "time": 21.74,
      "end": 22.82,
      "text": "мне было хорошо"
    },
    {
      "time": 22.82,
      "end": 23.24,
      "text": "с тобой"
    },
    {
      "time": 23.24,
      "end": 24.44,
      "text": "Ты научила не"
    },
    {
      "time": 24.44,
      "end": 25.14,
      "text": "врать и быть"
    },
    {
      "time": 25.14,
      "end": 25.94,
      "text": "самим собой"
    },
    {
      "time": 25.94,
      "end": 26.98,
      "text": "Хобби ван в"
    },
    {
      "time": 26.98,
      "end": 28.16,
      "text": "тюрьме, я забрал"
    },
    {
      "time": 28.16,
      "end": 28.54,
      "text": "ебой"
    },
    {
      "time": 28.54,
      "end": 29.58,
      "text": "Когда ходил на"
    },
    {
      "time": 29.58,
      "end": 30.76,
      "text": "дзюдо, умел бросок"
    },
    {
      "time": 30.76,
      "end": 31.24,
      "text": "японский"
    },
    {
      "time": 31.24,
      "end": 32.26,
      "text": "Пацанский рэп только"
    },
    {
      "time": 32.26,
      "end": 33.38,
      "text": "у мистера поцека"
    },
    {
      "time": 33.38,
      "end": 34.62,
      "text": "Я проперделся моцик,"
    },
    {
      "time": 34.68,
      "end": 35.9,
      "text": "пишу рыпайся, моцарь"
    },
    {
      "time": 35.9,
      "end": 36.86,
      "text": "Нашел биток, забрал"
    },
    {
      "time": 36.86,
      "end": 37.56,
      "text": "без спроса"
    },
    {
      "time": 37.56,
      "end": 38.88,
      "text": "Тебе дает аванс"
    },
    {
      "time": 38.88,
      "end": 39.54,
      "text": "лейбл, а я"
    },
    {
      "time": 39.54,
      "end": 40.44,
      "text": "сам за себя"
    },
    {
      "time": 40.44,
      "end": 41.34,
      "text": "сделал взнос"
    },
    {
      "time": 41.34,
      "end": 42.62,
      "text": "С каждым разом"
    },
    {
      "time": 42.62,
      "end": 43.68,
      "text": "повышаю дозу"
    },
    {
      "time": 43.68,
      "end": 44.66,
      "text": "Я дарю свои"
    },
    {
      "time": 44.66,
      "end": 45.54,
      "text": "треки, как дарят"
    },
    {
      "time": 45.54,
      "end": 45.92,
      "text": "розы"
    },
    {
      "time": 45.92,
      "end": 46.9,
      "text": "Мы в Коломне,"
    },
    {
      "time": 47.04,
      "end": 47.78,
      "text": "нам похуй, тут"
    },
    {
      "time": 47.78,
      "end": 48.54,
      "text": "нет мороза"
    },
    {
      "time": 48.54,
      "end": 50.56,
      "text": "Я ненавижу, но"
    },
    {
      "time": 50.56,
      "end": 51.64,
      "text": "с тобой посмотрю"
    },
    {
      "time": 51.64,
      "end": 52.14,
      "text": "отбросов"
    },
    {
      "time": 52.14,
      "end": 53.0,
      "text": "Я не задам"
    },
    {
      "time": 53.0,
      "end": 54.84,
      "text": "никогда глупых вопросов"
    },
    {
      "time": 54.84,
      "end": 55.62,
      "text": "Знаю, что мне"
    },
    {
      "time": 55.62,
      "end": 55.98,
      "text": "делать"
    },
    {
      "time": 55.98,
      "end": 57.32,
      "text": "Присперма, токсикозе"
    },
    {
      "time": 57.32,
      "end": 58.36,
      "text": "Анда, ты белая"
    },
    {
      "time": 58.36,
      "end": 59.28,
      "text": "любви, стрекозе"
    },
    {
      "time": 59.28,
      "end": 60.4,
      "text": "Я басту вытащил"
    },
    {
      "time": 60.4,
      "end": 60.96,
      "text": "из носа"
    },
    {
      "time": 60.96,
      "end": 62.24,
      "text": "Он просто козя"
    },
    {
      "time": 62.24,
      "end": 63.16,
      "text": "Я в режиме"
    },
    {
      "time": 63.16,
      "end": 63.94,
      "text": "суперфаст"
    },
    {
      "time": 63.94,
      "end": 65.96,
      "text": "Мои панчи как"
    },
    {
      "time": 65.96,
      "end": 66.54,
      "text": "прокаст"
    },
    {
      "time": 67.44,
      "end": 68.76,
      "text": "Старичок сейчас реки"
    },
    {
      "time": 68.76,
      "end": 69.26,
      "text": "даст"
    },
    {
      "time": 70.08,
      "end": 71.34,
      "text": "Отвомил братан на"
    },
    {
      "time": 71.34,
      "end": 71.78,
      "text": "глаз"
    },
    {
      "time": 71.78,
      "end": 73.8,
      "text": "Броки знает, я"
    },
    {
      "time": 73.8,
      "end": 74.22,
      "text": "алмаз"
    },
    {
      "time": 74.22,
      "end": 75.24,
      "text": "Хочу залететь на"
    },
    {
      "time": 75.24,
      "end": 75.52,
      "text": "газ"
    },
    {
      "time": 75.52,
      "end": 76.54,
      "text": "Меня катит черный"
    },
    {
      "time": 76.54,
      "end": 76.86,
      "text": "бас"
    },
    {
      "time": 76.86,
      "end": 78.16,
      "text": "Выставляет плотный бас"
    },
    {
      "time": 78.16,
      "end": 79.0,
      "text": "Хаус, ганга, вас"
    },
    {
      "time": 79.0,
      "end": 79.96,
      "text": "на раз, каннивест,"
    },
    {
      "time": 80.04,
      "end": 80.7,
      "text": "блядь, пидорас"
    },
    {
      "time": 80.7,
      "end": 81.74,
      "text": "Косморейнджер, я не"
    },
    {
      "time": 81.74,
      "end": 82.82,
      "text": "бас, она рыжая,"
    },
    {
      "time": 82.82,
      "end": 83.38,
      "text": "я пас"
    },
    {
      "time": 83.38,
      "end": 84.36,
      "text": "Господи, храни мой"
    },
    {
      "time": 84.36,
      "end": 86.8,
      "text": "стрит, исполняю щас"
    },
    {
      "time": 86.8,
      "end": 87.36,
      "text": "кульбит"
    },
    {
      "time": 88.54,
      "end": 89.7,
      "text": "Положу культуру в"
    },
    {
      "time": 89.7,
      "end": 91.9,
      "text": "бит, андатру ставлю"
    },
    {
      "time": 91.9,
      "end": 92.54,
      "text": "на репит"
    },
    {
      "time": 93.58,
      "end": 94.66,
      "text": "Снова булек мой"
    },
    {
      "time": 94.66,
      "end": 95.72,
      "text": "дымит, хендер сильно,"
    },
    {
      "time": 95.84,
      "end": 96.48,
      "text": "бля, горит"
    },
    {
      "time": 96.48,
      "end": 97.24,
      "text": "От тебя душа"
    },
    {
      "time": 97.24,
      "end": 98.54,
      "text": "болит, залетаю как"
    },
    {
      "time": 98.54,
      "end": 99.02,
      "text": "болит"
    },
    {
      "time": 99.02,
      "end": 100.32,
      "text": "Меня гасит гайморит,"
    },
    {
      "time": 100.4,
      "end": 100.96,
      "text": "нос так сильно,"
    },
    {
      "time": 100.98,
      "end": 101.6,
      "text": "блядь, болит"
    },
    {
      "time": 101.6,
      "end": 102.5,
      "text": "Твоя жопа на"
    },
    {
      "time": 102.5,
      "end": 103.84,
      "text": "орбите, андатра на"
    },
    {
      "time": 103.84,
      "end": 104.32,
      "text": "репите"
    },
    {
      "time": 104.52,
      "end": 120.032653,
      "text": "♪ Сделал Взнос"
    }
  ],
