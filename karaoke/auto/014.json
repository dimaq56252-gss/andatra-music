    {
      "time": 3.1,
      "end": 7.32,
      "text": "Ай, что залеп"
    },
    {
      "time": 7.32,
      "end": 8.58,
      "text": "этот галутинский тигр?"
    },
    {
      "time": 9.28,
      "end": 9.6,
      "text": "Я."
    },
    {
      "time": 10.93,
      "end": 11.55,
      "text": "Райза."
    },
    {
      "time": 12.05,
      "end": 13.29,
      "text": "Братка, помнишь, было"
    },
    {
      "time": 13.29,
      "end": 14.33,
      "text": "грустно, не нашли"
    },
    {
      "time": 14.33,
      "end": 15.11,
      "text": "с тобою пус."
    },
    {
      "time": 15.15,
      "end": 16.07,
      "text": "Я, сука, страшный"
    },
    {
      "time": 16.07,
      "end": 17.09,
      "text": "и угарный, будто"
    },
    {
      "time": 17.09,
      "end": 17.81,
      "text": "Битлджус."
    },
    {
      "time": 18.03,
      "end": 19.41,
      "text": "Это Россия, браток,"
    },
    {
      "time": 19.55,
      "end": 20.79,
      "text": "почти как Беларусь."
    },
    {
      "time": 21.01,
      "end": 22.13,
      "text": "Мы капки делаем"
    },
    {
      "time": 22.13,
      "end": 23.13,
      "text": "большие, дай мне"
    },
    {
      "time": 23.13,
      "end": 23.83,
      "text": "затянуться."
    },
    {
      "time": 24.17,
      "end": 25.53,
      "text": "Пацаны на СВО"
    },
    {
      "time": 25.53,
      "end": 26.83,
      "text": "похлеще, чем Якуза."
    },
    {
      "time": 26.97,
      "end": 28.59,
      "text": "Сказать, что облапиздатый"
    },
    {
      "time": 28.59,
      "end": 29.87,
      "text": "язык не повернется."
    },
    {
      "time": 29.87,
      "end": 30.79,
      "text": "Какой же ты"
    },
    {
      "time": 30.79,
      "end": 31.99,
      "text": "мужчина, ты, блядь,"
    },
    {
      "time": 32.03,
