    },
    {
      "time": 11.83,
      "end": 12.91,
      "text": "О том, какие"
    },
    {
      "time": 12.91,
      "end": 14.15,
      "text": "нынче гангстеры"
    },
    {
      "time": 14.15,
      "end": 15.85,
      "text": "Колпак поехал у"
    },
    {
      "time": 15.85,
      "end": 16.17,
      "text": "меня"
    },
    {
      "time": 16.17,
      "end": 17.29,
      "text": "Я как Стокман"
    },
    {
      "time": 17.29,
      "end": 17.79,
      "text": "Бакстер"
    },
    {
      "time": 17.79,
      "end": 18.93,
      "text": "Ты можешь только"
    },
    {
      "time": 18.93,
      "end": 19.71,
      "text": "пакостить"
    },
    {
      "time": 19.71,
      "end": 21.55,
      "text": "Пишу купле для"
    },
    {
      "time": 21.55,
      "end": 21.95,
      "text": "себя"
    },
    {
      "time": 21.95,
      "end": 23.03,
      "text": "И для Данька"
    },
    {
      "time": 23.03,
      "end": 23.81,
      "text": "Губастова"
    },
    {
      "time": 23.81,
      "end": 25.63,
      "text": "Тебя случайно разбудил"
    },
    {
      "time": 25.63,
      "end": 26.99,
      "text": "мусоровоз КамАЗ"
    },
    {
      "time": 26.99,
      "end": 28.09,
      "text": "Я верю, что"
    },
    {
      "time": 28.09,
      "end": 29.39,
      "text": "мы делаем свою"
    },
    {
      "time": 29.39,
      "end": 29.87,
      "text": "хуйню"
    },
    {
      "time": 29.87,
      "end": 30.71,
      "text": "Не напрасно"
    },
    {
      "time": 30.71,
      "end": 31.69,
      "text": "Ты сфоткай меня"
    },
    {
      "time": 31.69,
      "end": 32.23,
      "text": "дважды"
    },
    {
      "time": 32.23,
      "end": 33.27,
      "text": "На память и"
    },
    {
      "time": 33.27,
      "end": 33.91,
      "text": "на паспорт"
    },
    {
      "time": 33.91,
      "end": 35.79,
      "text": "Мы наебашились, говно"
    },
    {
      "time": 35.79,
      "end": 37.35,
      "text": "нас забирает транспорт"
    },
    {
      "time": 37.35,
      "end": 38.55,
      "text": "Ты пидорас, я"
    },
    {
      "time": 38.55,
      "end": 39.55,
      "text": "знаю, ты в"
    },
    {
      "time": 39.55,
      "end": 40.79,
      "text": "Тае трахал транса"
    },
    {
      "time": 40.79,
      "end": 42.31,
      "text": "Не оставил тебе"
    },
    {
      "time": 42.31,
      "end": 43.63,
      "text": "выбор, как будто"
    },
    {
      "time": 43.63,
      "end": 44.19,
      "text": "астреб"
    },
    {
      "time": 44.19,
      "end": 45.43,
      "text": "Ты не любишь"
    },
    {
      "time": 45.43,
      "end": 46.65,
      "text": "наши песни, ты"
    },
    {
      "time": 46.65,
      "end": 47.67,
      "text": "шерсть, блять, красная"
    },
    {
      "time": 47.67,
      "end": 49.11,
      "text": "Я послушал ваши"
    },
    {
      "time": 49.11,
      "end": 50.55,
      "text": "песни, это курам"
    },
    {
      "time": 50.55,
      "end": 51.05,
      "text": "насмерть"
    },
    {
      "time": 51.05,
      "end": 52.59,
      "text": "Давай попиздимся до"
    },
    {
      "time": 52.59,
      "end": 53.87,
      "text": "крови или, сука,"
    },
    {
      "time": 53.97,
      "end": 54.39,
      "text": "насмерть"
    },
    {
      "time": 54.39,
      "end": 56.23,
      "text": "Я такой дружелюбный,"
    },
    {
      "time": 56.37,
      "end": 57.47,
      "text": "как привидение к"
    },
    {
      "time": 57.47,
      "end": 57.91,
      "text": "астребту"
    },
    {
      "time": 57.91,
      "end": 59.05,
      "text": "Ты поясни за"
    },
    {
      "time": 59.05,
      "end": 60.43,
      "text": "трап, ты поясни"
    },
    {
      "time": 60.43,
      "end": 61.15,
      "text": "за хассел"
    },
    {
      "time": 61.15,
      "end": 62.81,
      "text": "Твой ебальник такой"
    },
    {
      "time": 62.81,
      "end": 64.05,
      "text": "хрупкий, как будто"
    },
    {
      "time": 64.05,
      "end": 64.55,
      "text": "ваза"
    },
    {
      "time": 64.55,
      "end": 65.79,
      "text": "Мы пишем треки"
    },
    {
      "time": 65.79,
      "end": 66.67,
      "text": "каждый день, ты"
    },
    {
      "time": 66.67,
      "end": 67.99,
      "text": "знаешь, это база"
    },
    {
      "time": 67.99,
      "end": 69.29,
      "text": "Ты воевал по"
    },
    {
      "time": 69.29,
      "end": 70.75,
      "text": "глобусу, я воевал"
    },
    {
      "time": 70.75,
      "end": 71.55,
      "text": "по атласу"
    },
    {
      "time": 71.55,
      "end": 72.59,
      "text": "Ты как дуделка"
    },
    {
      "time": 72.59,
      "end": 73.85,
      "text": "пиздюка, ты сука"
    },
    {
      "time": 73.85,
      "end": 74.75,
      "text": "одноразка"
    },
    {
      "time": 74.75,
      "end": 76.05,
      "text": "Хочу про твою"
    },
    {
      "time": 76.05,
      "end": 78.17,
      "text": "мать, сказали, пидораска"
    },
    {
      "time": 78.17,
      "end": 79.55,
      "text": "Твое детство с"
    },
    {
      "time": 79.55,
      "end": 80.81,
      "text": "интернетом, мое с"
    },
    {
      "time": 80.81,
      "end": 81.61,
      "text": "пенопластом"
    },
    {
      "time": 81.61,
      "end": 82.57,
      "text": "Я знаю, ты"
    },
    {
      "time": 82.57,
      "end": 84.37,
      "text": "всегда был пидором"
    },
    {
      "time": 84.37,
      "end": 85.03,
      "text": "и плаксой"
    },
    {
      "time": 85.03,
      "end": 86.05,
      "text": "Ты помнишь, как"
    },
    {
      "time": 86.05,
      "end": 87.15,
      "text": "мы фристайлили в"
    },
    {
      "time": 87.15,
      "end": 88.39,
      "text": "хорошого спласка"
    },
    {
      "time": 88.39,
      "end": 89.69,
      "text": "Со мной битмейкер"
    },
    {
      "time": 89.69,
      "end": 90.95,
      "text": "Коля, ты думал,"
    },
    {
      "time": 91.07,
      "end": 91.81,
      "text": "Коля Басков"
    },
    {
      "time": 91.81,
      "end": 92.99,
      "text": "Зови нас делать"
    },
    {
      "time": 92.99,
      "end": 94.27,
      "text": "рэп, я буду"
    },
    {
      "time": 94.27,
      "end": 95.17,
      "text": "очень ласков"
    },
    {
      "time": 95.17,
      "end": 96.25,
      "text": "Браток не смог"
    },
    {
      "time": 96.25,
      "end": 97.43,
      "text": "нас записать, это,"
    },
