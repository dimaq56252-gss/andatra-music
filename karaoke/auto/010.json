    },
    {
      "time": 129.25,
      "end": 131.07,
      "text": "Темное небо сырое,"
    },
    {
      "time": 131.15,
      "end": 132.87,
      "text": "вновь наливается кровью"
    },
    {
      "time": 132.87,
      "end": 134.15,
      "text": "Сейчас наполнит мой"
