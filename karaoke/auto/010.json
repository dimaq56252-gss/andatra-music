      "end": 122.53,
      "text": "не тяни"
    },
    {
      "time": 122.53,
      "end": 124.17,
      "text": "Вокруг меня туман,"
    },
    {
      "time": 124.47,
      "end": 125.41,
      "text": "туда зашел я"
    },
    {
      "time": 125.41,
      "end": 125.87,
      "text": "сам"
    },
    {
      "time": 125.87,
      "end": 126.95,
      "text": "Где -то влетаю"
