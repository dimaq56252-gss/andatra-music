      "text": "время."
    },
    {
      "time": 29.89,
      "end": 31.51,
      "text": "Передал привет твоей"
    },
    {
      "time": 31.51,
      "end": 32.87,
      "text": "жене беременной."
    },
    {
      "time": 33.11,
      "end": 34.27,
      "text": "А я слышал,"
    },
    {
      "time": 34.45,
      "end": 36.35,
      "text": "Боря касание переехал"
    },
    {
      "time": 36.35,
