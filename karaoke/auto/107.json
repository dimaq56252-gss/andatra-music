      "text": "коне"
    },
    {
      "time": 134.14,
      "end": 135.72,
      "text": "Эти хорни хотят"
    },
    {
      "time": 135.72,
      "end": 136.14,
      "text": "соу"
    },
    {
      "time": 136.14,
      "end": 137.64,
      "text": "Что течут во"
    },
    {
      "time": 137.64,
      "end": 137.94,
      "text": "мне"
    },
    {
      "time": 137.94,
      "end": 139.36,
      "text": "Агир снова на"
    },
    {
