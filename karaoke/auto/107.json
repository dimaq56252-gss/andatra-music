      "text": "в колонну и"
    },
    {
      "time": 37.93,
      "end": 39.55,
      "text": "спрашивал про меня."
    },
    {
      "time": 40.05,
      "end": 40.65,
      "text": "А че ты"
    },
    {
      "time": 40.65,
      "end": 42.17,
      "text": "мозги ебешь, братан?"
    },
    {
      "time": 42.29,
      "end": 44.09,
      "text": "Давай встретимся, Трикан,"
    },
    {
      "time": 44.27,
      "end": 45.63,
      "text": "сделаем как раньше."
    },
    {
      "time": 46.35,
      "end": 47.39,
      "text": "Не отдашь мне"
    },
    {
      "time": 47.39,
      "end": 49.17,
      "text": "долг, тебя накажут."
    },
    {
      "time": 49.37,
      "end": 50.43,
      "text": "Я в одежде"
    },
    {
      "time": 50.43,
      "end": 52.41,
      "text": "кожевал, дрочил в"
    },
    {
      "time": 52.41,
      "end": 53.73,
      "text": "детстве на журнал."
    },
    {
      "time": 53.73,
      "end": 55.89,
      "text": "Нахуя женился, если"
    },
    {
      "time": 55.89,
      "end": 57.45,
      "text": "будешь изменять"
    },
    {
      "time": 57.45,
      "end": 58.93,
      "text": "Как же пиздато"
    },
    {
      "time": 58.93,
      "end": 59.63,
      "text": "то, что я"
    },
    {
      "time": 59.63,
      "end": 60.57,
      "text": "не женат и"
    },
    {
      "time": 60.57,
      "end": 61.37,
      "text": "нет детей"
    },
    {
      "time": 61.37,
      "end": 63.41,
      "text": "Я подрочил спермой"
    },
    {
      "time": 63.41,
      "end": 64.33,
      "text": "на бледей"
    },
    {
      "time": 64.33,
      "end": 66.07,
      "text": "Мой друган спросил,"
    },
    {
      "time": 66.19,
      "end": 67.83,
      "text": "как ты справляешься"
    },
    {
      "time": 67.83,
      "end": 69.11,
      "text": "с одиночеством"
    },
    {
      "time": 69.11,
      "end": 70.15,
      "text": "А я говорю,"
    },
    {
      "time": 70.17,
      "end": 71.41,
      "text": "обращаться ко мне"
    },
    {
      "time": 71.41,
      "end": 72.45,
      "text": "надо только по"
    },
    {
      "time": 72.45,
      "end": 73.13,
      "text": "отчеству"
    },
    {
      "time": 73.13,
      "end": 75.09,
      "text": "Извините, мочевой пузырь"
    },
    {
      "time": 75.09,
      "end": 76.41,
      "text": "поднаполнился"
    },
    {
      "time": 76.41,
      "end": 78.43,
      "text": "Я преисполнился в"
    },
    {
      "time": 78.43,
      "end": 79.91,
      "text": "своем сознании"
    },
    {
      "time": 79.91,
      "end": 82.21,
      "text": "Одиноко подрочил хэви"
    },
    {
      "time": 82.21,
      "end": 83.01,
      "text": "-фистинг"
    },
    {
      "time": 83.01,
      "end": 85.37,
      "text": "Резидент пидор, ты"
    },
    {
      "time": 85.37,
      "end": 87.13,
      "text": "помнишь эту репиху?"
    },
    {
      "time": 87.33,
      "end": 89.01,
      "text": "Чай пиздатый сделай"
    },
    {
      "time": 89.01,
      "end": 90.07,
      "text": "с облепихой"
    },
    {
      "time": 90.07,
      "end": 92.59,
      "text": "Обладает пидор, у"
    },
    {
      "time": 92.59,
      "end": 94.03,
      "text": "него статейка на"
    },
    {
      "time": 94.03,
      "end": 95.01,
      "text": "зефлоу"
    },
    {
      "time": 95.01,
      "end": 96.41,
      "text": "Я как раньше"
    },
    {
      "time": 96.41,
      "end": 97.99,
      "text": "дам ему фуфан"
    },
    {
      "time": 97.99,
      "end": 100.11,
      "text": "Буфон на воротах,"
    },
    {
      "time": 100.15,
      "end": 101.55,
      "text": "видел твое фото"
    },
    {
      "time": 101.55,
      "end": 102.77,
      "text": "Ты не любишь"
    },
    {
      "time": 102.77,
      "end": 103.43,
      "text": "травку"
    },
    {
      "time": 103.43,
      "end": 104.93,
      "text": "Братан, ты знаешь,"
    },
    {
      "time": 105.11,
      "end": 106.61,
      "text": "как калмайя трапит?"
    },
    {
      "time": 106.77,
      "end": 108.27,
      "text": "А? Ты не"
    },
    {
      "time": 108.27,
      "end": 108.91,
      "text": "знаешь?"
    },
    {
      "time": 109.63,
      "end": 111.18,
      "text": "Да он зачитает"
    },
    {
      "time": 114.74,
      "end": 116.82,
      "text": "Слышишь, манья не"
    },
    {
      "time": 116.82,
      "end": 117.32,
      "text": "драчу"
    },
    {
      "time": 117.32,
      "end": 118.5,
      "text": "Жарю бит, как"
    },
    {
      "time": 118.5,
      "end": 119.24,
      "text": "Пикачу"
    },
    {
      "time": 119.24,
      "end": 120.48,
      "text": "Я лечу, когда"
    },
    {
      "time": 120.48,
      "end": 121.1,
      "text": "хочу"
    },
    {
      "time": 121.1,
      "end": 122.54,
      "text": "Если чё, сничу,"
    },
    {
      "time": 122.58,
      "end": 123.06,
      "text": "влечу"
    },
    {
      "time": 123.06,
      "end": 124.02,
      "text": "Док, но топ,"
    },
    {
      "time": 124.08,
      "end": 125.02,
      "text": "дай про плечу"
    },
    {
      "time": 125.02,
      "end": 126.2,
      "text": "По собой я"
    },
    {
      "time": 126.2,
      "end": 126.94,
      "text": "не сучу"
    },
    {
      "time": 126.94,
      "end": 128.52,
      "text": "Бигбэй, фэйми, теста"
    },
    {
      "time": 128.52,
      "end": 128.78,
      "text": "чту"
    },
    {
      "time": 128.78,
      "end": 129.96,
      "text": "Рэп, завод, я"
    },
    {
      "time": 129.96,
      "end": 130.7,
      "text": "ЧПУ"
    },
    {
      "time": 130.7,
      "end": 131.5,
      "text": "Свой к вам"
    },
    {
      "time": 131.5,
      "end": 132.42,
      "text": "не читаю"
    },
    {
      "time": 132.42,
      "end": 133.54,
      "text": "Этот бит на"
    },
    {
      "time": 133.54,
