      "text": "ахуе, как калмая"
    },
    {
      "time": 148.36,
      "end": 149.36,
      "text": "фристайли"
    },
    {
      "time": 149.36,
      "end": 151.12,
      "text": "Самый синий лёд,"
    },
    {
      "time": 151.2,
      "end": 151.84,
      "text": "но в руках"
    },
    {
      "time": 151.84,
